{
  "name": "@loopdive/js2",
  "version": "0.66.0",
  "description": "Direct AOT compilation from JavaScript and TypeScript to WebAssembly GC",
  "keywords": [
    "webassembly",
    "wasm",
    "wasm-gc",
    "compiler",
    "typescript",
    "aot",
    "ahead-of-time",
    "javascript"
  ],
  "homepage": "https://js2.loopdive.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopdive/js2.git"
  },
  "bugs": {
    "url": "https://github.com/loopdive/js2/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Thomas Tränkler <git@thomas.traenkler.com>",
  "license": "Apache-2.0 WITH LLVM-exception",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "js2": "./dist/cli.js",
    "js2wasm": "./dist/cli.js",
    "js2-test262": "./dist/test262-fyi-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./optimize": {
      "types": "./dist/optimize.d.ts",
      "import": "./dist/optimize.js"
    },
    "./cli": "./dist/cli.js",
    "./test262-fyi": "./dist/test262-fyi-cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "binaryen": "^125.0.0",
    "bun": ">=1.3.14",
    "deno": ">=2.8.1"
  },
  "peerDependenciesMeta": {
    "binaryen": {
      "optional": true
    },
    "bun": {
      "optional": true
    },
    "deno": {
      "optional": true
    }
  },
  "scripts": {
    "release": "node scripts/release.mjs",
    "new:issue-id": "node scripts/claim-issue.mjs --allocate",
    "preview:issue-id": "node scripts/next-issue-id.mjs",
    "worktree:provision": "bash scripts/provision-worktree-deps.sh",
    "build": "vite build --config vite.config.lib.ts && node scripts/build-test262-cli.mjs",
    "build:test262-cli": "node scripts/build-test262-cli.mjs",
    "build:playground": "vite build --config website/playground/vite.config.ts",
    "dev": "pnpm run build:compiler-bundle && (pnpm run dashboard:watch &) && vite serve --config website/playground/vite.config.ts",
    "test": "node node_modules/vitest/dist/cli.js run",
    "test:guard": "node scripts/run-guard-suite.mjs",
    "test:watch": "node node_modules/vitest/dist/cli.js",
    "test:porffor-direct-ab": "vitest run tests/issue-3482-direct-porffor-js2-ir-ab.test.ts --pool=forks --poolOptions.forks.singleFork=true --no-file-parallelism --reporter=dot",
    "test:landing-four-lane": "vitest run tests/issue-3498-landing-four-lane-backend-benchmark.test.ts --pool=forks --poolOptions.forks.singleFork=true --no-file-parallelism --reporter=dot",
    "test:ir:alloc": "IR_VERIFY_ALLOC=1 node node_modules/vitest/dist/cli.js run tests/ir/alloc-registry.test.ts tests/ir/alloc-provenance.test.ts",
    "test:equivalence:gate": "node scripts/equivalence-gate.mjs",
    "test:262": "bash scripts/run-test262-vitest.sh",
    "test:262:fyi:preflight": "node scripts/test262-fyi-runtime.mjs",
    "test:262:fyi": "pnpm run test:262:fyi:preflight && pnpm run build:compiler-bundle && node scripts/run-test262-fyi.mjs",
    "test:262:fyi:smoke": "pnpm run build:compiler-bundle && node scripts/run-test262-fyi.mjs --non-authoritative-smoke",
    "test:262:validate-baseline": "npx tsx scripts/validate-test262-baseline.ts",
    "baseline:fetch": "node scripts/fetch-baseline-jsonl.mjs",
    "detect:vacuity": "npx tsx scripts/detect-vacuity.ts",
    "check:test-vacuity-shapes": "npx tsx scripts/check-test-vacuity-shapes.ts",
    "check:ir-fallbacks": "npx tsx scripts/check-ir-fallbacks.ts",
    "check:ir-only": "npx tsx scripts/check-ir-only.ts",
    "check:ir-optimization-retirement": "node scripts/check-ir-optimization-retirement.mjs",
    "check:linear-ir": "npx tsx scripts/check-linear-ir.ts",
    "check:oracle-ratchet": "node scripts/check-oracle-ratchet.mjs",
    "check:pushraw": "node scripts/check-pushraw.mjs",
    "check:loc-budget": "node scripts/check-loc-budget.mjs",
    "check:func-budget": "node scripts/check-func-budget.mjs",
    "check:harness-compile-budget": "npx tsx scripts/check-harness-compile-budget.ts",
    "inventory:test262-linked-harness": "npx tsx scripts/test262-linked-harness-inventory.ts",
    "check:dead-exports": "node scripts/audit-legacy-reachability.mjs --check",
    "check:godfiles": "node scripts/profile-godfiles.mjs --check",
    "profile:godfiles": "node scripts/profile-godfiles.mjs",
    "gen:ir-adoption": "node scripts/gen-ir-adoption.mjs",
    "check:ir-adoption": "node scripts/gen-ir-adoption.mjs --check",
    "check:stack-balance": "npx tsx scripts/check-stack-balance.ts",
    "census:async": "node scripts/async-call-census.mjs",
    "check:codegen-fallbacks": "npx tsx scripts/check-codegen-fallbacks.ts",
    "check:any-box-sites": "node scripts/check-any-box-sites.mjs",
    "check:speculative-rollback": "node scripts/check-speculative-rollback-sites.mjs",
    "check:coercion-sites": "node scripts/check-coercion-sites.mjs",
    "check:test262-hard-errors": "node scripts/check-test262-hard-errors.mjs",
    "check:issue-spec-coverage": "node scripts/check-issue-spec-coverage.mjs",
    "check:done-status-integrity": "node scripts/check-done-status-integrity.mjs",
    "check:verdict-oracle": "node scripts/check-verdict-oracle-bump.mjs",
    "check:issues": "node scripts/update-issues.mjs --check && node scripts/check-ir-optimization-retirement.mjs",
    "test:diff": "npx tsx scripts/diff-test.ts",
    "test:diff:triage": "npx tsx scripts/diff-triage.ts",
    "test:diff:gate": "npx tsx scripts/diff-test-gate.ts",
    "dogfood:acorn": "npx tsx tests/dogfood/acorn-harness.mjs",
    "dogfood:acorn-corpus": "npx tsx tests/dogfood/acorn-corpus.mjs",
    "dogfood:acorn-probe": "npx tsx tests/dogfood/acorn-probe.mjs",
    "dogfood:acorn-test262": "node --max-old-space-size=4096 --import tsx tests/dogfood/acorn-test262.mjs",
    "dogfood:acorn-official-suite": "npx tsx tests/dogfood/acorn-official-suite.mjs",
    "dogfood:marked": "npx tsx tests/dogfood/marked-harness.mjs",
    "dogfood:clsx": "npx tsx tests/dogfood/clsx-harness.mjs",
    "dogfood:cookie": "npx tsx tests/dogfood/cookie-harness.mjs",
    "dogfood:eslint": "npx tsx tests/dogfood/eslint-harness.mjs",
    "dogfood:prettier": "npx tsx tests/dogfood/prettier-harness.mjs",
    "dogfood:react": "npx tsx tests/dogfood/react-harness.mjs",
    "generate:npm-compat": "npx tsx scripts/generate-npm-compat-report.mjs",
    "benchmark:acorn": "npx tsx scripts/generate-npm-compat-report.mjs --only acorn --no-write",
    "benchmark:acorn:perf": "npx tsx scripts/generate-npm-compat-report.mjs --only acorn --no-write --perf-only",
    "benchmark:acorn:js-host": "npx tsx scripts/generate-npm-compat-report.mjs --only acorn --no-write --perf-only --lane js-host",
    "benchmark:acorn:standalone": "npx tsx scripts/generate-npm-compat-report.mjs --only acorn --no-write --perf-only --lane standalone",
    "benchmark:acorn:standalone-dynamic": "npx tsx scripts/generate-npm-compat-report.mjs --only acorn --no-write --perf-only --lane standalone-dynamic",
    "benchmark:acorn:ir": "JS2WASM_IR_SHAPE_DIAG=1 npx tsx scripts/generate-npm-compat-report.mjs --only acorn --no-write --perf-only --lane standalone --inspect-ir",
    "benchmark:clsx": "npx tsx scripts/generate-npm-compat-report.mjs --only clsx --no-write",
    "benchmark:clsx:js-host": "npx tsx scripts/generate-npm-compat-report.mjs --only clsx --no-write --lane js-host",
    "benchmark:clsx:standalone": "npx tsx scripts/generate-npm-compat-report.mjs --only clsx --no-write --lane standalone",
    "benchmark:clsx:standalone-dynamic": "npx tsx scripts/generate-npm-compat-report.mjs --only clsx --no-write --perf-only --lane standalone-dynamic",
    "benchmark:cookie": "npx tsx scripts/generate-npm-compat-report.mjs --only cookie --no-write",
    "benchmark:cookie:js-host": "npx tsx scripts/generate-npm-compat-report.mjs --only cookie --no-write --lane js-host",
    "benchmark:cookie:standalone": "npx tsx scripts/generate-npm-compat-report.mjs --only cookie --no-write --lane standalone",
    "benchmark:cookie:standalone-dynamic": "npx tsx scripts/generate-npm-compat-report.mjs --only cookie --no-write --perf-only --lane standalone-dynamic",
    "benchmark:eslint": "npx tsx scripts/generate-npm-compat-report.mjs --only eslint --no-write",
    "benchmark:prettier": "npx tsx scripts/generate-npm-compat-report.mjs --only prettier --no-write",
    "benchmark:react": "npx tsx scripts/generate-npm-compat-report.mjs --only react --no-write",
    "prepublishOnly": "pnpm run build",
    "refresh:benchmarks": "npx tsx --experimental-wasm-stringref --experimental-wasm-custom-descriptors benchmarks/run.ts && pnpm run build:compiler-bundle && node --experimental-wasm-stringref --experimental-wasm-custom-descriptors scripts/generate-playground-benchmark-sidebar.mjs && node --experimental-wasm-stringref --experimental-wasm-custom-descriptors scripts/generate-playground-benchmark-sidebar-no-jit.mjs && pnpm run generate:size-benchmarks && node scripts/generate-browser-runtime-benchmarks.mjs",
    "refresh:benchmarks:no-jit": "pnpm run build:compiler-bundle && node --experimental-wasm-stringref --experimental-wasm-custom-descriptors scripts/generate-playground-benchmark-sidebar-no-jit.mjs",
    "refresh:benchmarks:wasmtime": "pnpm run build:compiler-bundle && node --experimental-wasm-stringref --experimental-wasm-custom-descriptors scripts/generate-wasmtime-hot-runtime.mjs",
    "benchmark:lifecycle": "node scripts/benchmark-lifecycle.mjs",
    "benchmark:package": "node scripts/benchmark-lifecycle.mjs package",
    "benchmark:validate": "node scripts/benchmark-lifecycle.mjs validate",
    "benchmark:compare": "node scripts/benchmark-lifecycle.mjs compare",
    "benchmark:porffor-direct-ab": "tsx scripts/benchmark-porffor-direct-ab.mts",
    "benchmark:landing-four-lane": "tsx scripts/benchmark-landing-four-lane.mts",
    "build:compiler-bundle": "esbuild scripts/compiler-bundle-entry.ts --bundle --platform=node --format=esm --outfile=scripts/compiler-bundle.mjs --external:typescript --external:binaryen --external:@typescript/native-preview --external:@typescript/native-preview/*",
    "build:standalone-cli": "node scripts/build-standalone-cli.mjs",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.ts'",
    "lint": "biome lint src tests scripts --diagnostic-level=error",
    "typecheck": "tsc --noEmit",
    "generate:editions": "npx tsx scripts/generate-editions.ts",
    "generate:feature-badges": "node scripts/derive-feature-badges.mjs",
    "generate:feature-badges:check": "node scripts/derive-feature-badges.mjs --check",
    "generate:feature-examples": "npx tsx scripts/generate-feature-examples.ts",
    "generate:size-benchmarks": "npx tsx --experimental-wasm-stringref --experimental-wasm-custom-descriptors scripts/generate-size-benchmarks.ts",
    "generate:browser-runtime-benchmarks": "node scripts/generate-browser-runtime-benchmarks.mjs",
    "build:planning-artifacts": "node scripts/build-planning-artifacts.mjs",
    "dashboard": "node website/dashboard/build-data.js",
    "dashboard:watch": "node --watch --watch-path plan/issues --watch-path plan/issues/sprints --watch-path plan/issues/done --watch-path plan/issues/ready --watch-path plan/issues/blocked website/dashboard/build-data.js",
    "report": "npx tsx scripts/serve-report.ts",
    "sync:conformance": "node scripts/sync-conformance-numbers.mjs",
    "sync:conformance:check": "node scripts/sync-conformance-numbers.mjs --check",
    "build:pages": "node scripts/run-pages-build.mjs",
    "deploy:registry-home": "mkdir -p .registry-home && cp website/index.html .registry-home/index.html && node ../file-registry-cli/dist/bin/main.js commit .registry-home -r users/tt/projects/ts2wasm && node ../file-registry-cli/dist/bin/main.js push .registry-home -r users/tt/projects/ts2wasm --public",
    "upload": "pnpm run build:playground && node ../file-registry-cli/dist/bin/main.js commit && node ../file-registry-cli/dist/bin/main.js push",
    "prepare": "sh scripts/configure-git-hooks.sh || true",
    "reconcile:tasks": "node scripts/reconcile-tasklist.mjs",
    "issues:pr-status": "node scripts/poll-merged-pr-issues.mjs --once --sync-artifacts",
    "issues:pr-status:watch": "node scripts/poll-merged-pr-issues.mjs --sync-artifacts",
    "symphony": "node scripts/symphony.mjs",
    "symphony:once": "node scripts/symphony.mjs --once",
    "symphony:dry-run": "node scripts/symphony.mjs --once --dry-run",
    "symphony:status": "node scripts/symphony.mjs --status",
    "symphony:control": "node scripts/symphony.mjs --control",
    "dispatch:queue": "node scripts/dispatch-channel.mjs queue",
    "dispatch:request-claude": "node scripts/dispatch-channel.mjs request-claude",
    "dispatch:inbox": "node scripts/dispatch-channel.mjs inbox",
    "claude:symphony-channel": "node scripts/claude-symphony-channel.mjs",
    "check:issue-ids": "node scripts/check-issue-ids.mjs",
    "check:issue-ids:staged": "node scripts/check-issue-ids.mjs --staged",
    "check:issue-ids:against-main": "node scripts/check-issue-ids.mjs --against-main",
    "check:issue-ids:against-open-prs": "node scripts/check-issue-ids.mjs --against-open-prs",
    "new:issue-id:allocate": "node scripts/claim-issue.mjs --allocate"
  },
  "dependencies": {
    "typescript": "^5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1",
    "@bytecodealliance/componentize-js": "^0.20.0",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22",
    "@typescript/native-preview": "^7.0.0-dev.20260502.1",
    "axios": "^1.16.1",
    "binaryen": "^125.0.0",
    "bun": "1.3.14",
    "deno": "2.8.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.0.3",
    "hono": "^4.12.16",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.2",
    "monaco-editor": "^0.55.1",
    "prettier": "^3.8.1",
    "react": "^19.2.6",
    "shiki": "^4.0.2",
    "ts-morph": "^27.0.2",
    "tsx": "4.23.1",
    "vite": "^6",
    "vite-plugin-dts": "^4",
    "vitest": "^3",
    "wabt": "^1.0.39"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write",
      "biome lint --diagnostic-level=error --no-errors-on-unmatched"
    ],
    "*.json": "prettier --write"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
