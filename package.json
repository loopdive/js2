    "type": "git",
    "url": "git+https://github.com/loopdive/js2.git"
  },
  "bugs": {
    "url": "https://github.com/loopdive/js2wasm/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
