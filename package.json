{
  "name": "@loopdive/js2",
  "version": "0.70.0",
  "description": "Direct AOT compilation from JavaScript and TypeScript to WebAssembly GC",
  "keywords": [
    "webassembly",
    "wasm",
    "wasm-gc",
    "compiler",
    "typescript",
    "aot",
    "ahead-of-time",
    "javascript"
  ],
