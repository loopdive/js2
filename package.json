  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "js2": "./dist/cli.js",
    "js2wasm": "./dist/cli.js",
    "js2-test262": "./dist/test262-fyi-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./runtime/evaluator": {
      "types": "./dist/runtime-isolated-evaluator.d.ts",
      "import": "./dist/runtime-isolated-evaluator.js"
    },
    "./runtime/node-eval-worker": {
      "types": "./dist/runtime-node-eval-worker.d.ts",
      "import": "./dist/runtime-node-eval-worker.js"
    },
    "./optimize": {
      "types": "./dist/optimize.d.ts",
      "import": "./dist/optimize.js"
    },
    "./cli": "./dist/cli.js",
    "./test262-fyi": "./dist/test262-fyi-cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
