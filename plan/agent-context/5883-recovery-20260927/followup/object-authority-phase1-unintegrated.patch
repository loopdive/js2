diff --git a/src/codegen/object-prototype-slot.ts b/src/codegen/object-prototype-slot.ts
new file mode 100644
index 0000000000..530d84fc76
--- /dev/null
+++ b/src/codegen/object-prototype-slot.ts
@@ -0,0 +1,51 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+/**
+ * Trusted physical $Object prototype-slot emitters (encapsulation phase only).
+ *
+ * These factories emit the EXISTING typed representation, not an actual-JS-
+ * prototype decoder. Callers must already have an Object owner and, for stores,
+ * a validated/encoded `(ref null $Object)` payload on the operand stack.
+ * Neither owner selection nor proposal canonicalization belongs here.
+ *
+ * Null alone does not distinguish the implicit default from explicit null:
+ * callers retain the existing NULL_PROTO flag operations and their order.
+ * The typed store below deliberately does NOT update flags. It is not the
+ * future atomic `__object_proto_store_raw(owner, externref)` commit API.
+ *
+ * No runtime helper reservation, imports, globals, defaults or second storage.
+ * Each call returns a fresh instruction/type object for in-place IR remappers.
+ * Widening this slot requires the separate atomic reader/writer/allocator and
+ * mixed-carrier migration; changing these factories alone is NOT a cutover.
+ */
+import type { FieldDef, Instr, ValType } from "../ir/types.js";
+
+export const OBJECT_PROTOTYPE_SLOT_FIELD = 0;
+export const OBJECT_PROTOTYPE_NULL_FLAG = 0x80;
+
+/** Physical payload type, NOT the type of an arbitrary JavaScript prototype. */
+export function objectPrototypeSlotType(objectTypeIdx: number): ValType {
+  return { kind: "ref_null", typeIdx: objectTypeIdx };
+}
+
+/** Field zero of the existing final, six-field $Object layout. */
+export function objectPrototypeSlotField(objectTypeIdx: number): FieldDef {
+  return { name: "proto", type: objectPrototypeSlotType(objectTypeIdx), mutable: true };
+}
+
+/** Stack: trusted Object owner -> encoded nullable Object prototype. */
+export function objectPrototypeSlotGet(objectTypeIdx: number): Instr {
+  return { op: "struct.get", typeIdx: objectTypeIdx, fieldIdx: OBJECT_PROTOTYPE_SLOT_FIELD };
+}
+
+/** Stack: trusted Object owner, encoded nullable Object prototype -> empty. */
+export function objectPrototypeSlotSet(objectTypeIdx: number): Instr {
+  return { op: "struct.set", typeIdx: objectTypeIdx, fieldIdx: OBJECT_PROTOTYPE_SLOT_FIELD };
+}
+
+/**
+ * Stack: empty -> typed null payload, for allocation or legacy cast-or-null.
+ * Does not select a default or mark explicit null; the owner's flags do that.
+ */
+export function objectPrototypeSlotNull(objectTypeIdx: number): Instr {
+  return { op: "ref.null", typeIdx: objectTypeIdx };
+}

