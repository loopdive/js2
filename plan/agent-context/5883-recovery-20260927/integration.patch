+      `,
+          method,
+        ),
+      ).toBe(1);
+    });
+
+    it("keeps iterating after synchronous fulfillment", async () => {
+      expect(
+        await run(
+          `
+        const a:any[]=[1,2,3];let polls=0;let resolves=0;let closes=0;let answer=0;
+        const iterator:any={next:function():any {polls++;return {done:polls>3,value:polls};},return:function():any {closes++;return {};}};
+        (a as any)[Symbol.iterator]=function():any {return iterator;};
