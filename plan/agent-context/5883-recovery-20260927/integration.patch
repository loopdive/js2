+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { describe, expect, it } from "vitest";
+import { compile } from "../src/index.js";
+
+// Real production callers only. Execute serially after B/C integration and a
+// parent test-slot grant; these sources are additional P/C/S controls, not
+// substitutes for the immutable original-vector acceptance fixtures.
+async function run(body: string, method: "all" | "race", captured = true): Promise<number> {
+  const result = await compile(
+    `declare function __drain_microtasks(): void;
+export function test(): number {
+${body.replaceAll("COMBINE", `Promise.${method}`)}
+}`,
+    {
+      fileName: `5883-acquisition-${method}.ts`,
+      target: "standalone",
+      nativeStrings: true,
+      optimize: 0,
+      emitWat: true,
+    },
+  );
+  expect(result.success, JSON.stringify(result.errors)).toBe(true);
+  if (!result.success) throw new Error("production acquisition source failed compilation");
+  if (captured) {
+    expect(result.wat).toContain("__promise_vector_iterator_acquire");
+    expect(result.wat).toContain("__promise_vector_iterator_step");
+    expect(result.wat).toContain("__promise_vector_iterator_close_throw");
+  } else {
+    expect(result.wat).not.toContain("__promise_vector_iterator_acquire");
+  }
+  const module = await WebAssembly.compile(result.binary);
+  expect(WebAssembly.Module.imports(module)).toEqual([]);
+  expect(WebAssembly.Module.exports(module).some((entry) => entry.name.startsWith("__promise_vector_iterator_"))).toBe(
+    false,
+  );
+  const instance = await WebAssembly.instantiate(module, {});
+  return (instance.exports.test as () => number)();
+}
+
+for (const method of ["all", "race"] as const) {
+  describe(`captured vector drive ${method}`, () => {
+    it("evaluates the original argument once and interleaves the protocol in order", async () => {
+      expect(
+        await run(
+          `
+        let trace=""; let evaluations=0; let polls=0; let reads=0; let bad=0; let answer=0;
+        const a:any[]=[1,2];
+        const iterator:any={};
+        Object.defineProperty(iterator,"next",{get:function():any {
+          trace+="N";reads++;
+          return function():any {
+            trace+="n";polls++;if(this!==iterator || arguments.length!==0)bad++;
+            const result:any={};
+            Object.defineProperty(result,"done",{get:function():any {trace+="d";return polls>1;}});
+            Object.defineProperty(result,"value",{get:function():any {trace+="v";return 9;}});
+            return result;
+          };
+        }});
+        Object.defineProperty(a,Symbol.iterator,{get:function():any {
+          trace+="I";if(this!==a)bad++;
+          return function():any {trace+="i";if(this!==a || arguments.length!==0)bad++;return iterator;};
+        }});
+        Object.defineProperty(Promise,"resolve",{configurable:true,get:function():any {
+          trace+="R";
+          return function(v:any):any {
+            trace+="r";if(this!==Promise || arguments.length!==1)bad++;
+            const next:any={};
+            Object.defineProperty(next,"then",{get:function():any {
+              trace+="T";return function(ok:any):void {trace+="t";if(this!==next)bad++;ok(v);};
+            }});return next;
+          };
+        }});
+        function source():any[] {trace+="A";evaluations++;return a;}
+        COMBINE(source()).then(function(v:any):void {answer=${method === "all" ? "v[0]" : "v"};});
+        __drain_microtasks();
+        return trace==="ARIiNndvrTtnd" && evaluations===1 && reads===1 && polls===2 && bad===0 && answer===9 ? 1 : 0;
+      `,
+          method,
+        ),
+      ).toBe(1);
+    });
+
+    it("rejects a throwing resolve getter before iterator acquisition", async () => {
+      expect(
+        await run(
+          `
+        const a:any[]=[1]; const original:any={error:1}; let iteratorGets=0;let reason:any=null;
+        Object.defineProperty(a,Symbol.iterator,{get:function():any {iteratorGets++;throw 99;}});
+        Object.defineProperty(Promise,"resolve",{configurable:true,get:function():any {throw original;}});
+        COMBINE(a).then(function():void {},function(e:any):void {reason=e;});
+        __drain_microtasks();return iteratorGets===0 && reason===original ? 1 : 0;
+      `,
+          method,
+        ),
+      ).toBe(1);
+    });
+
+    for (const failure of ["resolve", "then-get", "then-noncallable", "then-call"]) {
