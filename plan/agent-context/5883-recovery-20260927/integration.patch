+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { describe, expect, it } from "vitest";
+// Initialize the existing compiler graph before importing its public wrappers.
+import "../src/index.js";
+import { ts, forEachChild } from "../src/ts-api.js";
+import type { CodegenContext } from "../src/codegen/context/types.js";
+import { sourceHasMethodReassignment } from "../src/codegen/expressions/calls.js";
+import { sourceHasMethodOverride } from "../src/codegen/expressions/member-override-scan.js";
+import {
+  sourceMethodReassignmentFact,
+  sourceMethodDefinitionFact,
+  sourceMethodOverrideFacts,
+} from "../src/codegen/expressions/member-override-facts.js";
+
+// Verbatim pre-extraction walkers from base 608be80f6, apart from function
+// names. Independent historical caches make this an old/new comparison,
+// rather than expectations generated by the new implementation.
+const _reassignmentCache = new WeakMap<ts.SourceFile, Map<string, boolean>>();
+function oldReassignment(ctx: CodegenContext, anchor: ts.Node, methodName: string): boolean {
+  const sf = anchor.getSourceFile();
+  if (!sf) return false;
+  let perFile = _reassignmentCache.get(sf);
+  if (perFile === undefined) {
+    perFile = new Map<string, boolean>();
+    _reassignmentCache.set(sf, perFile);
+  }
+  const cached = perFile.get(methodName);
+  if (cached !== undefined) return cached;
+
+  let found = false;
+  function visit(node: ts.Node): void {
+    if (found) return;
+    if (
+      ts.isBinaryExpression(node) &&
+      node.operatorToken.kind === ts.SyntaxKind.EqualsToken &&
+      ts.isPropertyAccessExpression(node.left) &&
+      ts.isIdentifier(node.left.name) &&
+      node.left.name.text === methodName
+    ) {
+      found = true;
+      return;
+    }
+    forEachChild(node, visit);
+  }
+  visit(sf);
+  perFile.set(methodName, found);
+  // Reference ctx so the parameter isn't unused — the cache is keyed on the
+  // SourceFile (not ctx) but we keep ctx in the signature for future
+  // refinements that need scope-narrowing or per-symbol resolution.
+  void ctx;
+  return found;
+}
+
+const _definePropertyCache = new WeakMap<ts.SourceFile, Map<string, boolean>>();
+function oldDefinition(anchor: ts.Node, methodName: string): boolean {
+  const sf = anchor.getSourceFile();
+  if (!sf) return false;
+  let perFile = _definePropertyCache.get(sf);
+  if (perFile === undefined) {
+    perFile = new Map<string, boolean>();
+    _definePropertyCache.set(sf, perFile);
+  }
+  const cached = perFile.get(methodName);
+  if (cached !== undefined) return cached;
+
+  let found = false;
+  function visit(node: ts.Node): void {
+    if (found) return;
+    if (ts.isCallExpression(node) && ts.isPropertyAccessExpression(node.expression)) {
+      const callee = node.expression.name.text;
+      if (callee === "defineProperty" && node.arguments.length >= 2) {
+        const key = node.arguments[1];
+        if (key !== undefined && ts.isStringLiteralLike(key) && key.text === methodName) {
+          found = true;
+          return;
+        }
+      }
+      if (callee === "defineProperties" && node.arguments.length >= 2) {
+        const descs = node.arguments[1];
+        if (descs !== undefined && ts.isObjectLiteralExpression(descs)) {
+          for (const p of descs.properties) {
+            const n = p.name;
+            if (n === undefined) continue;
+            if ((ts.isIdentifier(n) || ts.isStringLiteralLike(n)) && n.text === methodName) {
+              found = true;
+              return;
+            }
+          }
+        }
+      }
+    }
+    forEachChild(node, visit);
+  }
+  visit(sf);
+  perFile.set(methodName, found);
+  return found;
+}
+
+function oldOverride(ctx: CodegenContext, anchor: ts.Node, name: string): boolean {
+  return oldReassignment(ctx, anchor, name) || oldDefinition(anchor, name);
+}
+const ctx = new Proxy({} as CodegenContext, {
+  get() {
+    throw new Error("syntactic facts must not observe ctx");
+  },
+  set() {
+    throw new Error("syntactic facts must not mutate ctx");
+  },
+});
+function parse(text: string, fileName = "same-name.ts"): ts.SourceFile {
+  return ts.createSourceFile(fileName, text, ts.ScriptTarget.Latest, true, ts.ScriptKind.TS);
+}
+
+// [description, source, assignment fact, definition fact] for "resolve".
+const fixtures: [string, string, boolean, boolean][] = [
+  ["empty", "", false, false],
+  ["assignment before call", "x.resolve=f; Promise.all(a);", true, false],
+  ["assignment after call", "Promise.all(a); x.resolve=f;", true, false],
+  ["nested dead assignment", "function dead(){ if(false) unrelated.resolve=f; }", true, false],
+  ["arbitrary receiver", "make().resolve=f;", true, false],
+  ["bracket string assignment", "x['resolve']=f;", false, false],
+  ["bracket variable assignment", "x[key]=f;", false, false],
+  ["compound assignment", "x.resolve+=f;", false, false],
+  ["logical assignment", "x.resolve ||= f;", false, false],
+  ["increment", "x.resolve++;", false, false],
+  ["read only", "x.resolve;", false, false],
+  ["private identifier", "class C { #resolve; f(){this.#resolve=1;} }", false, false],
+  ["defineProperty", "Object.defineProperty(x,'resolve',{});", false, true],
+  ["broad callee", "unrelated.defineProperty(x,'resolve',{});", false, true],
+  ["shadowed Object", "function f(Object){Object.defineProperty(x,'resolve',{});}", false, true],
+  ["missing descriptor", "x.defineProperty(y,'resolve');", false, true],
+  ["too few arguments", "x.defineProperty('resolve');", false, false],
+  ["variable descriptor key", "x.defineProperty(y,key,{});", false, false],
+  ["template literal key", "x.defineProperty(y,`resolve`,{});", false, true],
+  ["computed callee", "x['defineProperty'](y,'resolve',{});", false, false],
+  ["bare callee", "defineProperty(y,'resolve',{});", false, false],
+  ["defineProperties identifier", "x.defineProperties(y,{resolve:{}});", false, true],
+  ["defineProperties string", "x.defineProperties(y,{'resolve':{}});", false, true],
+  ["defineProperties shorthand", "x.defineProperties(y,{resolve});", false, true],
+  ["defineProperties method", "x.defineProperties(y,{resolve(){}});", false, true],
+  ["defineProperties accessor", "x.defineProperties(y,{get resolve(){return {};}});", false, true],
+  ["defineProperties computed", "x.defineProperties(y,{['resolve']:{}});", false, false],
+  ["defineProperties spread", "x.defineProperties(y,{...resolve});", false, false],
+  ["defineProperties nonliteral", "x.defineProperties(y,descriptors);", false, false],
+  ["defineProperties parenthesized", "x.defineProperties(y,({resolve:{}}));", false, false],
+  ["both facts", "x.resolve=f; q.defineProperty(y,'resolve',{});", true, true],
+  ["other name", "x.then=f; q.defineProperty(y,'then',{});", false, false],
+];
+
+describe("exact historical member override facts", () => {
+  it.each(fixtures)("%s", (_name, text, assignment, definition) => {
+    const sf = parse(text);
+    const anchor = sf.statements[0] ?? sf;
+    expect(oldReassignment(ctx, anchor, "resolve")).toBe(assignment);
+    expect(oldDefinition(anchor, "resolve")).toBe(definition);
+    for (const name of ["resolve", "then", "other"]) {
+      // Repeat to cover both cold and cached paths, including cached false.
+      for (let repeat = 0; repeat < 2; repeat++) {
+        expect(sourceMethodReassignmentFact(sf, name)).toBe(oldReassignment(ctx, anchor, name));
+        expect(sourceMethodDefinitionFact(sf, name)).toBe(oldDefinition(anchor, name));
+        expect(sourceMethodOverrideFacts(sf, name)).toBe(oldOverride(ctx, anchor, name));
+        expect(sourceHasMethodReassignment(ctx, anchor, name)).toBe(oldReassignment(ctx, anchor, name));
+        expect(sourceHasMethodOverride(ctx, anchor, name)).toBe(oldOverride(ctx, anchor, name));
+      }
+    }
+  });
+
+  it("returns false without a SourceFile and never observes ctx", () => {
+    const orphan = { getSourceFile: () => undefined } as unknown as ts.Node;
+    expect(sourceMethodReassignmentFact(undefined, "resolve")).toBe(false);
+    expect(sourceMethodDefinitionFact(undefined, "resolve")).toBe(false);
+    expect(sourceMethodOverrideFacts(undefined, "resolve")).toBe(false);
+    expect(sourceHasMethodReassignment(ctx, orphan, "resolve")).toBe(oldReassignment(ctx, orphan, "resolve"));
+    expect(sourceHasMethodOverride(ctx, orphan, "resolve")).toBe(oldOverride(ctx, orphan, "resolve"));
+  });
+
+  it("keys caches on file identity and method, never filename or graph order", () => {
+    const a = parse("x.resolve=f;");
+    const b = parse("Promise.all(a);");
+    const c = parse("x.then=f;");
+    for (const files of [
+      [a, b, c],
+      [c, b, a],
+    ]) {
+      expect(files.map((sf) => sourceMethodOverrideFacts(sf, "resolve"))).toEqual(
+        files.map((sf) => oldOverride(ctx, sf, "resolve")),
+      );
+      expect(sourceMethodOverrideFacts(b, "resolve")).toBe(false);
+      expect(sourceMethodOverrideFacts(a, "then")).toBe(false);
+      expect(sourceMethodOverrideFacts(c, "then")).toBe(true);
+    }
+  });
+
+  it("retains separate cached facts for immutable source identities", () => {
+    // Deliberately mutate a test AST after caching: historical caches do not
+    // invalidate. This pins extraction equivalence, not a supported AST API.
+    const sf = parse("");
+    expect(sourceMethodReassignmentFact(sf, "resolve")).toBe(oldReassignment(ctx, sf, "resolve"));
+    expect(sourceMethodDefinitionFact(sf, "resolve")).toBe(oldDefinition(sf, "resolve"));
+    Object.assign(sf, { statements: parse("x.resolve=f; x.defineProperty(y,'resolve',{}); x.then=f;").statements });
+    expect(sourceMethodOverrideFacts(sf, "resolve")).toBe(oldOverride(ctx, sf, "resolve"));
+    expect(sourceMethodOverrideFacts(sf, "resolve")).toBe(false);
+    expect(sourceMethodOverrideFacts(sf, "then")).toBe(oldOverride(ctx, sf, "then"));
+    expect(sourceMethodOverrideFacts(sf, "then")).toBe(true);
+  });
+
+  it("preserves wrapper lookup order and assignment short circuit", () => {
+    const assigned = parse("x.resolve=f;");
+    const defined = parse("x.defineProperty(y,'resolve',{});");
+    const blank = parse("");
+    for (const pair of [
+      [assigned, blank],
+      [blank, defined],
+    ]) {
+      function observe(scan: typeof sourceHasMethodOverride): [boolean, number] {
+        let reads = 0;
+        const anchor = { getSourceFile: () => pair[Math.min(reads++, 1)] } as unknown as ts.Node;
+        return [scan(ctx, anchor, "resolve"), reads];
+      }
+      expect(observe(sourceHasMethodOverride)).toEqual(observe(oldOverride));
+      expect(observe(sourceHasMethodOverride)).toEqual([true, pair[0] === assigned ? 1 : 2]);
+    }
+  });
+});
