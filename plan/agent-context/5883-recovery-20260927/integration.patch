index 0000000000..e3014dabc6
--- /dev/null
+++ b/tests/issue-5197-observable-vector-original-review.test.ts
@@ -0,0 +1,81 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { runInNewContext } from "node:vm";
+import { expect, it } from "vitest";
+import { compile } from "../src/index.js";
+import { ts } from "../src/ts-api.js";
+
+// Original September 15 sources and expectations are immutable. Historical
+// compiler answers are evidence only, never the expected result of this test.
+const bytes = readFileSync(
+  new URL("../plan/agent-context/5883-observable-vector-review-20260915.jsonl", import.meta.url),
+);
+if (
+  createHash("sha256").update(bytes).digest("hex") !==
+  "d9d792883c09853383845195ca9868ed97e506c6526b2434384c49a7f2d5f806"
+) {
+  throw new Error("Original observable-vector review receipt changed");
+}
+interface ReviewCase {
+  method: "all" | "race";
+  variant: string;
+  source: string;
+  reference: number | { calls: number; length: number; trace: string };
+}
+const cases: ReviewCase[] = bytes
+  .toString("utf8")
+  .trim()
+  .split("\n")
+  .map((line) => JSON.parse(line));
+if (cases.length !== 12 || new Set(cases.map((row) => `${row.method}/${row.variant}`)).size !== 12) {
+  throw new Error("Expected all twelve unique original review cases");
+}
+
+for (const row of cases) {
+  it(`original review: Promise.${row.method} ${row.variant}`, async () => {
+    const expected =
+      typeof row.reference === "number"
+        ? row.reference
+        : row.reference.calls * 1_000_000 + Number(row.reference.trace) * 10 + row.reference.length;
+    // A fresh realm prevents the fixture's Promise.resolve replacement from
+    // modifying Vitest or another case. Only types/module syntax are removed.
+    const nativeSource = ts.transpileModule(row.source, {
+      compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS },
+    }).outputText;
+    const native = runInNewContext(
+      `${nativeSource}\nexports.test();`,
+      { exports: {} },
+      {
+        timeout: 5000,
+        microtaskMode: "afterEvaluate",
+      },
+    );
+    expect(native).toBe(expected);
+    const result = await compile(row.source, {
+      fileName: `5197-original-${row.method}-${row.variant}.ts`,
+      target: "standalone",
+      nativeStrings: true,
+      emitWat: true,
+    });
+    expect(result.success, JSON.stringify(result.errors)).toBe(true);
+    const module = new WebAssembly.Module(result.binary);
+    const imports = WebAssembly.Module.imports(module);
+    expect(imports).toEqual([]);
+    const instance = new WebAssembly.Instance(module, {});
+    const actual = (instance.exports.test as () => number)();
+    console.log(
+      JSON.stringify({
+        method: row.method,
+        variant: row.variant,
+        sourceSha256: createHash("sha256").update(row.source).digest("hex"),
+        native,
+        expected,
+        actual,
+        imports,
+        observableBody: result.wat?.includes("__comb_observable_") ?? false,
+      }),
+    );
+    expect(actual).toBe(expected);
+  });
+}
diff --git a/tests/issue-5883-live-array-substrate.test.ts b/tests/issue-5883-live-array-substrate.test.ts
new file mode 100644
index 0000000000..f3bb1b70df
--- /dev/null
+++ b/tests/issue-5883-live-array-substrate.test.ts
@@ -0,0 +1,364 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { compile } from "../src/index.js";
+import type { CodegenContext } from "../src/codegen/context/types.js";
+import { definedFuncAt, mintDefinedFunc, pushDefinedFunc } from "../src/codegen/func-space.js";
+import { addFuncType } from "../src/codegen/registry/types.js";
+import * as iterator from "../src/codegen/iterator-native.js";
+import { ensureNativeLiveArrayValues } from "../src/codegen/iterator-live-array.js";
+
+afterEach(() => vi.restoreAllMocks());
+
+/**
+ * Test-only registration seam, not a source-lowering replacement. Exercise the
+ * real opt-in producer and central consumers on native sources. All helper
+ * exports are explicit harness entrypoints; production has no test exports.
+ */
+async function harness(source: string, strict = true) {
+  const installed = new Set<CodegenContext>();
+  const original = iterator.ensureNativeIteratorRuntime;
+  vi.spyOn(iterator, "ensureNativeIteratorRuntime").mockImplementation((ctx) => {
+    original(ctx);
+    if (installed.has(ctx)) return;
+    installed.add(ctx);
+    ensureNativeLiveArrayValues(ctx);
+    // Test-only seek avoids billions of next calls while exercising the real
+    // f64 cursor around both signed-i32 and unsigned-array-length boundaries.
+    const seekType = addFuncType(ctx, [{ kind: "externref" }, { kind: "f64" }], []);
+    const seekIdx = mintDefinedFunc(ctx);
+    const recType = ctx.structMap.get("__IterRec")!;
+    const payloadType = ctx.structMap.get("__LiveArrayIterator")!;
+    // Assert the real ABI rather than deleting the externref conversion to
+    // accommodate a post-codegen repair's invalid extra cast.
+    expect(ctx.mod.types[recType]).toMatchObject({
+      kind: "struct",
+      fields: [
+        { type: { kind: "i32" } },
+        { type: { kind: "ref_null" } },
+        { type: { kind: "i32" } },
+        { type: { kind: "externref" } },
+        { type: { kind: "i32" } },
+      ],
+    });
+    pushDefinedFunc(ctx, seekIdx, {
+      name: "testSeek",
+      typeIdx: seekType,
+      locals: [{ name: "payload", type: { kind: "ref_null", typeIdx: payloadType } }],
+      exported: true,
+      body: [
+        { op: "local.get", index: 0 },
+        { op: "any.convert_extern" },
+        { op: "ref.cast", typeIdx: recType },
+        { op: "struct.get", typeIdx: recType, fieldIdx: 3 },
+        { op: "any.convert_extern" },
+        { op: "ref.cast", typeIdx: payloadType },
+        // Explicitly separate decoding from writing. The struct-set repair
+        // otherwise walks through the net-zero struct.get/conversion chain
+        // to param 0 and inserts a payload cast before the IterRec cast.
+        { op: "local.set", index: 2 },
+        { op: "local.get", index: 2 },
+        { op: "local.get", index: 1 },
+        { op: "struct.set", typeIdx: payloadType, fieldIdx: 1 },
+      ],
+    });
+    ctx.mod.exports.push({ name: "testSeek", desc: { kind: "func", index: seekIdx } });
+    iterator.ensureNativeArrayFromIterN(ctx);
+    if (strict) iterator.ensureNativeStrictSpreadRuntime(ctx);
+    for (const name of [
+      "__live_array_values",
+      "__iterator_next",
+      "__iterator_rest",
+      "__array_from_iter_n",
+      ...(strict ? ["__iterator_next_strict"] : []),
+    ]) {
+      const index = ctx.funcMap.get(name)!;
+      const fn = definedFuncAt(ctx, index);
+      expect(fn, name).toBeDefined();
+      fn!.exported = true;
+      ctx.mod.exports.push({ name, desc: { kind: "func", index } });
+    }
+  });
+  const result = await compile(
+    `
+    export function legacySeed(): any { return [1].values(); }
+    export function classify(v: any): number {
+      if (v === undefined) return -1000;
+      if (v !== v) return -2000;
+      return v as number;
+    }
+    export function at(a: any, i: number): number { return classify(a[i]); }
+    export function size(a: any): number { return a.length; }
+    export function set(a: any, i: number, v: number): void { a[i] = v; }
+    export function resize(a: any, n: number): void { a.length = n; }
+    export function borrowed(it: any): number {
+      const next: any = Object.getPrototypeOf([1].values()).next;
+      return classify(next.call(it).value);
+    }
+    export function sum(it: any): number {
+      let result = 0;
+      for (const v of it) result += v as number;
+      return result;
+    }
+    ${source}
+  `,
+    { fileName: "live-array-substrate.ts", target: "standalone", nativeStrings: true },
+  );
+  expect(installed.size).toBeGreaterThan(0);
+  expect(result.success, JSON.stringify(result.errors)).toBe(true);
+  const module = await WebAssembly.compile(result.binary);
+  expect(WebAssembly.Module.imports(module)).toEqual([]);
+  const instance = await WebAssembly.instantiate(module, {});
+  const ex = instance.exports as Record<string, (...args: any[]) => any>;
+  ex._start?.();
+  const step = (rec: unknown, strictStep = false): [number, number] => {
+    const [done, value] = ex[strictStep ? "__iterator_next_strict" : "__iterator_next"](rec);
+    return [done, ex.classify(value)];
+  };
+  const contents = (a: unknown): number[] => Array.from({ length: ex.size(a) }, (_, i) => ex.at(a, i));
+  return { ex, step, contents };
+}
+
+const classify = (v: unknown): number =>
+  v === undefined ? -1000 : typeof v === "number" && Number.isNaN(v) ? -2000 : (v as number);
+const nativeStep = (it: Iterator<unknown>): [number, number] => {
+  const r = it.next();
+  return [Number(r.done), classify(r.value)];
+};
+
+describe("opt-in live array cursor substrate (not GetIterator integration)", () => {
+  for (const strict of [false, true]) {
+    it(`observes replacement/growth and permanently latches, strict=${strict}`, async () => {
+      const { ex, step } = await harness("export function make(): any { return [1, 2, 3]; }", strict);
+      const a = ex.make();
+      const rec = ex.__live_array_values(a);
+      const b = [1, 2, 3];
+      const control = b.values();
+      expect(step(rec, strict)).toEqual(nativeStep(control));
+      ex.set(a, 1, 7);
+      b[1] = 7;
+      ex.set(a, 3, 9);
+      b[3] = 9;
+      for (let n = 0; n < 4; n++) expect(step(rec, strict)).toEqual(nativeStep(control));
+      ex.set(a, 4, 11);
+      b[4] = 11;
+      expect(step(rec, strict)).toEqual(nativeStep(control));
+      // A second producer call is an independent cursor over the same source.
+      expect(step(ex.__live_array_values(a), strict)).toEqual([0, 1]);
+    });
+  }
+
+  it("polls rest through terminal, advances, and cannot revive after regrowth", async () => {
+    const { ex, step, contents } = await harness("export function make(): any { return [1, 2, 3]; }");
+    const a = ex.make();
+    const rec = ex.__live_array_values(a);
+    expect(step(rec)).toEqual([0, 1]);
+    ex.set(a, 2, 8);
+    expect(contents(ex.__iterator_rest(rec))).toEqual([2, 8]);
+    ex.set(a, 3, 9);
+    expect(contents(ex.__iterator_rest(rec))).toEqual([]);
+    expect(step(rec, true)).toEqual([1, -1000]);
+  });
+
+  it("has no signed-i32 sentinel or cursor wrap at the unsigned array boundary", async () => {
+    const { ex, step } = await harness(`
+      export function make(): any {
+        const a: any = { length: 4294967295 };
+        a[2147483647] = 7;
+        a[2147483648] = 8;
+        a[4294967294] = 9;
+        return a;
+      }
+    `);
+    const rec = ex.__live_array_values(ex.make());
+    ex.testSeek(rec, 2147483647);
+    expect(step(rec)).toEqual([0, 7]);
+    expect(step(rec, true)).toEqual([0, 8]);
+    ex.testSeek(rec, 4294967294);
+    expect(step(rec, true)).toEqual([0, 9]);
+    expect(step(rec)).toEqual([1, -1000]);
+  });
+
+  it("observes shrink/regrow without resurrecting deleted values", async () => {
+    const { ex, step } = await harness("export function make(): any { return [1, 2, 3]; }");
+    const a = ex.make();
+    const rec = ex.__live_array_values(a);
+    const b = [1, 2, 3];
+    const control = b.values();
+    expect(step(rec)).toEqual(nativeStep(control));
+    ex.resize(a, 1);
+    b.length = 1;
+    ex.resize(a, 3);
+    b.length = 3;
+    for (let n = 0; n < 3; n++) expect(step(rec, true)).toEqual(nativeStep(control));
+  });
+
+  it("bounded materialization advances exactly n steps, then helper loops resume", async () => {
+    const { ex, step, contents } = await harness("export function make(): any { return [1, 2, 3]; }");
+    const rec = ex.__live_array_values(ex.make());
+    expect(contents(ex.__array_from_iter_n(rec, 1))).toEqual([1]);
+    expect(ex.borrowed(rec)).toBe(2);
+    expect(ex.sum(rec)).toBe(3);
+    expect(step(rec)).toEqual([1, -1000]);
+  });
+
+  it("preserves holes, own undefined and genuine NaN through semantic indexed Get", async () => {
+    const { ex, step } = await harness(`
+      export function make(): any {
+        const a: any = [, undefined, NaN];
+        const p: any = Object.create(Array.prototype);
+        p[0] = 41;
+        p[1] = 42;
+        Object.setPrototypeOf(a, p);
+        return a;
+      }
+    `);
+    // biome-ignore lint/suspicious/noSparseArray: intentional hole distinguishes inherited reads from own undefined.
+    const a = [, undefined, NaN];
+    const p = Object.create(Array.prototype);
+    p[0] = 41;
+    p[1] = 42;
+    Object.setPrototypeOf(a, p);
+    const control = a.values();
+    const rec = ex.__live_array_values(ex.make());
+    for (let n = 0; n < 4; n++) expect(step(rec, true)).toEqual(nativeStep(control));
+  });
+
+  it("retains advancement after throwing indexed Get and permits reentrant next", async () => {
+    const { ex, step } = await harness(`
+      let current: any;
+      export function bind(it: any): void { current = it; }
+      export function make(): any {
+        const a: any = [1, 2, 3];
+        Object.defineProperty(a, "0", { get: function(): number {
+          return current.next().value as number;
+        } });
+        Object.defineProperty(a, "2", { get: function(): number { throw 17; } });
+        return a;
+      }
+    `);
+    const rec = ex.__live_array_values(ex.make());
+    ex.bind(rec);
+    expect(step(rec)).toEqual([0, 2]);
+    expect(() => step(rec, true)).toThrow();
+    expect(step(rec)).toEqual([1, -1000]);
+  });
+
+  it("does not Get or convert length again after exhaustion", async () => {
+    const { ex, step } = await harness(`
+      let reads = 0;
+      export function count(): number { return reads; }
+      export function make(): any {
+        return { get length(): any {
+          reads++;
+          if (reads > 1) throw 99;
+          return { valueOf: function(): number { return 0; } };
+        } };
+      }
+    `);
+    // Intrinsic values is generic: this harness has already selected it.
+    const rec = ex.__live_array_values(ex.make());
+    expect(step(rec)).toEqual([1, -1000]);
+    expect(step(rec, true)).toEqual([1, -1000]);
+    expect(ex.count()).toBe(1);
+  });
+
+  it("passes explicit number to hint-sensitive length @@toPrimitive", async () => {
+    const { ex, step } = await harness(`
+      let hints = 0;
+      export function hintTrace(): number { return hints; }
+      export function make(): any {
+        const length: any = {
+          [Symbol.toPrimitive]: function(hint: string): number {
+            hints = hints * 10 + (hint === "number" ? 1 : 9);
+            return hint === "number" ? 2 : 0;
+          }
+        };
+        return { 0: 7, 1: 8, length: length };
+      }
+    `);
+    let hints = 0;
+    const control = Array.prototype.values.call({
+      0: 7,
+      1: 8,
+      length: {
+        [Symbol.toPrimitive](hint: string) {
+          hints = hints * 10 + (hint === "number" ? 1 : 9);
+          return hint === "number" ? 2 : 0;
+        },
+      },
+    });
+    const rec = ex.__live_array_values(ex.make());
+    for (let n = 0; n < 4; n++) expect(step(rec, true)).toEqual(nativeStep(control));
+    console.log(
+      JSON.stringify({
+        case: "length hint trace after exhaustion",
+        native: hints,
+        wasm: ex.hintTrace(),
+        expected: 111,
+      }),
+    );
+    expect(hints).toBe(111);
+    expect(ex.hintTrace()).toBe(hints);
+  });
+
+  for (const accessor of [false, true]) {
+    it(`reads Array.prototype inherited ${accessor ? "getter" : "data"}, preserving own undefined/NaN`, async () => {
+      const descriptor = (value: number) =>
+        accessor
+          ? `{ configurable: true, get: function(): number { reads++; return ${value}; } }`
+          : `{ configurable: true, writable: true, value: ${value} }`;
+      const { ex, step } = await harness(`
+        let reads = 0;
+        export function getterReads(): number { return reads; }
+        export function make(): any {
+          const a: any = [, undefined, NaN];
+          Object.defineProperty(Array.prototype, "0", ${descriptor(41)});
+          Object.defineProperty(Array.prototype, "1", ${descriptor(42)});
+          Object.defineProperty(Array.prototype, "2", ${descriptor(43)});
+          return a;
+        }
+      `);
+      const saved = [0, 1, 2].map((i) => Object.getOwnPropertyDescriptor(Array.prototype, String(i)));
+      let reads = 0;
+      let expected: [number, number][];
+      // Keep native prototype mutation synchronous and restore it before any
+      // assertion or Wasm call. Do not turn the original custom-proto case
+      // into this supported writer case; both remain independently visible.
+      try {
+        for (let i = 0; i < 3; i++) {
+          Object.defineProperty(
+            Array.prototype,
+            String(i),
+            accessor
+              ? {
+                  configurable: true,
+                  get() {
+                    reads++;
+                    return 41 + i;
+                  },
+                }
+              : { configurable: true, writable: true, value: 41 + i },
+          );
+        }
+        // biome-ignore lint/suspicious/noSparseArray: preserve the exact hole/undefined/NaN reference fixture.
+        const control = [, undefined, NaN].values();
+        expected = [nativeStep(control), nativeStep(control), nativeStep(control), nativeStep(control)];
+      } finally {
+        for (let i = 0; i < 3; i++) {
+          if (saved[i]) Object.defineProperty(Array.prototype, String(i), saved[i]!);
+          else Reflect.deleteProperty(Array.prototype, String(i));
+        }
+      }
+      expect(expected).toEqual([
+        [0, 41],
+        [0, -1000],
+        [0, -2000],
+        [1, -1000],
+      ]);
+      expect(reads).toBe(accessor ? 1 : 0);
+      const rec = ex.__live_array_values(ex.make());
+      for (const row of expected) expect(step(rec, true)).toEqual(row);
+      expect(ex.getterReads()).toBe(reads);
+    });
+  }
+});
