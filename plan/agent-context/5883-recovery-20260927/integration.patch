+            ${resolveBody}
+          };
+          COMBINE(a).then(function(v:any):void {settled++;answer=${method === "all" ? "v[0]" : "v"};},function(e:any):void {settled++;reason=e;});
+          __drain_microtasks();
+          return polls===2 && returns===1 && settled===1 && ${method === "race" ? "answer===42 && reason===null" : failure === "then-noncallable" ? "reason instanceof TypeError" : "reason===original"} ? 1 : 0;
+        `,
+            method,
+          ),
+        ).toBe(1);
+      });
+    }
