index 0000000000..f757c744d9
--- /dev/null
+++ b/tests/issue-5883-reflective-live-values.test.ts
@@ -0,0 +1,113 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { createHash } from "node:crypto";
+import { runInNewContext } from "node:vm";
+import { expect, it } from "vitest";
+import { compile } from "../src/index.js";
+
+const cases = [
+  [
+    "boxes primitive receivers once before deferred property reads",
+    `
+    let receiver;
+    Object.defineProperty(Number.prototype, "length", {
+      configurable: true,
+      get: function () { "use strict"; receiver = this; return 1; }
+    });
+    Object.defineProperty(Number.prototype, "0", {
+      configurable: true,
+      get: function () { "use strict"; return this === receiver && typeof this === "object" ? 7 : -9; }
+    });
+    const iterator = Array.prototype.values.call(3);
+    if (receiver !== undefined) return -1;
+    const first = iterator.next();
+    return !first.done && first.value === 7 ? 1 : -2;
+  `,
+  ],
+  [
+    "does not read length or indices at creation",
+    `
+    let reads = 0;
+    const source = { get length() { reads++; return 1; }, get 0() { reads += 10; return 7; } };
+    const values = Array.prototype.values;
+    const iterator = values.call(source);
+    if (reads !== 0) return -1;
+    const first = iterator.next();
+    if (first.done || first.value !== 7 || reads !== 11) return -2;
+    const end = iterator.next();
+    return end.done && end.value === undefined && reads === 12 ? 1 : -3;
+  `,
+  ],
+  [
+    "observes replacement and growth on the original receiver",
+    `
+    const source = { 0: 1, 1: 2, 2: 3, length: 2 };
+    const values = Array.prototype.values;
+    const iterator = values.call(source);
+    if (iterator.next().value !== 1) return -1;
+    source[1] = 7;
+    source.length = 3;
+    if (iterator.next().value !== 7 || iterator.next().value !== 3) return -2;
+    return iterator.next().done ? 1 : -3;
+  `,
+  ],
+  [
+    "does not revive an exhausted cursor after regrowth",
+    `
+    let reads = 0;
+    let length = 1;
+    const source = { 0: 1, 1: 2, get length() { reads++; return length; } };
+    const iterator = Array.prototype.values.call(source);
+    if (iterator.next().value !== 1 || !iterator.next().done || reads !== 2) return -1;
+    length = 2;
+    const again = iterator.next();
+    return again.done && again.value === undefined && reads === 2 ? 1 : -2;
+  `,
+  ],
+  [
+    "defers a throwing length getter until next",
+    `
+    const reason = {};
+    const source = { get length() { throw reason; } };
+    let iterator;
+    try { iterator = Array.prototype.values.call(source); } catch (_) { return -1; }
+    try { iterator.next(); return -2; } catch (error) { return error === reason ? 1 : -3; }
+  `,
+  ],
+  [
+    "retains nullish receiver rejection",
+    `
+    const values = Array.prototype.values;
+    let caught = 0;
+    try { values.call(null); } catch (error) { if (error instanceof TypeError) caught++; }
+    try { values.call(undefined); } catch (error) { if (error instanceof TypeError) caught++; }
+    return caught === 2 ? 1 : -1;
+  `,
+  ],
+] as const;
+
+for (const [name, body] of cases) {
+  it(name, async () => {
+    const source = `export function test() { ${body} }`;
+    const native = runInNewContext(`(function () { ${body} })()`, {}, { timeout: 5000 });
+    // Record both implementations before the reference canary asserts. Node
+    // 22 rereads length after exhaustion; its failure must not hide Wasm's
+    // result. Neither source nor either expectation is relaxed here.
+    const result = await compile(source, {
+      fileName: "5883-reflective-live-values.js",
+      allowJs: true,
+      skipSemanticDiagnostics: true,
+      target: "standalone",
+      nativeStrings: true,
+    });
+    expect(result.success, JSON.stringify(result.errors)).toBe(true);
+    const module = new WebAssembly.Module(result.binary);
+    expect(WebAssembly.Module.imports(module)).toEqual([]);
+    const instance = new WebAssembly.Instance(module, {});
+    const actual = (instance.exports.test as () => number)();
+    console.log(
+      JSON.stringify({ name, source, sha256: createHash("sha256").update(source).digest("hex"), native, actual }),
+    );
+    expect(native).toBe(1);
+    expect(actual).toBe(native);
+  });
+}
diff --git a/src/codegen/expressions/member-override-facts.ts b/src/codegen/expressions/member-override-facts.ts
new file mode 100644
--- /dev/null
+++ b/src/codegen/expressions/member-override-facts.ts
@@ -0,0 +1,88 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+/**
+ * Exact historical whole-SourceFile override facts. No receiver resolution,
+ * compiler context, module-wide admission, or runtime registration.
+ * Keep separate SourceFile/name caches and assignment-first short circuiting.
+ * SourceFile identity (not its filename) is the cache key; sources are immutable.
+ */
+import { ts, forEachChild } from "../../ts-api.js";
+
+const _reassignmentCache = new WeakMap<ts.SourceFile, Map<string, boolean>>();
+export function sourceMethodReassignmentFact(sf: ts.SourceFile | undefined, methodName: string): boolean {
+  if (!sf) return false;
+  let perFile = _reassignmentCache.get(sf);
+  if (perFile === undefined) {
+    perFile = new Map<string, boolean>();
+    _reassignmentCache.set(sf, perFile);
+  }
+  const cached = perFile.get(methodName);
+  if (cached !== undefined) return cached;
+
+  let found = false;
+  function visit(node: ts.Node): void {
+    if (found) return;
+    if (
+      ts.isBinaryExpression(node) &&
+      node.operatorToken.kind === ts.SyntaxKind.EqualsToken &&
+      ts.isPropertyAccessExpression(node.left) &&
+      ts.isIdentifier(node.left.name) &&
+      node.left.name.text === methodName
+    ) {
+      found = true;
+      return;
+    }
+    forEachChild(node, visit);
+  }
+  visit(sf);
+  perFile.set(methodName, found);
+  return found;
+}
+
+const _definePropertyCache = new WeakMap<ts.SourceFile, Map<string, boolean>>();
+export function sourceMethodDefinitionFact(sf: ts.SourceFile | undefined, methodName: string): boolean {
+  if (!sf) return false;
+  let perFile = _definePropertyCache.get(sf);
+  if (perFile === undefined) {
+    perFile = new Map<string, boolean>();
+    _definePropertyCache.set(sf, perFile);
+  }
+  const cached = perFile.get(methodName);
+  if (cached !== undefined) return cached;
+
+  let found = false;
+  function visit(node: ts.Node): void {
+    if (found) return;
+    if (ts.isCallExpression(node) && ts.isPropertyAccessExpression(node.expression)) {
+      const callee = node.expression.name.text;
+      if (callee === "defineProperty" && node.arguments.length >= 2) {
+        const key = node.arguments[1];
+        if (key !== undefined && ts.isStringLiteralLike(key) && key.text === methodName) {
+          found = true;
+          return;
+        }
+      }
+      if (callee === "defineProperties" && node.arguments.length >= 2) {
+        const descs = node.arguments[1];
+        if (descs !== undefined && ts.isObjectLiteralExpression(descs)) {
+          for (const p of descs.properties) {
+            const n = p.name;
+            if (n === undefined) continue;
+            if ((ts.isIdentifier(n) || ts.isStringLiteralLike(n)) && n.text === methodName) {
+              found = true;
+              return;
+            }
+          }
+        }
+      }
+    }
+    forEachChild(node, visit);
+  }
+  visit(sf);
+  perFile.set(methodName, found);
+  return found;
+}
+
+/** Pure assignment-or-definition fact; this alone does not admit any lowering. */
+export function sourceMethodOverrideFacts(sf: ts.SourceFile | undefined, methodName: string): boolean {
+  return sourceMethodReassignmentFact(sf, methodName) || sourceMethodDefinitionFact(sf, methodName);
+}
diff --git a/src/codegen/iterator-protocol-get.ts b/src/codegen/iterator-protocol-get.ts
new file mode 100644
--- /dev/null
+++ b/src/codegen/iterator-protocol-get.ts
@@ -0,0 +1,278 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+/** Semantic Get for captured iterator protocols. No callability or iteration here. */
+import type { Instr, ValType } from "../ir/types.js";
+import type { CodegenContext, FunctionContext } from "./context/types.js";
+import { ensureObjectRuntime } from "./object-runtime.js";
+import { ensureIterRecPrototypeHelper } from "./iterator-proto-next.js";
+import { ensureArrayNativeProtoGlue } from "./array-object-proto.js";
+import { ensureNativeProtoCompanionSeeder } from "./native-proto.js";
+import { ensureNativeGeneratorProtocol } from "./generators-native-protocol.js";
+import { reserveProtoIndexStore } from "./proto-index-store.js";
+import { BUILTIN_BRAND_BASE } from "./builtin-brands.js";
+import { canonicalUndefinedExternInstrs, ensureExternStrictEqHelper } from "./any-helpers.js";
+import { addStringConstantGlobals } from "./registry/imports.js";
+import { stringConstantExternrefInstrs } from "./native-strings.js";
+import { reserveMemberGetDispatch } from "./member-get-dispatch.js";
+import { reserveVecOverlayHelpers } from "./vec-overlay.js";
+import { mintDefinedFunc, pushDefinedFunc, definedFuncAt } from "./func-space.js";
+import { addFuncType } from "./registry/types.js";
+import { flushLateImportShifts } from "./shared.js";
+
+const ER: ValType = { kind: "externref" };
+const GET = "__iterator_protocol_get";
+const TARGET = "__iterator_protocol_get_target";
+const KEY = "__iterator_protocol_key";
+const registering = new WeakSet<CodegenContext>();
+const load = (index: number): Instr => ({ op: "local.get", index });
+const call = (ctx: CodegenContext, name: string): Instr => {
+  const funcIdx = ctx.funcMap.get(name);
+  if (funcIdx === undefined) throw new Error(`Iterator protocol Get requires ${name}`);
+  return { op: "call", funcIdx };
+};
+const arm = (then: Instr[]): Instr => ({ op: "if", blockType: { kind: "empty" }, then });
+
+/**
+ * Call during dependency registration, BEFORE compiling source bodies/module
+ * init, so intercepted writes before the first Promise call are published too.
+ * funcMap reservations are also the opt-in flag and survive index shifting.
+ * Parent must finalizeExternGetReceiverEntry AFTER every property-read fill.
+ * IterRec own storage and general vector prototype writes remain prerequisites
+ * of the shared storage owners (see lane B handoff); no cache substitutes here.
+ */
+export function ensureIteratorProtocolGetRuntime(ctx: CodegenContext, fctx: FunctionContext): void {
+  flushLateImportShifts(ctx, fctx);
+  const existing = ctx.funcMap.get(GET);
+  if (existing !== undefined) {
+    const fn = definedFuncAt(ctx, existing);
+    if (!fn || (fn.body[0]?.op === "unreachable" && !registering.has(ctx))) {
+      throw new Error("Iterator protocol Get registration did not complete");
+    }
+    return;
+  }
+  if (!ctx.standalone) throw new Error("Captured iterator protocol Get requires the standalone property provider");
+  // Reserve both stable handles before recursive runtime registration. Bodies
+  // are emitted once, after all allocating dependencies have settled.
+  for (const [name, count] of [
+    [GET, 2],
+    [TARGET, 3],
+  ] as const) {
+    const typeIdx = addFuncType(
+      ctx,
+      Array.from({ length: count }, () => ER),
+      [ER],
+    );
+    const idx = mintDefinedFunc(ctx);
+    ctx.funcMap.set(name, idx);
+    pushDefinedFunc(ctx, idx, { name, typeIdx, locals: [], body: [{ op: "unreachable" }], exported: false });
+  }
+  registering.add(ctx);
+  try {
+    emitIteratorProtocolGetRuntime(ctx, fctx);
+  } finally {
+    registering.delete(ctx);
+  }
+}
+
+function emitIteratorProtocolGetRuntime(ctx: CodegenContext, fctx: FunctionContext): void {
+  ctx.protoMemberDirty = true;
+  ensureObjectRuntime(ctx);
+  reserveProtoIndexStore(ctx);
+  reserveVecOverlayHelpers(ctx);
+  const brand = ensureArrayNativeProtoGlue(ctx);
+  if (brand === undefined) throw new Error("Iterator protocol Get requires Array.prototype");
+  ensureNativeProtoCompanionSeeder(ctx, brand);
+  ensureIterRecPrototypeHelper(ctx);
+  ensureNativeGeneratorProtocol(ctx, fctx);
+  addStringConstantGlobals(ctx, ["next", "return", "done", "value", "values"]);
+  for (const key of ["next", "return", "done", "value"]) {
+    if (reserveMemberGetDispatch(ctx, key, fctx) === undefined) {
+      throw new Error(`Iterator protocol Get requires the finalized ${key} reader`);
+    }
+  }
+  if (ensureExternStrictEqHelper(ctx) === undefined) throw new Error("Missing protocol key equality provider");
+  canonicalUndefinedExternInstrs(ctx);
+  flushLateImportShifts(ctx, fctx);
+  const protoType = ctx.nativeProtoTypeIdx;
+  const recType = ctx.structMap.get("__IterRec");
+  if (protoType === undefined || recType === undefined) throw new Error("Missing iterator protocol carrier types");
+  const miss = (): Instr[] => canonicalUndefinedExternInstrs(ctx);
+  const keyType = addFuncType(ctx, [ER], [{ kind: "i32" }]);
+  const keyIdx = mintDefinedFunc(ctx);
+  ctx.funcMap.set(KEY, keyIdx);
+  const keyBody: Instr[] = [
+    load(0),
+    { op: "i32.const", value: 1 },
+    call(ctx, "__box_symbol"),
+    call(ctx, "__extern_strict_eq"),
+    arm([{ op: "i32.const", value: 1 }, { op: "return" }]),
+  ];
+  for (const key of ["next", "return", "done", "value", "values"]) {
+    keyBody.push(
+      load(0),
+      ...stringConstantExternrefInstrs(ctx, key),
+      call(ctx, "__extern_strict_eq"),
+      arm([{ op: "i32.const", value: 1 }, { op: "return" }]),
+    );
+  }
+  keyBody.push({ op: "i32.const", value: 0 });
+  pushDefinedFunc(ctx, keyIdx, { name: KEY, typeIdx: keyType, locals: [], body: keyBody, exported: false });
+  const target = definedFuncAt(ctx, ctx.funcMap.get(TARGET)!)!;
+  target.locals = [{ name: "prototype", type: ER }];
+  target.body.splice(
+    0,
+    1,
+    // Other keys retain the general reader (notably vector indices/length).
+    load(1),
+    call(ctx, KEY),
+    { op: "i32.eqz" },
+    arm([load(0), load(1), load(2), call(ctx, "__reflect_get_receiver"), { op: "return" }]),
+    // Presence, never a value/miss test: an own undefined getter shadows every
+    // inherited method. The bag is read with the original receiver.
+    load(0),
+    load(1),
+    call(ctx, "__carrier_bag_has"),
+    arm([
+      load(0),
+      call(ctx, "__carrier_bag_of"),
+      load(1),
+      load(2),
+      call(ctx, "__reflect_get_receiver"),
+      { op: "return" },
+    ]),
+    // Native prototype descriptors and tombstones share the ordinary writer's
+    // companion. Do not run the static method ladder after a missing entry:
+    // deletion must walk to the parent, never resurrect an intrinsic.
+    load(0),
+    { op: "any.convert_extern" },
+    { op: "ref.test", typeIdx: protoType },
+    arm([
+      load(0),
+      { op: "any.convert_extern" },
+      { op: "ref.cast", typeIdx: protoType },
+      { op: "struct.get", typeIdx: protoType, fieldIdx: 1 },
+      { op: "i32.eqz" },
+      arm([
+        load(2),
+        load(1),
+        call(ctx, "__protoidx_norm_key"),
+        load(0),
+        { op: "any.convert_extern" },
+        { op: "ref.cast", typeIdx: protoType },
+        { op: "struct.get", typeIdx: protoType, fieldIdx: 0 },
+        { op: "i32.const", value: BUILTIN_BRAND_BASE },
+        { op: "i32.sub" },
+        call(ctx, "__protoidx_get_k"),
+        { op: "return" },
+      ]),
+    ]),
+    load(0),
+    { op: "any.convert_extern" },
+    { op: "ref.test", typeIdx: recType },
+    arm([
+      load(0),
+      call(ctx, "__iter_rec_proto"),
+      { op: "local.set", index: 3 },
+      load(3),
+      { op: "ref.is_null" },
+      arm([...miss(), { op: "return" }]),
+      load(3),
+      load(1),
+      load(2),
+      call(ctx, TARGET),
+      { op: "return" },
+    ]),
+    load(0),
+    call(ctx, "__is_vec_prop_carrier"),
+    arm([
+      load(0),
+      call(ctx, "__getPrototypeOf"),
+      { op: "local.set", index: 3 },
+      load(3),
+      { op: "ref.is_null" },
+      arm([...miss(), { op: "return" }]),
+      load(3),
+      load(1),
+      load(2),
+      call(ctx, TARGET),
+      { op: "return" },
+    ]),
+    // The existing generator view maps a frame to its ordinary descriptor /
+    // prototype object and leaves every other carrier unchanged. Read that
+    // view with the explicit Receiver, including trap-absent Proxy forwarding.
+    load(0),
+    call(ctx, "__native_generator_proto_view"),
+    { op: "local.set", index: 3 },
+    load(0),
+    load(3),
+    call(ctx, "__extern_strict_eq"),
+    { op: "i32.eqz" },
+    arm([load(3), load(1), load(2), call(ctx, TARGET), { op: "return" }]),
+    // The finalized member readers include closed methods/accessors and native
+    // generator result fields (with sentinel-aware value boxing). They accept
+    // the target as Receiver, so only use them for the original object, never
+    // for a prototype walk carrying a distinct Receiver.
+    load(0),
+    load(2),
+    call(ctx, "__extern_strict_eq"),
+    arm(
+      ["next", "return", "done", "value"].flatMap((key): Instr[] => [
+        load(1),
+        ...stringConstantExternrefInstrs(ctx, key),
+        call(ctx, "__extern_strict_eq"),
+        arm([load(0), call(ctx, `__get_member_${key}`), { op: "return" }]),
+      ]),
+    ),
+    // Closed shapes, ordinary objects, callable objects, native generators and
+    // proxies retain the finalized reader and its explicit-receiver bridge.
+    load(0),
+    load(1),
+    load(2),
+    call(ctx, "__reflect_get_receiver"),
+  );
+  const get = definedFuncAt(ctx, ctx.funcMap.get(GET)!)!;
+  get.body.splice(0, 1, load(0), load(1), load(0), call(ctx, TARGET));
+}
+
+/** Overlay lookup is minted by the existing late vec fill; splice only then. */
+export function fillIteratorProtocolGetRuntime(ctx: CodegenContext): void {
+  const fn = ctx.mod.functions.find((candidate) => candidate.name === TARGET);
+  if (!fn || fn.locals.some((local) => local.name === "__protocol_overlay")) return;
+  const lookup = ctx.funcMap.get("__vec_overlay_lookup");
+  const object = ctx.objectRuntimeTypes?.objectTypeIdx;
+  if (lookup === undefined || object === undefined) return;
+  const bag = 3 + fn.locals.length;
+  fn.locals.push({ name: "__protocol_overlay", type: { kind: "ref_null", typeIdx: object } });
+  // Named/symbol definitions use the overlay; assignments use the expando bag
+  // unless an overlay entry already exists. Match the existing overlay-first
+  // read precedence, but carry the true Receiver through getter invocation.
+  fn.body.splice(
+    4,
+    0,
+    load(0),
+    call(ctx, "__is_vec_prop_carrier"),
+    arm([
+      load(0),
+      { op: "any.convert_extern" },
+      { op: "call", funcIdx: lookup },
+      { op: "local.tee", index: bag },
+      { op: "ref.is_null" },
+      { op: "i32.eqz" },
+      arm([
+        load(bag),
+        { op: "ref.as_non_null" },
+        load(1),
+        call(ctx, "__obj_find"),
+        { op: "ref.is_null" },
+        { op: "i32.eqz" },
+        arm([
+          load(bag),
+          { op: "extern.convert_any" },
+          load(1),
+          load(2),
+          call(ctx, "__reflect_get_receiver"),
+          { op: "return" },
+        ]),
+      ]),
+    ]),
+  );
+}
diff --git a/src/codegen/iterator-receiver-to-object.ts b/src/codegen/iterator-receiver-to-object.ts
new file mode 100644
--- /dev/null
+++ b/src/codegen/iterator-receiver-to-object.ts
@@ -0,0 +1,88 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import type { Instr, ValType } from "../ir/types.js";
+import type { CodegenContext } from "./context/types.js";
+import { mintDefinedFunc, pushDefinedFunc } from "./func-space.js";
+import { buildThrowJsErrorInstrs } from "./js-errors.js";
+import { ensureObjectRuntime } from "./object-runtime.js";
+import { addFuncType } from "./registry/types.js";
+import { addUnionImportsViaRegistry } from "./shared.js";
+import { ensureSymbolCarrier } from "./symbol-native.js";
+
+const NAME = "__iterator_receiver_to_object";
+const EXT: ValType = { kind: "externref" };
+
+/**
+ * Runtime ToObject for an already-evaluated reflective iterator receiver.
+ * Unlike Object(value), null/undefined THROW; unlike the static Object(...)
+ * lowering, an unknown primitive is classified and wrapped at runtime.
+ * Objects (including wrappers, arrays, closures and proxies) return unchanged.
+ *
+ * Register before emitting the calling function's instructions. All providers
+ * are native and all dependency registration precedes call-handle capture.
+ * No Get(length), Get(index), ToPrimitive or user constructor is invoked here.
+ */
+export function ensureNativeIteratorReceiverToObject(ctx: CodegenContext): number {
+  const existing = ctx.funcMap.get(NAME);
+  if (existing !== undefined) return existing;
+  if (!ctx.standalone && !ctx.wasi) throw new Error("Native iterator ToObject requires standalone/WASI");
+  ensureObjectRuntime(ctx);
+  addUnionImportsViaRegistry(ctx);
+  const symbolTypeIdx = ensureSymbolCarrier(ctx);
+  const nullishThrow = buildThrowJsErrorInstrs(ctx, "TypeError", "Array.prototype.values called on null or undefined", {
+    forceInModuleCtor: true,
+  });
+  const required = (name: string): number => {
+    const handle = ctx.funcMap.get(name);
+    if (handle === undefined) throw new Error(`Missing native iterator ToObject dependency: ${name}`);
+    return handle;
+  };
+  // Capture only after every ensure above. Missing native dependencies fail
+  // registration rather than adding a host import or treating a primitive as
+  // an object. Each arm owns its instruction objects.
+  const primitiveArm = (predicate: string, wrapper: string, convert: Instr[] = []): Instr[] => [
+    { op: "local.get", index: 0 },
+    { op: "call", funcIdx: required(predicate) },
+    {
+      op: "if",
+      blockType: { kind: "empty" },
+      then: [{ op: "local.get", index: 0 }, ...convert, { op: "call", funcIdx: required(wrapper) }, { op: "return" }],
+    },
+  ];
+  const body: Instr[] = [
+    { op: "local.get", index: 0 },
+    { op: "ref.is_null" },
+    { op: "local.get", index: 0 },
+    { op: "call", funcIdx: required("__extern_is_undefined") },
+    { op: "i32.or" },
+    { op: "if", blockType: { kind: "empty" }, then: nullishThrow },
+    ...primitiveArm("__typeof_number", "__new_Number", [{ op: "call", funcIdx: required("__unbox_number") }]),
+    ...primitiveArm("__typeof_boolean", "__new_Boolean", [
+      { op: "call", funcIdx: required("__unbox_boolean") },
+      { op: "f64.convert_i32_s" },
+    ]),
+    ...primitiveArm("__typeof_string", "__new_String"),
+    // __new_BigInt takes i64 and would narrow a wide primitive. __new_String
+    // is the canonical raw externref wrapper builder (also __new_Symbol's
+    // alias): it stores the value unchanged under WRAPPER_PRIMITIVE_KEY,
+    // without string conversion. Wrapper brand/prototype recovery consults
+    // that stored primitive, not the builder name. Preserve BigInt identity
+    // and precision through that same allocation body.
+    ...primitiveArm("__typeof_bigint", "__new_String"),
+    { op: "local.get", index: 0 },
+    { op: "any.convert_extern" },
+    { op: "ref.test", typeIdx: symbolTypeIdx },
+    {
+      op: "if",
+      blockType: { kind: "empty" },
+      then: [{ op: "local.get", index: 0 }, { op: "call", funcIdx: required("__new_Symbol") }, { op: "return" }],
+    },
+    // Runtime primitive discriminators do not admit wrapper objects. Returning
+    // the original reference preserves identity and avoids observable Gets.
+    { op: "local.get", index: 0 },
+  ];
+  const typeIdx = addFuncType(ctx, [EXT], [EXT]);
+  const funcIdx = mintDefinedFunc(ctx);
+  ctx.funcMap.set(NAME, funcIdx);
+  pushDefinedFunc(ctx, funcIdx, { name: NAME, typeIdx, locals: [], body, exported: false });
+  return funcIdx;
+}
diff --git a/src/codegen/promise-vector-iterator.ts b/src/codegen/promise-vector-iterator.ts
new file mode 100644
--- /dev/null
+++ b/src/codegen/promise-vector-iterator.ts
@@ -0,0 +1,258 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+/** Private GetIterator/IteratorStepValue/IteratorClose(throw) for the opt-in vector drive. */
+import type { Instr, ValType } from "../ir/types.js";
+import { buildTargetTaggedTry } from "../ir/try-table.js";
+import type { CodegenContext, FunctionContext } from "./context/types.js";
+import { definedFuncAt, mintDefinedFunc, pushDefinedFunc } from "./func-space.js";
+import { addFuncType } from "./registry/types.js";
+import { addStringConstantGlobals, ensureExnTag } from "./registry/imports.js";
+import { ensureObjectRuntime, ensureObjVecBuilders, reserveApplyClosure } from "./object-runtime.js";
+import { externIsObjectInstrs } from "./iterator-native.js";
+import { ensureIteratorProtocolGetRuntime } from "./iterator-protocol-get.js";
+import { stringConstantExternrefInstrs } from "./native-strings.js";
+import { canonicalUndefinedExternInstrs } from "./any-helpers.js";
+import { buildThrowJsErrorInstrs } from "./js-errors.js";
+import { emitToBoolean } from "./coercion-engine.js";
+import { ensureLateImport, flushLateImportShifts } from "./shared.js";
+
+const ER: ValType = { kind: "externref" };
+const I32: ValType = { kind: "i32" };
+const RECORD = "__PromiseVectorIteratorRecord";
+const ACQUIRE = "__promise_vector_iterator_acquire";
+const STEP = "__promise_vector_iterator_step";
+const CLOSE = "__promise_vector_iterator_close_throw";
+const ERROR = "Invalid iterator protocol";
+type Phase = "registering" | "reserved" | "emitted" | "failed";
+const states = new WeakMap<CodegenContext, { phase: Phase; error?: unknown }>();
+const get = (index: number): Instr => ({ op: "local.get", index });
+const set = (index: number): Instr => ({ op: "local.set", index });
+const int = (value: number): Instr => ({ op: "i32.const", value });
+const when = (then: Instr[]): Instr => ({ op: "if", blockType: { kind: "empty" }, then, else: [] });
+function call(ctx: CodegenContext, name: string): Instr {
+  const funcIdx = ctx.funcMap.get(name);
+  if (funcIdx === undefined) throw new Error(`Promise vector iterator requires ${name}`);
+  return { op: "call", funcIdx };
+}
+
+/**
+ * Register while source/type population is open, before constructing caller IR.
+ * B owns semantic Get and its late shape arms; this module never rebuilds bodies
+ * at finalization, dispatches an IterRec, or substitutes an intrinsic method.
+ */
+export function ensurePromiseVectorIteratorRuntime(ctx: CodegenContext, fctx: FunctionContext): void {
+  const previous = states.get(ctx);
+  if (previous) {
+    if (previous.phase === "failed") throw previous.error;
+    // A dependency cycle before reservation cannot safely expose missing handles.
+    // Producer/Get dependencies must not depend on Promise acquisition.
+    if (previous.phase === "registering") {
+      throw new Error("Promise vector iterator dependency reentered before helper reservation");
+    }
+    return;
+  }
+  const state: { phase: Phase; error?: unknown } = { phase: "registering" };
+  states.set(ctx, state);
+  try {
+    ensureObjectRuntime(ctx);
+    ensureObjVecBuilders(ctx);
+    reserveApplyClosure(ctx);
+    ensureIteratorProtocolGetRuntime(ctx, fctx);
+    addStringConstantGlobals(ctx, ["next", "done", "value", "return", ERROR]);
+    for (const name of [
+      "__typeof_object",
+      "__typeof_function",
+      "__is_callable",
+      "__is_truthy",
+      "__extern_is_undefined",
+    ]) {
+      ensureLateImport(ctx, name, [ER], [I32]);
+    }
+    // Warm allocating providers BEFORE retaining any detached instructions.
+    emitToBoolean(ctx, ER, []);
+    canonicalUndefinedExternInstrs(ctx);
+    buildThrowJsErrorInstrs(ctx, "TypeError", ERROR, { flush: fctx });
+    ensureExnTag(ctx);
+    for (const key of ["next", "done", "value", "return"]) stringConstantExternrefInstrs(ctx, key);
+    flushLateImportShifts(ctx, fctx);
+    for (const name of [
+      "__iterator_protocol_get",
+      "__apply_closure",
+      "__objvec_new",
+      "__box_symbol",
+      "__typeof_object",
+      "__typeof_function",
+      "__is_callable",
+      "__is_truthy",
+      "__extern_is_undefined",
+      "__new_TypeError",
+    ])
+      call(ctx, name);
+
+    const recordType = ctx.mod.types.length;
+    ctx.mod.types.push({
+      kind: "struct",
+      name: RECORD,
+      fields: [
+        { name: "iterator", type: ER, mutable: false },
+        { name: "nextMethod", type: ER, mutable: false },
+        { name: "done", type: I32, mutable: true },
+      ],
+    });
+    // Deliberately absent from generic JS property/carrier field registries.
+    ctx.structMap.set(RECORD, recordType);
+    const rec: ValType = { kind: "ref", typeIdx: recordType };
+    const reserve = (name: string, params: ValType[], results: ValType[], locals: ValType[]) => {
+      const typeIdx = addFuncType(ctx, params, results);
+      const handle = mintDefinedFunc(ctx);
+      ctx.funcMap.set(name, handle);
+      pushDefinedFunc(ctx, handle, {
+        name,
+        typeIdx,
+        exported: false,
+        locals: locals.map((type, i) => ({ name: `scratch${i}`, type })),
+        body: [{ op: "unreachable" }],
+      });
+    };
+    reserve(ACQUIRE, [ER], [ER], [ER, ER, ER]);
+    reserve(STEP, [ER], [I32, ER], [rec, ER, ER, ER, ER]);
+    reserve(CLOSE, [ER, ER], [ER], [rec, ER]);
+    state.phase = "reserved";
+
+    // All factories below are read-only and create fresh instruction trees.
+    const tagIdx = ensureExnTag(ctx);
+    const fail = (): Instr[] => [
+      ...stringConstantExternrefInstrs(ctx, ERROR),
+      call(ctx, "__new_TypeError"),
+      { op: "throw", tagIdx },
+    ];
+    const callable = (local: number): Instr[] => [
+      get(local),
+      call(ctx, "__is_callable"),
+      { op: "i32.eqz" },
+      when(fail()),
+    ];
+    const object = (local: number): Instr[] => {
+      const predicate = externIsObjectInstrs(ctx, local);
+      if (!predicate) throw new Error("Promise vector iterator object predicate unavailable");
+      return [...predicate, { op: "i32.eqz" }, when(fail())];
+    };
+    const property = (local: number, key: string): Instr[] => [
+      get(local),
+      ...stringConstantExternrefInstrs(ctx, key),
+      call(ctx, "__iterator_protocol_get"),
+    ];
+    const invoke = (method: number, receiver: number): Instr[] => [
+      ...callable(method),
+      get(method),
+      get(receiver),
+      call(ctx, "__objvec_new"),
+      call(ctx, "__apply_closure"),
+    ];
+    const cast = (local: number): Instr[] => [
+      get(0),
+      { op: "any.convert_extern" },
+      { op: "ref.cast", typeIdx: recordType },
+      set(local),
+    ];
+    const field = (local: number, fieldIdx: number): Instr[] => [
+      get(local),
+      { op: "struct.get", typeIdx: recordType, fieldIdx },
+    ];
+    const markDone = (local: number): Instr[] => [
+      get(local),
+      int(1),
+      { op: "struct.set", typeIdx: recordType, fieldIdx: 2 },
+    ];
+    const terminal = (): Instr[] => [int(1), ...canonicalUndefinedExternInstrs(ctx), { op: "return" }];
+    const emit = (name: string, body: Instr[]) => {
+      const fn = definedFuncAt(ctx, ctx.funcMap.get(name)!);
+      if (!fn) throw new Error(`Missing reserved Promise vector iterator helper ${name}`);
+      fn.body = body;
+    };
+
+    emit(ACQUIRE, [
+      // Well-known symbol id 1 is Symbol.iterator, never the string alias.
+      get(0),
+      int(1),
+      call(ctx, "__box_symbol"),
+      call(ctx, "__iterator_protocol_get"),
+      set(1),
+      ...invoke(1, 0),
+      set(2),
+      ...object(2),
+      ...property(2, "next"),
+      set(3),
+      // GetIterator captures even a noncallable next; IteratorNext checks it.
+      get(2),
+      get(3),
+      int(0),
+      { op: "struct.new", typeIdx: recordType },
+      { op: "extern.convert_any" },
+    ]);
+    emit(STEP, [
+      ...cast(1),
+      ...field(1, 2),
+      when(terminal()),
+      buildTargetTaggedTry(
+        ctx,
+        { kind: "empty" },
+        [
+          ...field(1, 0),
+          set(2),
+          ...field(1, 1),
+          set(3),
+          ...invoke(3, 2),
+          set(4),
+          ...object(4),
+          ...property(4, "done"),
+          call(ctx, "__is_truthy"),
+          when([...markDone(1), ...terminal()]),
+          int(0),
+          ...property(4, "value"),
+          { op: "return" },
+        ],
+        [{ tagIdx, body: [set(5), ...markDone(1), get(5), { op: "throw", tagIdx }] }],
+      ),
+      { op: "unreachable" },
+    ]);
+    emit(CLOSE, [
+      ...cast(2),
+      ...field(2, 2),
+      when([get(1), { op: "return" }]),
+      ...markDone(2),
+      // Param 1 retains the original completion across nested calls. Only the
+      // JS tag is caught; a trap/compiler defect cannot become successful close.
+      buildTargetTaggedTry(
+        ctx,
+        { kind: "empty" },
+        [
+          ...field(2, 0),
+          ...stringConstantExternrefInstrs(ctx, "return"),
+          call(ctx, "__iterator_protocol_get"),
+          set(3),
+          get(3),
+          { op: "ref.is_null" },
+          get(3),
+          call(ctx, "__extern_is_undefined"),
+          { op: "i32.or" },
+          when([get(1), { op: "return" }]),
+          ...callable(3),
+          get(3),
+          ...field(2, 0),
+          call(ctx, "__objvec_new"),
+          call(ctx, "__apply_closure"),
+          // Throw completion wins before validating the return result.
+          { op: "drop" },
+        ],
+        [{ tagIdx, body: [{ op: "drop" }] }],
+      ),
+      get(1),
+    ]);
+    state.phase = "emitted";
+  } catch (error) {
+    // Never reuse a partially registered graph as though emission succeeded.
+    state.phase = "failed";
+    state.error = error;
+    throw error;
+  }
+}
diff --git a/tests/issue-5197-array-length-setter-closure.test.ts b/tests/issue-5197-array-length-setter-closure.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/issue-5197-array-length-setter-closure.test.ts
@@ -0,0 +1,71 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { createHash } from "node:crypto";
+import { runInNewContext } from "node:vm";
+import { expect, it } from "vitest";
+import { compile } from "../src/index.js";
+
+// Reservation/validation probes only: no array literal or element read can
+// incidentally reserve Hole. Runtime mutation is covered by the unchanged six.
+for (const type of ["any", "any[]"]) {
+  it(`setter-only dependency closure (${type})`, async () => {
+    const source = `export function setLength(x: ${type}, key: string, value: number): void { x[key] = value; }`;
+    const receipt = { source, sha256: createHash("sha256").update(source).digest("hex") };
+    try {
+      const result = await compile(source, { target: "standalone", nativeStrings: true });
+      console.log(JSON.stringify({ ...receipt, success: result.success, errors: result.errors }));
+      expect(result.success, JSON.stringify(result.errors)).toBe(true);
+      const module = new WebAssembly.Module(result.binary);
+      const imports = WebAssembly.Module.imports(module);
+      console.log(JSON.stringify({ ...receipt, imports }));
+      expect(imports).toEqual([]);
+      const instance = new WebAssembly.Instance(module, {});
+      expect(typeof instance.exports.setLength).toBe("function");
+    } catch (error) {
+      console.log(JSON.stringify({ ...receipt, failure: String(error) }));
+      throw error;
+    }
+  });
+}
+
+for (const [name, body] of [
+  [
+    "non-writable length",
+    `const a = [1, 2, 3];
+    Object.defineProperty(a, "length", { writable: false });
+    let threw = false;
+    try { Object.defineProperty(a, "length", { value: 1 }); } catch (e) { threw = e instanceof TypeError; }
+    return threw && a.length === 3 && a[2] === 3 ? 1 : -1;`,
+  ],
+  [
+    "non-configurable last index",
+    `const a = [1, 2, 3];
+    Object.defineProperty(a, "2", { configurable: false });
+    let threw = false;
+    try { Object.defineProperty(a, "length", { value: 1 }); } catch (e) { threw = e instanceof TypeError; }
+    return threw && a.length === 3 && a[1] === 2 && a[2] === 3 ? 1 : -1;`,
+  ],
+] as const) {
+  it(`refused descriptor shrink: ${name}`, async () => {
+    const source = `export function test() { ${body} }`;
+    const native = runInNewContext(`"use strict"; (function() { ${body} })()`, {}, { timeout: 5000 });
+    expect(native).toBe(1);
+    const result = await compile(source, { target: "standalone", nativeStrings: true });
+    console.log(
+      JSON.stringify({
+        name,
+        source,
+        sha256: createHash("sha256").update(source).digest("hex"),
+        native,
+        success: result.success,
+        errors: result.errors,
+      }),
+    );
+    expect(result.success).toBe(true);
+    const module = new WebAssembly.Module(result.binary);
+    expect(WebAssembly.Module.imports(module)).toEqual([]);
+    const instance = new WebAssembly.Instance(module, {});
+    const actual = (instance.exports.test as () => number)();
+    console.log(JSON.stringify({ name, actual, native }));
+    expect(actual).toBe(native);
+  });
+}
diff --git a/tests/issue-5883-iterator-protocol-get.test.ts b/tests/issue-5883-iterator-protocol-get.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/issue-5883-iterator-protocol-get.test.ts
@@ -0,0 +1,336 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+// Source-only lane B cases. Execute after the parent installs registration,
+// the final receiver-entry hook, storage prerequisites, and the A/C/drive patches.
+import { describe, expect, it } from "vitest";
+import { compile } from "../src/index.js";
+
+async function run(source: string): Promise<number> {
+  const result = await compile(`declare function __drain_microtasks(): void;\n${source}`, {
+    fileName: "issue-5883-iterator-protocol-get.ts",
+    target: "standalone",
+    nativeStrings: true,
+    deferTopLevelInit: true,
+    emitWat: true,
+  });
+  if (!result.success) throw new Error(result.errors.map((error) => error.message).join("\n"));
+  // These cases must reach the real production Get, not a test export or a
+  // legacy iterator cache. Keep failures as failures, never expected-fail rows.
+  expect(result.wat).toContain("__iterator_protocol_get");
+  const module = await WebAssembly.compile(result.binary);
+  expect(WebAssembly.Module.imports(module)).toEqual([]);
+  const instance = await WebAssembly.instantiate(module, {});
+  const exports = instance.exports as { __module_init(): void; test(): number };
+  exports.__module_init();
+  return exports.test();
+}
+
+const observable = `
+var intrinsicResolve: any = Promise.resolve;
+(Promise as any).resolve = function(value: any): any {
+  return intrinsicResolve.call(Promise, value);
+};
+`;
+
+for (const combinator of ["all", "race"] as const) {
+  describe(`captured ${combinator}: semantic protocol Get`, () => {
+    it("own undefined is a hit and the genuine symbol differs from its textual spelling", async () => {
+      expect(
+        await run(`${observable}
+export function test(): number {
+  var source: any[] = [1 as any];
+  var gets = 0, inherited = 0, rejected = 0;
+  Object.defineProperty(Array.prototype, Symbol.iterator, {
+    configurable: true, get: function(): any { inherited++; return function(): any { return {}; }; }
+  });
+  Object.defineProperty(source, Symbol.iterator, {
+    configurable: true, get: function(): any { gets += this === source ? 1 : 100; return undefined; }
+  });
+  source["Symbol.iterator"] = function(): any { inherited += 100; return {}; };
+  Promise.${combinator}(source).then(function(): void { rejected = 100; },
+    function(error: any): void { rejected = error instanceof TypeError ? 1 : 100; });
+  __drain_microtasks();
+  return gets === 1 && inherited === 0 && rejected === 1 ? 1 : 0;
+}`),
+      ).toBe(1);
+    });
+
+    it("captures an inherited next getter once with the actual iterator receiver", async () => {
+      expect(
+        await run(`${observable}
+export function test(): number {
+  var gets = 0, calls = 0, bad = 0;
+  var iterator: any = Object.create({});
+  Object.defineProperty(Object.getPrototypeOf(iterator), "next", {
+    configurable: true, get: function(): any {
+      gets++; if (this !== iterator) bad++;
+      return function(): any {
+        if (this !== iterator || arguments.length !== 0) bad++;
+        calls++;
+        Object.defineProperty(iterator, "next", { configurable: true, get: function(): any { bad++; throw 17; } });
+        return { done: calls > 1, value: 9 };
+      };
+    }
+  });
+  var source: any[] = [1 as any];
+  Object.defineProperty(source, Symbol.iterator, { value: function(): any { return iterator; } });
+  Promise.${combinator}(source);
+  return gets === 1 && calls === 2 && bad === 0 ? 1 : 0;
+}`),
+      ).toBe(1);
+    });
+
+    it("keeps values and Symbol.iterator independent after assignment and deletion", async () => {
+      expect(
+        await run(`${observable}
+export function test(): number {
+  var source: any[] = [1 as any];
+  var iteratorCalls = 0, valuesCalls = 0;
+  Array.prototype.values = function(): any { valuesCalls++; return { next: function(): any { return { done: true }; } }; };
+  Array.prototype[Symbol.iterator] = function(): any {
+    iteratorCalls++;
+    return { next: function(): any { return { done: true }; } };
+  };
+  delete Array.prototype.values;
+  Promise.${combinator}(source);
+  return iteratorCalls === 1 && valuesCalls === 0 ? 1 : 0;
+}`),
+      ).toBe(1);
+    });
+
+    it("retains top-level writes before and after acquisition in source order", async () => {
+      expect(
+        await run(`${observable}
+var source: any[] = [1 as any];
+var first = 0, second = 0;
+Array.prototype[Symbol.iterator] = function(): any {
+  first++; return { next: function(): any { return { done: true }; } };
+};
+Promise.${combinator}(source);
+var replacement: any = function(): any {
+  second++; return { next: function(): any { return { done: true }; } };
+};
+Array.prototype[Symbol.iterator] = replacement;
+Promise.${combinator}(source);
+export function test(): number { return first === 1 && second === 1 ? 1 : 0; }
+`),
+      ).toBe(1);
+    });
+
+    it("a deleted prototype method continues to the parent without reviving a cached assignment", async () => {
+      expect(
+        await run(`${observable}
+export function test(): number {
+  var source: any[] = [1 as any];
+  var old = 0, inherited = 0, bad = 0;
+  Array.prototype[Symbol.iterator] = function(): any { old++; return {}; };
+  Object.defineProperty(Object.prototype, Symbol.iterator, { configurable: true, get: function(): any {
+    inherited++; if (this !== source) bad++;
+    return function(): any { return { next: function(): any { return { done: true }; } }; };
+  } });
+  delete Array.prototype[Symbol.iterator];
+  Promise.${combinator}(source);
+  return old === 0 && inherited === 1 && bad === 0 ? 1 : 0;
+}`),
+      ).toBe(1);
+    });
+
+    it("IterRec prototype getters retain this across nested and throwing Reflect.get", async () => {
+      expect(
+        await run(`${observable}
+export function test(): number {
+  var source: any[] = [1 as any];
+  var iterator: any = source.values();
+  var proto: any = Object.getPrototypeOf(iterator);
+  var next: any = iterator.next;
+  var count = 0, bad = 0;
+  Object.defineProperty(proto, "next", { configurable: true, get: function(): any {
+    count++; if (this !== iterator) bad++;
+    var inner: any = { marker: 7 };
+    var throwing: any = {};
+    Object.defineProperty(throwing, "x", { get: function(): any { if (this !== inner) bad++; throw 31; } });
+    try { Reflect.get(throwing, "x", inner); } catch (error) { if (error !== 31) bad++; }
+    var ordinary: any = {};
+    Object.defineProperty(ordinary, "x", { get: function(): any { if (this !== ordinary) bad++; return 1; } });
+    if (ordinary.x !== 1) bad++;
+    if (this !== iterator) bad++;
+    return next;
+  } });
+  Object.defineProperty(source, Symbol.iterator, { value: function(): any { return iterator; } });
+  Promise.${combinator}(source);
+  return count === 1 && bad === 0 ? 1 : 0;
+}`),
+      ).toBe(1);
+    });
+
+    it("proxy Get traps receive the actual iterator and next is captured once", async () => {
+      expect(
+        await run(`${observable}
+export function test(): number {
+  var reads = 0, calls = 0, bad = 0;
+  var target: any = { next: function(): any {
+    if (this !== iterator || arguments.length !== 0) bad++;
+    calls++; return { done: calls > 1, value: 9 };
+  } };
+  var iterator: any = new Proxy(target, { get: function(t: any, key: any, receiver: any): any {
+    if (receiver !== iterator || t !== target) bad++;
+    if (key === "next") reads++;
+    return Reflect.get(t, key, receiver);
+  } });
+  var source: any[] = [1 as any];
+  Object.defineProperty(source, Symbol.iterator, { value: function(): any { return iterator; } });
+  Promise.${combinator}(source);
+  return reads === 1 && calls === 2 && bad === 0 ? 1 : 0;
+}`),
+      ).toBe(1);
+    });
+
+    it("own undefined next on IterRec rejects instead of selecting the intrinsic", async () => {
+      expect(
+        await run(`${observable}
+export function test(): number {
+  var source: any[] = [1 as any];
+  var iterator: any = source.values();
+  var rejected = 0;
+  Object.defineProperty(iterator, "next", { configurable: true, value: undefined });
+  Object.defineProperty(source, Symbol.iterator, { value: function(): any { return iterator; } });
+  Promise.${combinator}(source).then(function(): void { rejected = 100; },
+    function(error: any): void { rejected = error instanceof TypeError ? 1 : 100; });
+  __drain_microtasks();
+  return rejected;
+}`),
+      ).toBe(1);
+    });
+
+    for (const throwing of [false, true]) {
+      it(`own IterRec next accessor ${throwing ? "throws" : "returns undefined"} without inherited fallback`, async () => {
+        expect(
+          await run(`${observable}
+export function test(): number {
+  var source: any[] = [1 as any], iterator: any = source.values();
+  var error: any = {}, gets = 0, inherited = 0, closes = 0, rejected = 0;
+  Object.defineProperty(Object.getPrototypeOf(iterator), "next", {
+    configurable: true, get: function(): any { inherited++; throw 99; }
+  });
+  Object.defineProperty(iterator, "next", { configurable: true, get: function(): any {
+    gets += this === iterator ? 1 : 100;
+    ${throwing ? "throw error;" : "return undefined;"}
+  } });
+  Object.defineProperty(iterator, "return", { get: function(): any { closes++; throw 98; } });
