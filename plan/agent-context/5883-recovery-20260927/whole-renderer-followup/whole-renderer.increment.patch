+/** Closed-data whole captured drive. No codegen context, allocator or provider imports. */
+import type { Instr, ValType } from "../ir/types.js";
+import { buildTargetTaggedTry } from "../ir/try-table.js";
+import type {
+  AuthorizedCapturedChild, AuthorizedCapturedRender, CapturedRenderOutput,
+  FrameLocalBinding, OwnedCapturedChild,
+} from "./staging-bindings.js";
+
+export interface CapturedLocal {
+  readonly binding: FrameLocalBinding;
+  /** Actual allocator assignment at preparation; no remap may intervene in R. */
+  readonly index: number;
+  readonly type: ValType;
+}
+export interface CapturedOperand {
+  readonly owned: OwnedCapturedChild;
+}
+export interface CapturedDriveLocals {
+  arg: CapturedLocal; iter: CapturedLocal; done: CapturedLocal; value: CapturedLocal;
+  index: CapturedLocal; state: CapturedLocal; exn: CapturedLocal;
+}
+export interface CapturedPrologueLocals {
+  result: CapturedLocal; ctor: CapturedLocal; resolve: CapturedLocal; aborted: CapturedLocal;
+  reason: CapturedLocal; callable: CapturedLocal; callableAny: CapturedLocal; reject: CapturedLocal;
+}
+export interface CapturedElementLocals {
+  input: CapturedLocal; resolveArgs: CapturedLocal; thenArgs: CapturedLocal; next: CapturedLocal;
+  error: CapturedLocal; then: CapturedLocal; callable: CapturedLocal;
+  callableAny: CapturedLocal; nextAny: CapturedLocal;
+}
+export interface CapturedPrologueOperands {
+  capability: CapturedOperand; rejectClosure: CapturedOperand; constructor: CapturedOperand;
+  resolveKey: CapturedOperand; getResolve: CapturedOperand; rejectGet: CapturedOperand;
+  resolveError: CapturedOperand; newResolveError: CapturedOperand; rejectNonCallable: CapturedOperand;
+}
+export interface CapturedElementOperands {
+  resolveArgsNew: CapturedOperand; resolveArgsPush: CapturedOperand;
+  thenArgsNew: CapturedOperand; thenArgsPushFulfill: CapturedOperand; thenArgsPushReject: CapturedOperand;
+  applyResolve: CapturedOperand; thenKey: CapturedOperand; getThen: CapturedOperand;
+  isCallable: CapturedOperand; applyThen: CapturedOperand;
+  thenError: CapturedOperand; newThenError: CapturedOperand;
+}
+export interface CapturedControlOperands {
+  acquire: CapturedOperand; rejectAcquire: CapturedOperand; step: CapturedOperand;
+  rejectStep: CapturedOperand; close: CapturedOperand; rejectClose: CapturedOperand;
+}
+interface PreparedCommon {
+  readonly source: CapturedLocal;
+  readonly drive: CapturedDriveLocals;
+  readonly prologue: CapturedPrologueLocals;
+  readonly element: CapturedElementLocals;
+  readonly prologueOperands: CapturedPrologueOperands;
+  readonly elementOperands: CapturedElementOperands;
+  readonly control: CapturedControlOperands;
+  readonly target: { readonly standalone: boolean; readonly wasi: boolean };
+  readonly tagIdx: number;
+  readonly observableTagIdx: number;
+  readonly arrayTypeIdx: number;
+  readonly vecTypeIdx: number;
+  readonly stateTypeIdx: number;
+  readonly resolveCallableTypes: readonly number[];
+}
+export type PreparedCapturedDriveRender =
+  | (PreparedCommon & { readonly method: "all"; readonly all: {
+      readonly grown: CapturedLocal; readonly elementCaps: CapturedLocal; readonly remaining: CapturedLocal;
+      readonly elementCapsTypeIdx: number; readonly resolveClosure: CapturedOperand;
+      readonly completeFulfill: CapturedOperand;
+    } })
