+    ] });
+  }
+  body.push(get(P.result), { op: "extern.convert_any" });
+  // Some small temporary lists above were spread into final lists. Resolve
+  // placements against actual output arrays, using ORIGINAL instruction identity.
+  // No child is cloned or consumed here; owner independently preflights this claim.
+  const childPlacements = locatePlacements(body, placements.map((entry) => entry.child));
+  return { authorization: r.authorization, instructions: body, childPlacements, result: [{ kind: "externref" }] };
+}
+
+function appendSlot(body: Instr[], p: PreparedCapturedDriveRender, L: Indices<CapturedDriveLocals>, grown: number): void {
+  const get = (index: number): Instr => ({ op: "local.get", index });
+  body.push(get(L.index), get(L.state), { op: "struct.get", typeIdx: p.stateTypeIdx, fieldIdx: 1 },
+    { op: "array.len" }, { op: "i32.ge_u" }, { op: "if", blockType: { kind: "empty" }, then: [
+      get(L.index), { op: "i32.const", value: 1 }, { op: "i32.add" }, { op: "i32.const", value: 2 },
+      { op: "i32.mul" }, { op: "array.new_default", typeIdx: p.arrayTypeIdx }, { op: "local.set", index: grown },
+      get(grown), { op: "i32.const", value: 0 }, get(L.state), { op: "struct.get", typeIdx: p.stateTypeIdx, fieldIdx: 1 },
+      { op: "i32.const", value: 0 }, get(L.state), { op: "struct.get", typeIdx: p.stateTypeIdx, fieldIdx: 1 },
+      { op: "array.len" }, { op: "array.copy", dstTypeIdx: p.arrayTypeIdx, srcTypeIdx: p.arrayTypeIdx },
+      get(L.state), get(grown), { op: "ref.as_non_null" }, { op: "struct.set", typeIdx: p.stateTypeIdx, fieldIdx: 1 },
+    ] }, get(L.state), get(L.index), { op: "i32.const", value: 1 }, { op: "i32.add" },
+    { op: "struct.set", typeIdx: p.stateTypeIdx, fieldIdx: 2 });
+}
+
+function locatePlacements(root: Instr[], expected: readonly AuthorizedCapturedChild[]): CapturedRenderOutput["childPlacements"] {
+  const arrays: Instr[][] = [];
+  const visit = (body: Instr[]): void => {
+    arrays.push(body);
+    for (const i of body) {
+      if (i.op === "block" || i.op === "loop" || i.op === "try_table") visit(i.body);
+      else if (i.op === "if") { visit(i.then); if (i.else) visit(i.else); }
+      else if (i.op === "try") { visit(i.body); for (const c of i.catches ?? []) visit(c.body); if (i.catchAll) visit(i.catchAll); }
+    }
+  };
+  visit(root);
+  return expected.map((child) => {
+    const found: Array<{ child: AuthorizedCapturedChild; destination: Instr[]; start: number }> = [];
+    for (const destination of arrays) for (let start = 0; start < destination.length; start++)
+      if (child.instructions.every((instruction, index) => destination[start + index] === instruction))
+        found.push({ child, destination, start });
+    if (found.length !== 1) throw new Error("Captured renderer child placement is not unique");
+    return found[0]!;
+  });
+}
