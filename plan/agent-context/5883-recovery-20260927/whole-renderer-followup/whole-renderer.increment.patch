+    rejected(f, () => attachRenderedCapturedDrive(f.owner, { ...p.output, instructions: cycle }));
+    const instructions: Instr[] = [{ op: "try", blockType: { kind: "empty" }, body: [],
+      catches: [], catchAll: p.output.instructions }];
+    attachRenderedCapturedDrive(f.owner, { ...p.output, instructions });
+  });
+  it("rejects output aliasing the already existing destination", () => {
+    const f = fixture(); abortCapturedFrame(f.owner);
+    const old: Instr = { op: "nop" }; f.destination.push(old);
+    const owner = beginCapturedFrame(f.ctx, f.fctx, "all", 0), g = { ...f, owner }, p = prepared(g);
+    const instructions = [...p.output.instructions, old];
+    rejected(g, () => attachRenderedCapturedDrive(owner, { ...p.output, instructions,
+      childPlacements: [{ child: p.view, destination: instructions, start: 0 }] }));
+    attachRenderedCapturedDrive(owner, p.output);
+  });
+  it("post-authorization scalar changes refuse transfer instead of silently refreshing", () => {
+    const f = fixture();
+    const call: Instr = { op: "call", funcIdx: 0 };
+    child(f, [call]);
+    const authorization = authorizeCapturedRender(f.owner), view = authorization.children[0]!;
+    const instructions = [...view.instructions];
+    const output: CapturedRenderOutput = { authorization, instructions,
+      childPlacements: [{ child: view, destination: instructions, start: 0 }], result: [{ kind: "externref" }] };
+    call.funcIdx = 1;
+    rejected(f, () => attachRenderedCapturedDrive(f.owner, output));
+    abortCapturedFrame(f.owner);
+    expect(() => abortCapturedFrame(f.owner)).not.toThrow();
+  });
+  it.each([-1, 0.5, 1])("rejects absent/noninteger source %s before root registration", (index) => {
+    const f = fixture(); abortCapturedFrame(f.owner);
+    rejected(f, () => beginCapturedFrame(f.ctx, f.fctx, "all", index));
+  });
+  it("rejects a non-externref source declaration", () => {
+    const f = fixture(); abortCapturedFrame(f.owner);
+    f.fctx.locals[0]!.type = { kind: "i32" };
+    rejected(f, () => beginCapturedFrame(f.ctx, f.fctx, "all", 0));
+  });
+  it("rejects shared empty nested arrays independently of instruction aliases", () => {
+    const f = fixture(), p = prepared(f), empty: Instr[] = [];
+    const instructions: Instr[] = [...p.output.instructions,
+      { op: "block", blockType: { kind: "empty" }, body: empty },
+      { op: "block", blockType: { kind: "empty" }, body: empty }];
+    rejected(f, () => attachRenderedCapturedDrive(f.owner, { ...p.output, instructions,
+      childPlacements: [{ child: p.view, destination: instructions, start: 0 }] }));
+    attachRenderedCapturedDrive(f.owner, p.output);
+  });
+  it("a lost retained root rejects authorization before closing preparation", () => {
+    const f = fixture(), c = child(f);
+    f.liveBodies.delete(c.emission.body);
+    rejected(f, () => authorizeCapturedRender(f.owner));
+    f.liveBodies.add(c.emission.body);
+    authorizeCapturedRender(f.owner);
+    abortCapturedFrame(f.owner);
+  });
+});
+
+// Additive Hume-review controls; the original 38 cases above remain unchanged.
+function outputForChildren(f: ReturnType<typeof fixture>): CapturedRenderOutput {
+  const authorization = authorizeCapturedRender(f.owner);
+  const instructions: Instr[] = [];
+  const childPlacements = authorization.children.map((view) => {
+    const start = instructions.length;
+    instructions.push(...view.instructions);
+    return { child: view, destination: instructions, start };
+  });
+  return { authorization, instructions, childPlacements, result: [{ kind: "externref" }] };
+}
+function structuredChild(f: ReturnType<typeof fixture>) {
+  const block: Extract<Instr, { op: "block" }> = {
+    op: "block", blockType: { kind: "val", type: { kind: "externref" } }, body: [{ op: "nop" }],
+  };
+  const tagged: Extract<Instr, { op: "try" }> = {
+    op: "try", blockType: { kind: "empty" }, body: [], catches: [{ tagIdx: 2, body: [{ op: "nop" }] }],
+  };
+  const table: Extract<Instr, { op: "try_table" }> = {
+    op: "try_table", blockType: { kind: "empty" }, body: [], catches: [{ kind: "catch", tagIdx: 3, depth: 0 }],
+  };
+  const branch: Extract<Instr, { op: "br_table" }> = { op: "br_table", targets: [0, 1], defaultDepth: 2 };
+  child(f, [block, tagged, table, branch]);
+  return { block, tagged, table, branch };
+}
+describe("R lexical adapter review corrections (source-only until next grant)", () => {
+  it("accepts unchanged structured operands and preserves executable identities", () => {
+    const f = fixture(), s = structuredChild(f), output = outputForChildren(f);
+    const catchBody = s.tagged.catches[0]!.body;
+    attachRenderedCapturedDrive(f.owner, output);
+    expect(f.destination[0]).toBe(s.block);
+    expect(f.destination[1]).toBe(s.tagged);
+    expect(s.tagged.catches[0]!.body).toBe(catchBody);
+    expect(f.destination[2]).toBe(s.table);
+  });
+  it.each(["block", "nested-type", "catch-tag", "table-tag", "table-kind", "table-depth", "branch-target"] as const)(
+    "rejects changed %s data before transfer, then accepts restoration", (kind) => {
+      const f = fixture(), s = structuredChild(f), output = outputForChildren(f);
+      const blockType = s.block.blockType;
+      if (blockType.kind !== "val") throw new Error("fixture");
+      const valueType = blockType.type;
+      if (kind === "block") s.block.blockType = { kind: "empty" };
+      if (kind === "nested-type") blockType.type = { kind: "i32" };
+      if (kind === "catch-tag") s.tagged.catches[0]!.tagIdx = 5;
+      if (kind === "table-tag") s.table.catches[0]!.tagIdx = 5;
+      if (kind === "table-kind") s.table.catches[0]!.kind = "catch_ref";
+      if (kind === "table-depth") s.table.catches[0]!.depth = 1;
+      if (kind === "branch-target") s.branch.targets[0] = 2;
+      rejected(f, () => attachRenderedCapturedDrive(f.owner, output));
+      s.block.blockType = blockType;
+      blockType.type = valueType;
+      s.tagged.catches[0]!.tagIdx = 2;
+      s.table.catches[0]!.tagIdx = 3;
+      s.table.catches[0]!.kind = "catch";
+      s.table.catches[0]!.depth = 0;
+      s.branch.targets[0] = 0;
+      attachRenderedCapturedDrive(f.owner, output);
+      expect(f.destination[0]).toBe(s.block);
+    },
+  );
+  it.each([NaN, -0])("accepts an unchanged f64 scalar %s", (value) => {
+    const f = fixture(), instruction: Instr = { op: "f64.const", value };
+    child(f, [instruction]);
+    attachRenderedCapturedDrive(f.owner, outputForChildren(f));
+    expect(f.destination[0]).toBe(instruction);
+    expect(Object.is(instruction.value, value)).toBe(true);
+  });
+  it("rejects negative-to-positive-zero drift and accepts restored negative zero", () => {
+    const f = fixture(), instruction: Instr = { op: "f64.const", value: -0 };
+    child(f, [instruction]);
+    const output = outputForChildren(f);
+    instruction.value = +0;
+    rejected(f, () => attachRenderedCapturedDrive(f.owner, output));
+    instruction.value = -0;
+    attachRenderedCapturedDrive(f.owner, output);
+    expect(Object.is(instruction.value, -0)).toBe(true);
+  });
+  it.each(["retained", "unentered"] as const)("outer abort revokes %s descendant, preserving sibling and borrowed root", (state) => {
+    const f = fixture();
+    abortCapturedFrame(f.owner);
+    f.liveBodies.add(f.destination);
+    const g = { ...f, owner: beginCapturedFrame(f.ctx, f.fctx, "all", 0) };
+    const sibling = child(g);
+    const outer = enterRetainedChild(g.ctx, g.fctx, beginRetainedChild(g.owner, []));
+    const inner = beginRetainedChild(g.owner, []);
+    if (state === "retained") {
+      const emission = enterRetainedChild(g.ctx, g.fctx, inner);
+      emission.body.push({ op: "nop" });
+      finishRetainedChild(emission);
+    }
+    abortRetainedChild(outer);
+    expect(g.fctx.body).toBe(g.destination);
+    expect([...g.liveBodies]).toEqual([g.destination, sibling.emission.body]);
+    rejected(g, () => enterRetainedChild(g.ctx, g.fctx, inner));
+    const output = outputForChildren(g);
+    expect(output.authorization.children.map((c) => c.identity)).toEqual([sibling.owned]);
+    attachRenderedCapturedDrive(g.owner, output);
+    expect([...g.liveBodies]).toEqual([g.destination]);
+  });
+  it("outer abort revokes grandchildren even after their parent has finished", () => {
+    const f = fixture();
+    const outer = enterRetainedChild(f.ctx, f.fctx, beginRetainedChild(f.owner, []));
+    const middle = enterRetainedChild(f.ctx, f.fctx, beginRetainedChild(f.owner, []));
+    const grandchild = beginRetainedChild(f.owner, []);
+    finishRetainedChild(middle);
+    abortRetainedChild(outer);
+    expect([...f.liveBodies]).toEqual([f.destination]);
+    rejected(f, () => enterRetainedChild(f.ctx, f.fctx, grandchild));
+    expect(authorizeCapturedRender(f.owner).children).toEqual([]);
+    abortCapturedFrame(f.owner);
+  });
+  it("does not reuse failed-region bindings after actual caller-owned rollback and slot reuse", () => {
+    const f = fixture(), snap = snapshotLocals(f.fctx);
+    const outer = enterRetainedChild(f.ctx, f.fctx, beginRetainedChild(f.owner, []));
+    const binding = allocateCapturedLocal(f.owner, "failed", { kind: "externref" });
+    const declaration = f.fctx.locals[1];
+    abortRetainedChild(outer);
+    expect(f.fctx.locals[1]).toBe(declaration); // Adapter did not roll back locals.
+    restoreLocals(f.fctx, snap);
+    allocLocal(f.fctx, "replacement", { kind: "externref" });
+    expect(f.fctx.locals[1]).not.toBe(declaration);
+    rejected(f, () => authorizeCapturedRender(f.owner));
+    abortCapturedFrame(f.owner);
+    const owner = beginCapturedFrame(f.ctx, f.fctx, "all", 0);
+    expect(authorizeCapturedRender(owner).locals[1]!.binding).not.toBe(binding);
+    abortCapturedFrame(owner);
+  });
+  it.each([false, true])("frame abort restores replaced cursor with borrowed destination=%s and no open child", (borrowed) => {
+    const f = fixture(); abortCapturedFrame(f.owner);
+    const prefix: Instr = { op: "nop" };
+    f.destination.push(prefix);
+    if (borrowed) f.liveBodies.add(f.destination);
+    const g = { ...f, owner: beginCapturedFrame(f.ctx, f.fctx, "all", 0) };
+    const p = prepared(g), replacement: Instr[] = [{ op: "nop" }];
+    f.fctx.body = replacement;
+    rejected(g, () => attachRenderedCapturedDrive(g.owner, p.output));
+    abortCapturedFrame(g.owner);
+    expect(f.fctx.body).toBe(f.destination);
+    expect(f.destination).toEqual([prefix]);
+    expect(f.destination[0]).toBe(prefix);
+    expect([...f.liveBodies]).toEqual(borrowed ? [f.destination] : []);
+    expect(replacement).toHaveLength(1);
+    expect(() => abortCapturedFrame(g.owner)).not.toThrow();
+    expect(f.fctx.body).toBe(f.destination);
+  });
+});
