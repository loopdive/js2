+/** Real allocation at the historical checkpoint; use the allocator's own map. */
+export function allocateCapturedRole(
+  fctx: FunctionContext, owner: CapturedFrameConstruction, prefix: string, type: ValType,
+): CapturedLocal {
+  const name = `${prefix}_${fctx.locals.length}`;
+  const binding = allocateCapturedLocal(owner, name, type);
+  const index = fctx.localMap.get(name);
+  if (index === undefined) throw new Error("Captured allocator did not publish its local declaration");
+  return { binding, index, type };
+}
+
+/** Own final operand fragments, never an old whole-drive warmup. */
+export function retainCapturedOperands(
+  ctx: CodegenContext, fctx: FunctionContext, owner: CapturedFrameConstruction,
+  result: readonly ValType[], instructions: Instr[],
+): CapturedOperand {
+  const emission = enterRetainedChild(ctx, fctx, beginRetainedChild(owner, result));
+  try {
+    emission.body.push(...instructions);
+    const owned = finishRetainedChild(emission);
+    return { owned };
+  } catch (error) {
+    try { abortRetainedChild(emission); } catch { /* preserve original construction error */ }
+    throw error;
+  }
+}
+
+/** Retain the exact historical operand; diagnostics must not narrow admission. */
+export function retainCapturedCall(
+  ctx: CodegenContext, fctx: FunctionContext, owner: CapturedFrameConstruction,
+  funcIdx: number, results: readonly ValType[],
+): CapturedOperand {
+  return retainCapturedOperands(ctx, fctx, owner, results, [{ op: "call", funcIdx }]);
+}
