+      throw new Error("Child is not at its declared physical placement");
+    placed.add(placement.child);
+  }
+  for (const child of f.children.filter((c) => c.state === "retained")) checkChild(child, f.declarations.length);
+  for (const [instruction, operands] of f.renderOperands!) {
+    if (!matchesOperand(instruction, operands))
+      throw new Error("Retained operand changed after authorization");
+  }
+  // All ordinary validation precedes the sole transfer. No callbacks/ensures or copying of leaves.
+  for (const instruction of output.instructions) f.destination.push(instruction);
+  f.state = "attached";
