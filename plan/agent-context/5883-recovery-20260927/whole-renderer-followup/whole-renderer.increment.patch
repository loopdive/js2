+      readonly fulfill: CapturedLocal; readonly fulfillClosure: CapturedOperand;
+    } });
+
+type Indices<T> = { readonly [K in keyof T]: number };
+type Children<T> = { readonly [K in keyof T]: AuthorizedCapturedChild };
+interface ResolvedCommon {
+  readonly authorization: AuthorizedCapturedRender;
+  readonly source: number;
+  readonly drive: Indices<CapturedDriveLocals>;
+  readonly prologue: Indices<CapturedPrologueLocals>;
+  readonly element: Indices<CapturedElementLocals>;
+  readonly prologueOperands: Children<CapturedPrologueOperands>;
+  readonly elementOperands: Children<CapturedElementOperands>;
+  readonly control: Children<CapturedControlOperands>;
+}
+export type ResolvedCapturedDriveBindings =
