+}
+export interface CapturedRenderOutput {
+  readonly authorization: AuthorizedCapturedRender;
+  readonly instructions: Instr[];
+  readonly childPlacements: readonly {
+    readonly child: AuthorizedCapturedChild;
+    readonly destination: readonly Instr[];
+    readonly start: number;
+  }[];
+  readonly result: readonly [{ readonly kind: "externref" }];
+}
+type Declaration = FunctionContext["params"][number];
+interface LocalRecord {
+  declaration: Declaration;
