+    [key, snapshotOperand(entry, childArrays, active)] as const);
+  active.delete(value);
+  return { kind: "record", arrayLength: Array.isArray(value) ? value.length : undefined, entries };
+}
+function matchesOperand(value: unknown, saved: OperandSnapshot): boolean {
+  if (saved.kind === "identity") return Object.is(value, saved.value);
+  if (value === null || typeof value !== "object" ||
+      Array.isArray(value) !== (saved.arrayLength !== undefined) ||
+      (Array.isArray(value) && value.length !== saved.arrayLength)) return false;
+  const keys = Object.keys(value);
+  return keys.length === saved.entries.length && saved.entries.every(([key, entry]) =>
+    Object.hasOwn(value, key) && matchesOperand(Reflect.get(value, key), entry));
+}
+// Lexical capabilities only; neither an ownership graph nor a compiler-index map.
+const frames = new WeakMap<CapturedFrameConstruction, Frame>();
+const activeFrames = new WeakMap<FunctionContext, Frame>();
+const constructions = new WeakMap<AuthenticatedChildConstruction, Child>();
+const emissions = new WeakMap<RetainedChildEmission, Child>();
+function handle<K extends string>(kind: K): Handle<K> {
+  return Object.freeze({ kind }) as Handle<K>;
+}
+function copyType(type: ValType): ValType {
+  return Object.freeze({ ...type });
+}
+function sameType(a: ValType, b: ValType): boolean {
+  return Object.keys(a).length === Object.keys(b).length &&
+    Object.entries(a).every(([key, value]) => Reflect.get(b, key) === value);
+}
+function sameItems<T>(a: readonly T[], b: readonly T[]): boolean {
+  return a.length === b.length && a.every((x, i) => x === b[i]);
+}
+function liveFrame(owner: CapturedFrameConstruction, preparing = false): Frame {
+  const f = frames.get(owner);
+  if (!f || activeFrames.get(f.fctx) !== f || f.state === "attached" || f.state === "revoked")
