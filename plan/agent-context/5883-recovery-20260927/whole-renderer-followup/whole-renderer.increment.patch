+    name: "R", params: [], locals: [{ name: "source", type: { kind: "externref" } }],
+    localMap: new Map([["source", 0]]), returnType: { kind: "externref" }, body: [],
+    blockDepth: 0, breakStack: [], continueStack: [], labelMap: new Map(), savedBodies: [],
+  };
