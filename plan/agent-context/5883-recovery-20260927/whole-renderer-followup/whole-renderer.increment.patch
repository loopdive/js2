+  const view = authorization.children[0]!;
+  const instructions = [...view.instructions];
+  const output: CapturedRenderOutput = {
+    authorization, instructions, childPlacements: [{ child: view, destination: instructions, start: 0 }],
+    result: [{ kind: "externref" }],
+  };
+  return { c, authorization, view, output };
