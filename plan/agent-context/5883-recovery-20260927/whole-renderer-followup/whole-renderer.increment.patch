+      { op: "struct.get", typeIdx: p.stateTypeIdx, fieldIdx: 2 }, get(L.state),
+      { op: "struct.get", typeIdx: p.stateTypeIdx, fieldIdx: 1 },
+      { op: "struct.new", typeIdx: p.vecTypeIdx }, { op: "extern.convert_any" }];
+    put(fulfill, r.all.completeFulfill);
+    fulfill.push({ op: "drop" });
+    body.push(get(P.aborted), { op: "i32.eqz" }, { op: "if", blockType: { kind: "empty" }, then: [
+      get(L.state), get(L.state), { op: "struct.get", typeIdx: p.stateTypeIdx, fieldIdx: 3 },
+      c(1), { op: "i32.sub" }, { op: "local.tee", index: r.all.remaining },
+      { op: "struct.set", typeIdx: p.stateTypeIdx, fieldIdx: 3 }, get(r.all.remaining),
