+    { op: "if", blockType: { kind: "empty" }, then: [c(1), set(P.callable)] },
+  );
+  const badResolve: Instr[] = [get(P.result)];
+  put(badResolve, r.prologueOperands.resolveError);
+  put(badResolve, r.prologueOperands.newResolveError);
+  put(badResolve, r.prologueOperands.rejectNonCallable);
+  badResolve.push({ op: "drop" }, c(1), set(P.aborted));
+  body.push(get(P.aborted), { op: "i32.eqz" }, { op: "if", blockType: { kind: "empty" }, then: [
+    c(0), set(P.callable), get(P.resolve), { op: "ref.is_null" },
+    { op: "if", blockType: { kind: "empty" }, then: [], else: [
+      get(P.resolve), { op: "any.convert_extern" }, set(P.callableAny), ...callableArms,
+    ] },
+    get(P.callable), { op: "i32.eqz" }, { op: "if", blockType: { kind: "empty" }, then: badResolve },
+  ] });
+  const acquire: Instr[] = [get(L.arg)];
+  put(acquire, r.control.acquire);
+  acquire.push(set(L.iter), c(0), set(L.done));
+  body.push(c(1), set(L.done), get(P.aborted), { op: "i32.eqz" }, {
+    op: "if", blockType: { kind: "empty" }, then: [tagged(acquire, caught(L.exn, r.control.rejectAcquire), p.tagIdx)],
+  });
+  body.push(c(0), set(L.index), get(P.result), c(0), { op: "array.new_default", typeIdx: p.arrayTypeIdx },
+    c(0), c(p.method === "all" ? 1 : 0), { op: "struct.new", typeIdx: p.stateTypeIdx }, set(L.state));
+  const step: Instr[] = [get(L.iter)];
+  put(step, r.control.step);
+  step.push(set(L.value), set(L.done));
+  const loop: Instr[] = [
+    get(P.aborted), { op: "br_if", depth: 1 }, get(L.done), { op: "br_if", depth: 1 }, c(1), set(L.done),
+    tagged(step, caught(L.exn, r.control.rejectStep), p.tagIdx),
+    get(P.aborted), { op: "br_if", depth: 1 }, get(L.done), { op: "br_if", depth: 1 },
+  ];
+  if (r.method === "all") appendSlot(loop, p, L, r.all.grown);
+  loop.push(get(L.value), set(E.input));
+  const saveThrow = (): Instr[] => [set(E.error), get(E.error), set(L.exn), c(1), set(P.aborted)];
+  const normalize: Instr[] = [];
+  put(normalize, r.elementOperands.resolveArgsNew);
+  normalize.push(set(E.resolveArgs), get(E.resolveArgs), get(E.input));
+  put(normalize, r.elementOperands.resolveArgsPush);
+  put(normalize, r.elementOperands.thenArgsNew);
+  normalize.push(set(E.thenArgs), get(E.thenArgs));
+  if (r.method === "all" && p.method === "all") {
+    normalize.push(get(L.state), get(L.index), { op: "struct.new", typeIdx: p.all.elementCapsTypeIdx }, set(r.all.elementCaps));
+    put(normalize, r.all.resolveClosure);
+  } else if (r.method === "race") normalize.push(get(r.race.fulfill));
+  put(normalize, r.elementOperands.thenArgsPushFulfill);
+  normalize.push(get(E.thenArgs), get(P.reject));
+  put(normalize, r.elementOperands.thenArgsPushReject);
+  normalize.push(get(P.resolve), get(P.ctor), get(E.resolveArgs));
+  put(normalize, r.elementOperands.applyResolve);
+  normalize.push(set(E.next));
+  const invoke: Instr[] = [get(E.next)];
+  put(invoke, r.elementOperands.thenKey);
+  put(invoke, r.elementOperands.getThen);
+  invoke.push(set(E.then), get(E.then));
+  put(invoke, r.elementOperands.isCallable);
+  invoke.push(set(E.callable), get(E.callable));
+  const callThen: Instr[] = [get(E.then), get(E.next), get(E.thenArgs)];
+  put(callThen, r.elementOperands.applyThen);
+  callThen.push({ op: "drop" });
