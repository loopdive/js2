+  return { kind: "externref" };
+}
+export function abortCapturedFrame(owner: CapturedFrameConstruction): void {
+  // Finally-safe cleanup of our own already-revoked scope does not mask the
+  // original producer/render failure. Successful transfer is not rollbackable.
+  if (frames.get(owner)?.state === "revoked") return;
+  const f = liveFrame(owner);
+  f.fctx.body = f.destination;
+  f.stack.length = 0;
+  for (const child of f.children) child.state = "revoked";
+  f.state = "revoked";
+  release(f);
+  // Deliberately no fake rollback of locals, imports, providers or module state.
+}
