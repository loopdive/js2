+  body.push(set(P.ctor));
+  const getResolve: Instr[] = [get(P.ctor)];
+  put(getResolve, r.prologueOperands.resolveKey);
+  put(getResolve, r.prologueOperands.getResolve);
+  getResolve.push(set(P.resolve));
+  body.push(tagged(getResolve, caught(P.reason, r.prologueOperands.rejectGet)));
