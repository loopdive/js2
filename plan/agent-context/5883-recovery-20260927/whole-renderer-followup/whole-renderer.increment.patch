+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { beforeEach, expect, it, vi } from "vitest";
+import type { Instr } from "../src/ir/types.js";
+import type { CodegenContext, FunctionContext } from "../src/codegen/context/types.js";
+import type { AuthenticatedChildConstruction } from "../src/codegen/staging-bindings.js";
+const hooks = vi.hoisted(() => ({
+  enter: vi.fn(), finish: vi.fn(), abort: vi.fn(), seed: vi.fn(),
+}));
+vi.mock("../src/codegen/staging-bindings.js", () => ({
+  enterRetainedChild: hooks.enter,
+  finishRetainedChild: hooks.finish,
+  abortRetainedChild: hooks.abort,
+}));
+vi.mock("../src/codegen/object-runtime.js", () => ({ ensureObjectRuntime: vi.fn() }));
+vi.mock("../src/codegen/builtin-static-globals.js", () => ({
+  reserveBuiltinConstructorIdentityGlobal: () => 3,
+}));
+vi.mock("../src/codegen/context/locals.js", () => ({
+  allocLocal: (frame: FunctionContext, name: string) => {
+    frame.locals.push({ name, type: { kind: "externref" } });
+    return frame.locals.length - 1;
+  },
+}));
+vi.mock("../src/codegen/builtin-ctor-own-props.js", () => ({ pushBuiltinCtorOwnPropSeed: hooks.seed }));
+import { prepareBuiltinConstructorRegion } from "../src/codegen/builtin-constructor-prepared.js";
+
+beforeEach(() => { vi.resetAllMocks(); });
+
+function fixture() {
+  const destination: Instr[] = [{ op: "nop" }];
+  const child: Instr[] = [];
+  const ctx = { funcMap: new Map([["__new_plain_object", 7]]), liveBodies: new Set([destination, child]) } as unknown as CodegenContext;
+  const frame = { body: destination, locals: [] } as unknown as FunctionContext;
+  // Test-only stand-ins for owner handles: this suite checks delegation, not authentication.
+  const construction = {} as AuthenticatedChildConstruction;
+  const emission = { body: child };
+  const owned = Object.freeze({});
+  hooks.enter.mockImplementation(() => { frame.body = child; return emission; });
+  hooks.finish.mockImplementation(() => { frame.body = destination; return owned; });
+  hooks.abort.mockImplementation(() => { frame.body = destination; });
+  return { ctx, frame, destination, child, construction, emission, owned };
+}
+
+it("returns the owner's child after one real constructor construction", () => {
+  const f = fixture();
+  let init: Instr[] | undefined;
+  hooks.seed.mockImplementation((_ctx, frame: FunctionContext) => {
+    init = frame.body;
+    expect(init).toEqual([
+      { op: "call", funcIdx: 7 }, { op: "local.set", index: 0 },
+      { op: "local.get", index: 0 }, { op: "global.set", index: 3 },
+    ]);
+  });
+  expect(prepareBuiltinConstructorRegion(f.ctx, f.frame, "Promise", f.construction)).toBe(f.owned);
+  expect(hooks.enter).toHaveBeenCalledExactlyOnceWith(f.ctx, f.frame, f.construction);
+  expect(hooks.finish).toHaveBeenCalledExactlyOnceWith(f.emission);
+  expect(hooks.abort).not.toHaveBeenCalled();
+  expect(hooks.seed).toHaveBeenCalledExactlyOnceWith(f.ctx, f.frame, "Promise", 0);
+  const guard = f.child[2];
+  if (guard?.op !== "if") throw new Error("Missing constructor guard");
+  expect(guard.then).toBe(init);
+  expect(f.child[0]).toEqual({ op: "global.get", index: 3 });
+  expect(f.child[3]).toEqual({ op: "global.get", index: 3 });
+  expect(f.frame.body).toBe(f.destination);
+  expect(f.destination).toEqual([{ op: "nop" }]);
+  expect([...f.ctx.liveBodies]).toEqual([f.destination, f.child]);
+});
+
+it.each(["seed", "finish"] as const)("aborts owner emission on %s failure without replacing the error", (phase) => {
+  const f = fixture();
+  const error = new Error(phase);
+  hooks[phase].mockImplementation(() => { throw error; });
+  let caught: unknown;
+  try { prepareBuiltinConstructorRegion(f.ctx, f.frame, "Promise", f.construction); }
+  catch (failure) { caught = failure; }
+  expect(caught).toBe(error);
+  expect(hooks.abort).toHaveBeenCalledExactlyOnceWith(f.emission);
+  if (phase === "seed") expect(hooks.finish).not.toHaveBeenCalled();
+  expect(f.frame.body).toBe(f.destination);
+  expect(f.destination).toEqual([{ op: "nop" }]);
+});
+
+it("does not construct or abort an emission when owner entry rejects", () => {
+  const f = fixture();
+  const error = new Error("foreign child");
+  hooks.enter.mockImplementation(() => { throw error; });
+  expect(() => prepareBuiltinConstructorRegion(f.ctx, f.frame, "Promise", f.construction)).toThrow(error);
+  expect(hooks.seed).not.toHaveBeenCalled();
+  expect(hooks.finish).not.toHaveBeenCalled();
+  expect(hooks.abort).not.toHaveBeenCalled();
+  expect(f.frame.body).toBe(f.destination);
+});
