+function fixture(method: "all" | "race" = "all") {
+  // Any semantic ctx API access is a defect in this adapter.
+  const liveBodies = new Set<Instr[]>();
+  const contextState: { liveBodies: Set<Instr[]>; currentFunc?: FunctionContext; funcStack: FunctionContext[] } = { liveBodies, funcStack: [] };
+  const ctx = new Proxy(contextState, {
+    get(target, key) {
+      if (key === "liveBodies") return target.liveBodies;
+      if (key === "currentFunc") return target.currentFunc;
+      if (key === "funcStack") return target.funcStack;
+      throw new Error(`Unexpected ctx access: ${String(key)}`);
+    },
+  }) as unknown as CodegenContext;
