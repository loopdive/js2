--- /dev/null
+++ b/tests/issue-5883-whole-captured-drive-render.test.ts
@@ -0,0 +1,168 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { afterEach, expect, it, vi } from "vitest";
+import { compile } from "../src/index.js";
+import * as renderer from "../src/codegen/promise-captured-drive-render.js";
+import * as binding from "../src/codegen/staging-bindings.js";
+import * as locals from "../src/codegen/context/locals.js";
+import * as shared from "../src/codegen/shared.js";
+import * as strings from "../src/codegen/native-strings.js";
+import * as scheduler from "../src/codegen/async-scheduler.js";
+import * as observable from "../src/codegen/promise-combinator-observable-protocol.js";
+import * as constructor from "../src/codegen/builtin-constructor-prepared.js";
+import * as imports from "../src/codegen/registry/imports.js";
+import * as functions from "../src/codegen/func-space.js";
+import type { Instr } from "../src/ir/types.js";
+import type { CodegenContext, FunctionContext } from "../src/codegen/context/types.js";
+
+afterEach(() => vi.restoreAllMocks());
+
+for (const method of ["all", "race"] as const) {
+  it(`real captured ${method}: whole render has no preparation effects`, async () => {
+    const realRender = renderer.renderCapturedDrive;
+    let hits = 0;
+    vi.spyOn(renderer, "renderCapturedDrive").mockImplementation((prepared, resolved) => {
+      hits++;
+      expect(prepared.method).toBe(method);
+      expect(resolved.authorization.method).toBe(method);
+      expect(resolved.authorization.children.length).toBeGreaterThan(20);
+      const poison = () => { throw new Error("effectful API reached inside pure whole renderer"); };
+      const traps = [
+        vi.spyOn(locals, "allocLocal").mockImplementation(poison),
+        vi.spyOn(binding, "allocateCapturedLocal").mockImplementation(poison),
+        vi.spyOn(binding, "beginRetainedChild").mockImplementation(poison),
+        vi.spyOn(binding, "authorizeCapturedRender").mockImplementation(poison),
+        vi.spyOn(shared, "compileExpression").mockImplementation(poison),
+        vi.spyOn(shared, "flushLateImportShifts").mockImplementation(poison),
+        vi.spyOn(strings, "stringConstantExternrefInstrs").mockImplementation(poison),
+        vi.spyOn(scheduler, "ensureAsyncDriveRuntime").mockImplementation(poison),
+        vi.spyOn(observable, "ensureObservableCombinatorRuntime").mockImplementation(poison),
+        vi.spyOn(constructor, "prepareBuiltinConstructorRegion").mockImplementation(poison),
+        vi.spyOn(imports, "ensureExnTag").mockImplementation(poison),
+      ];
+      try {
+        // Required negative data controls, checked BEFORE touching any child.
+        expect(() => renderer.resolveCapturedDriveBindings(prepared, {
+          ...resolved.authorization, method: method === "all" ? "race" : "all",
+        })).toThrow("method mismatch");
+        expect(() => renderer.resolveCapturedDriveBindings(prepared, {
+          ...resolved.authorization, children: [],
+        })).toThrow("captured operand child");
+        expect(() => renderer.resolveCapturedDriveBindings({
+          ...prepared, source: { ...prepared.source, index: prepared.source.index + 1 },
+        }, resolved.authorization)).toThrow("local declaration/type changed");
+        expect(() => renderer.resolveCapturedDriveBindings({
+          ...prepared, source: { ...prepared.source, type: { kind: "i32" } },
+        }, resolved.authorization)).toThrow("local declaration/type changed");
+        const output = realRender(prepared, resolved);
+        expect(output.authorization).toBe(resolved.authorization);
+        expect(output.result).toEqual([{ kind: "externref" }]);
+        expect(output.childPlacements).toHaveLength(resolved.authorization.children.length);
+        expect(output.instructions[0]).toEqual({ op: "local.get", index: prepared.source.index });
+        expect(output.instructions.at(-1)).toEqual({ op: "extern.convert_any" });
+        expect(output.instructions.some((i) => i.op === "block" && i.body.some((j) => j.op === "loop"))).toBe(true);
+        return output;
+      } finally { for (const trap of traps.reverse()) trap.mockRestore(); }
+    });
+    const source = `declare function __drain_microtasks(): void;
+export function test(): number {
+  let answer=-100; const input:any[]=[1,2];
+  (Promise as any).resolve=function(value:any):any {return {then:function(ok:any):void {ok(value);}};};
+  Promise.${method}(input).then(function(value:any):void {answer=${method === "all" ? "value[0]*10+value[1]" : "value"};});
+  __drain_microtasks(); return answer;
+}`;
+    const result = await compile(source, {
+      fileName: `5883-whole-render-${method}.ts`, target: "standalone", nativeStrings: true, optimize: false,
+    });
+    console.log(JSON.stringify({ kind: "whole-render", method, source, hits, success: result.success, errors: result.errors }));
+    expect(hits).toBe(1);
+    expect(result.success, JSON.stringify(result.errors)).toBe(true);
+    const module = await WebAssembly.compile(new Uint8Array(result.binary));
+    expect(WebAssembly.Module.imports(module)).toEqual([]);
+    const instance = await WebAssembly.instantiate(module, {});
+    const actual = (instance.exports.test as () => number)();
+    console.log(JSON.stringify({ kind: "whole-render-result", method, actual }));
+    expect(actual).toBe(method === "all" ? 12 : 1);
+  }, 120000);
+}
+
+/** Small real-owner fixture: physical transfer tests, NOT runtime/provider proof. */
+function ownerFixture() {
+  const frame = {
+    name: "physical-test", params: [{ name: "source", type: { kind: "externref" } }],
+    locals: [], localMap: new Map([["source", 0]]), body: [], savedBodies: [],
+  } as unknown as FunctionContext;
+  const ctx = { currentFunc: frame, funcStack: [], liveBodies: new Set<Instr[]>() } as unknown as CodegenContext;
+  const owner = binding.beginCapturedFrame(ctx, frame, "race", 0);
+  const emission = binding.enterRetainedChild(ctx, frame, binding.beginRetainedChild(owner, [{ kind: "externref" }]));
+  emission.body.push({ op: "local.get", index: 0 });
+  binding.finishRetainedChild(emission);
+  const authorization = binding.authorizeCapturedRender(owner);
+  const child = authorization.children[0]!;
+  const instructions = [...child.instructions];
+  const output: binding.CapturedRenderOutput = {
+    authorization, instructions, childPlacements: [{ child, destination: instructions, start: 0 }],
+    result: [{ kind: "externref" }],
+  };
+  return { frame, ctx, owner, output };
+}
+
+it("accepts genuine source index zero and consumes only the successful transfer", () => {
+  const { frame, ctx, owner, output } = ownerFixture();
+  expect(binding.attachRenderedCapturedDrive(owner, output)).toEqual({ kind: "externref" });
+  expect(frame.body[0]).toBe(output.instructions[0]);
+  expect(ctx.liveBodies.size).toBe(0);
+  expect(() => binding.attachRenderedCapturedDrive(owner, output)).toThrow();
+  expect(frame.body).toHaveLength(1);
+});
+
+it("diagnoses missing/wrong ABI without changing historical operand admission", () => {
+  const frame = { name: "abi", params: [{ name: "source", type: { kind: "externref" } }],
+    locals: [], localMap: new Map([["source", 0]]), body: [], savedBodies: [],
+  } as unknown as FunctionContext;
+  const ctx = { currentFunc: frame, funcStack: [], liveBodies: new Set<Instr[]>() } as unknown as CodegenContext;
+  const owner = binding.beginCapturedFrame(ctx, frame, "race", 0);
+  try {
+    const diagnose = (index: number): string => {
+      const signature = index >= 0 ? functions.funcSignatureOf(ctx, index) : undefined;
+      return !signature ? "missing" : signature.params.length || signature.results.length ? "ABI mismatch" : "match";
+    };
+    expect(diagnose(-1)).toBe("missing");
+    const missing = observable.retainCapturedCall(ctx, frame, owner, -1, []);
+    // Signature fault injection only; not a fabricated provider readiness test.
+    const signature = vi.spyOn(functions, "funcSignatureOf").mockReturnValue({
+      kind: "func", params: [{ kind: "i32" }], results: [],
+    });
+    try {
+      expect(diagnose(0)).toBe("ABI mismatch");
+      expect(signature).toHaveBeenCalledWith(ctx, 0);
+    } finally { signature.mockRestore(); }
+    const wrong = observable.retainCapturedCall(ctx, frame, owner, 0, []);
+    const authorized = binding.authorizeCapturedRender(owner);
+    expect(authorized.children.find((c) => c.identity === missing.owned)?.instructions).toEqual([{ op: "call", funcIdx: -1 }]);
+    expect(authorized.children.find((c) => c.identity === wrong.owned)?.instructions).toEqual([{ op: "call", funcIdx: 0 }]);
+    expect(frame.body).toEqual([]);
+  } finally { binding.abortCapturedFrame(owner); }
+});
+
+for (const failure of ["missing", "duplicate", "unreachable", "fractional", "foreign", "alias"] as const) {
+  it(`rejects ${failure} child placement before destination mutation`, () => {
+    const { frame, ctx, owner, output } = ownerFixture();
+    const placement = output.childPlacements[0]!;
+    const broken: binding.CapturedRenderOutput = {
+      ...output,
+      ...(failure === "alias" ? { instructions: [...output.instructions, ...output.instructions] } : {}),
+      childPlacements: failure === "missing" ? [] : failure === "duplicate" ? [placement, placement] : [{
+        ...placement,
+        ...(failure === "unreachable" ? { destination: [...output.instructions] } : {}),
+        ...(failure === "fractional" ? { start: 0.5 } : {}),
+        ...(failure === "foreign" ? { child: { ...placement.child, identity: {} as binding.OwnedCapturedChild } } : {}),
+      }],
+    };
+    try {
+      expect(() => binding.attachRenderedCapturedDrive(owner, broken)).toThrow();
+      expect(frame.body).toEqual([]);
+    } finally { binding.abortCapturedFrame(owner); }
+    expect(ctx.liveBodies.size).toBe(0);
+    expect(() => binding.attachRenderedCapturedDrive(owner, output)).toThrow();
+  });
+}
