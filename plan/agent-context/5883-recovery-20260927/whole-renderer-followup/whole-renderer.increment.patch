+    identity: Object.freeze({}), frameIdentity: owner, method: f.method,
+    locals: Object.freeze(f.declarations.map((r, index) => Object.freeze({ binding: r.binding, index, type: r.type }))),
+    children: Object.freeze(f.children.filter((c) => c.state === "retained").map((c) => Object.freeze({
+      identity: c.owned!, instructions: Object.freeze([...c.body]), result: c.result,
+    }))),
+  });
