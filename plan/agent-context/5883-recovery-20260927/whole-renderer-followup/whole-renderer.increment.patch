+}
+export function finishRetainedChild(emission: RetainedChildEmission): OwnedCapturedChild {
+  const child = activeEmission(emission);
+  const f = child.frame;
+  checkFrame(f, true);
+  const tree = inspect(child.body, f.params.length + f.locals.length);
+  captureDeclarations(f);
+  child.tree = tree;
+  child.owned = handle("captured-child");
+  child.state = "retained";
+  f.fctx.body = child.previous!;
+  f.stack.pop();
+  return child.owned;
+}
+export function abortRetainedChild(emission: RetainedChildEmission): void {
+  const child = activeEmission(emission);
+  const f = child.frame;
+  f.fctx.body = child.previous!;
+  f.stack.pop();
+  // Creation scope, not completion order, owns descendants. Finished and
+  // never-entered descendants cannot escape a failed producer. Siblings survive.
+  for (const candidate of f.children) {
+    let ancestor: Child | undefined = candidate;
+    while (ancestor && ancestor !== child) ancestor = ancestor.parent;
+    if (!ancestor) continue;
+    candidate.state = "revoked";
+    if (f.roots.get(candidate.body) === false) f.ctx.liveBodies.delete(candidate.body);
+    f.roots.delete(candidate.body);
+  }
+}
+export function authorizeCapturedRender(owner: CapturedFrameConstruction): AuthorizedCapturedRender {
+  const f = liveFrame(owner, true);
+  checkFrame(f, true);
+  if (f.stack.length || f.children.some((c) => c.state === "new" || c.state === "emitting"))
+    throw new Error("Finish retained children before authorization");
+  const count = f.params.length + f.locals.length;
+  const seen = new Set<Instr>();
+  const seenArrays = new Set<readonly Instr[]>();
+  for (const child of f.children.filter((c) => c.state === "retained")) {
+    const tree = checkChild(child, count);
+    for (const array of tree.arrays.keys()) {
+      if (seenArrays.has(array)) throw new Error("Retained children share arrays");
+      seenArrays.add(array);
+    }
+    for (const instruction of tree.instructions) {
+      if (seen.has(instruction)) throw new Error("Retained children share instructions");
+      seen.add(instruction);
+    }
+  }
