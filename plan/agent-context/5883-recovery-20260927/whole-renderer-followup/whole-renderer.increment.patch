+        fulfill: local(prepared.race.fulfill), fulfillClosure: child(prepared.race.fulfillClosure),
+      } };
+}
+
+/** WHOLE algorithm. Semantic allocations/registration and child authority are absent. */
+export function renderCapturedDrive(
+  p: PreparedCapturedDriveRender,
+  r: ResolvedCapturedDriveBindings,
+): CapturedRenderOutput {
+  if (p.method !== r.method || r.authorization.method !== r.method)
+    throw new Error("Captured renderer method mismatch");
