+  };
+  const child = (role: CapturedOperand): AuthorizedCapturedChild => {
+    const matches = authorization.children.filter((value) => value.identity === role.owned);
+    if (matches.length !== 1 || matches[0]!.instructions.length === 0)
+      throw new Error("Missing or ambiguous captured operand child");
+    return matches[0]!;
+  };
