+  put(badThen, r.elementOperands.thenError);
+  put(badThen, r.elementOperands.newThenError);
+  badThen.push(...saveThrow());
+  invoke.push({ op: "if", blockType: { kind: "empty" }, then: callThen, else: badThen });
