--- /dev/null
+++ b/tests/issue-5883-captured-match-leaves.test.ts
@@ -0,0 +1,61 @@
+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import "../src/index.js";
+import { afterEach, expect, it, vi } from "vitest";
+import { emitObservableCombinatorPreparation, type CombinatorRuntime, type ObservableCombinatorRuntime } from "../src/codegen/promise-combinator-observable-protocol.js";
+import * as constructors from "../src/codegen/builtin-static-globals.js";
+import * as strings from "../src/codegen/native-strings.js";
+import type { CodegenContext, FunctionContext } from "../src/codegen/context/types.js";
+import type { Instr } from "../src/ir/types.js";
+import type { ensureAsyncDriveRuntime } from "../src/codegen/async-scheduler.js";
+afterEach(() => vi.restoreAllMocks());
+
+// Structural unit only: real prologue/classifier, mocked unrelated constructor/string work.
+for (const count of [0, 1, 3]) for (const method of ["all", "race"] as const) {
+  it(`${method}: ${count} roots preserve ordered values, freshen only match leaves`, () => {
+    vi.spyOn(constructors, "emitBuiltinConstructorIdentity").mockImplementation((_ctx, fctx) => {
+      fctx.body.push({ op: "ref.null.extern" }); return { kind: "externref" };
+    });
+    vi.spyOn(strings, "stringConstantExternrefInstrs").mockImplementation(() => [{ op: "ref.null.extern" }]);
+    const ctx = {
+      standalone: false, wasi: false, boundFnTypeIdx: -1,
+      mod: { types: Array.from({ length: count }, () => ({ kind: "struct", fields: [] })) },
+      // Deliberately reversed insertion order: never sort roots in B.
+      closureInfoByTypeIdx: new Map(Array.from({ length: count }, (_, i) => [count - 1 - i, {}])),
+      funcMap: new Map([["__promise_resolve_cl", 11], ["__promise_reject_cl", 12], ["__extern_get", 13], ["__new_TypeError", 14]]),
+    } as unknown as CodegenContext;
+    const freshFrame = () => ({ params: [], locals: [], localMap: new Map(), body: [], savedBodies: [] }) as unknown as FunctionContext;
+    const oldFrame = freshFrame(), fresh = freshFrame();
+    const ids = { promiseTypeIdx: 20 } as CombinatorRuntime;
+    const rt = { rejectFuncIdx: 21 } as ReturnType<typeof ensureAsyncDriveRuntime>;
+    const protocol = { exnTagIdx: 0, settleClosures: { capPromiseFieldIdx: 5, capTypeIdx: 22, capMetaTypeIdx: 23 } } as ObservableCombinatorRuntime;
+    emitObservableCombinatorPreparation(ctx, oldFrame, ids, rt, protocol, method);
+    emitObservableCombinatorPreparation(ctx, fresh, ids, rt, protocol, method, { capturedResolveMatchLeaves: true });
+    expect(fresh.locals).toEqual(oldFrame.locals);
+    expect([...fresh.localMap]).toEqual([...oldFrame.localMap]);
+    expect(JSON.stringify(fresh.body)).toBe(JSON.stringify(oldFrame.body));
+    function arms(body: Instr[]): { typeIdx: number; leaves: Instr[] }[] {
+      const result: { typeIdx: number; leaves: Instr[] }[] = [];
+      const visit = (list: Instr[]) => {
+        for (let i = 0; i < list.length; i++) {
+          const instr = list[i]!, next = list[i + 1];
+          if (instr.op === "ref.test" && next?.op === "if") result.push({ typeIdx: instr.typeIdx, leaves: next.then });
+          if (instr.op === "if") { visit(instr.then); if (instr.else) visit(instr.else); }
+          else if (instr.op === "try") { visit(instr.body); for (const c of instr.catches ?? []) visit(c.body); }
+          else if (instr.op === "block" || instr.op === "loop" || instr.op === "try_table") visit(instr.body);
+        }
+      };
+      visit(body); return result;
+    }
+    const before = arms(oldFrame.body), after = arms(fresh.body);
+    expect(after.map((arm) => arm.typeIdx)).toEqual(Array.from({ length: count }, (_, i) => count - 1 - i));
+    expect(before).toHaveLength(count);
+    expect(new Set(after.flatMap((arm) => arm.leaves)).size).toBe(count * 2);
+    expect(new Set(before.flatMap((arm) => arm.leaves)).size).toBe(count ? 2 : 0);
+    for (let i = 0; i < count; i++) expect(after[i]!.leaves).toEqual(before[i]!.leaves);
+    // Neither the default branch nor the shared classifier was changed.
+    const legacyAgain = freshFrame();
+    emitObservableCombinatorPreparation(ctx, legacyAgain, ids, rt, protocol, method);
+    expect(JSON.stringify(legacyAgain.body)).toBe(JSON.stringify(oldFrame.body));
+    expect(new Set(arms(legacyAgain.body).flatMap((arm) => arm.leaves)).size).toBe(count ? 2 : 0);
+  });
+}
diff --git a/tests/issue-5883-whole-captured-drive-render.test.ts b/tests/issue-5883-whole-captured-drive-render.test.ts
