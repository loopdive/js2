+    Object.fromEntries(Object.entries(roles).map(([key, value]) => [key, local(value as CapturedLocal)])) as Indices<T>;
+  const children = <T extends object>(roles: T): Children<T> =>
+    Object.fromEntries(Object.entries(roles).map(([key, value]) => [key, child(value as CapturedOperand)])) as Children<T>;
+  const common: ResolvedCommon = {
+    authorization, source: local(prepared.source), drive: locals(prepared.drive),
+    prologue: locals(prepared.prologue), element: locals(prepared.element),
+    prologueOperands: children(prepared.prologueOperands), elementOperands: children(prepared.elementOperands),
+    control: children(prepared.control),
+  };
