+      readonly fulfill: number; readonly fulfillClosure: AuthorizedCapturedChild;
+    } });
+
+/** Finite data projection AFTER the owner authenticates, BEFORE pure rendering. */
+export function resolveCapturedDriveBindings(
+  prepared: PreparedCapturedDriveRender,
+  authorization: AuthorizedCapturedRender,
+): ResolvedCapturedDriveBindings {
+  if (prepared.method !== authorization.method) throw new Error("Captured drive method mismatch");
