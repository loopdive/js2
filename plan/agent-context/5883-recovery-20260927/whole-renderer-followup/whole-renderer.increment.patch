+  if (output.childPlacements.length !== children.length) throw new Error("Missing or duplicate child placement");
+  const placed = new Set<AuthorizedCapturedChild>();
+  for (const placement of output.childPlacements) {
+    if (!children.includes(placement.child) || placed.has(placement.child)) throw new Error("Foreign or duplicate child placement");
