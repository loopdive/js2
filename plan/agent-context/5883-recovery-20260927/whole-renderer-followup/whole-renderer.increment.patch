+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import type { Instr } from "../src/ir/types.js";
+import type { CodegenContext, FunctionContext } from "../src/codegen/context/types.js";
+const providers = vi.hoisted(() => ({ seed: vi.fn() }));
+vi.mock("../src/codegen/object-runtime.js", () => ({ ensureObjectRuntime: vi.fn() }));
+vi.mock("../src/codegen/builtin-static-globals.js", () => ({
+  reserveBuiltinConstructorIdentityGlobal: () => 3,
+}));
+vi.mock("../src/codegen/builtin-ctor-own-props.js", () => ({
+  pushBuiltinCtorOwnPropSeed: providers.seed,
+}));
+// Real adapter, real local allocator, real constructor builder. Spies below
+// observe real finish results; no adapter implementation is replaced.
+import * as staging from "../src/codegen/staging-bindings.js";
+import { prepareBuiltinConstructorRegion } from "../src/codegen/builtin-constructor-prepared.js";
+
+beforeEach(() => { providers.seed.mockReset(); });
+afterEach(() => { vi.restoreAllMocks(); });
+
+function fixture(borrowed: boolean) {
+  const sentinel: Instr = { op: "nop" };
+  const destination: Instr[] = [sentinel];
+  const unrelated: Instr[] = [{ op: "nop" }];
+  const frame = {
+    body: destination,
+    params: [{ name: "source", type: { kind: "externref" } }],
+    locals: [],
+    localMap: new Map([["source", 0]]),
+  } as unknown as FunctionContext;
+  const roots = new Set<Instr[]>([unrelated]);
+  if (borrowed) roots.add(destination);
+  const originalRoots = [...roots];
+  const ctx = {
+    currentFunc: frame, funcStack: [], liveBodies: roots,
+    funcMap: new Map([["__new_plain_object", 7]]),
+  } as unknown as CodegenContext;
+  const owner = staging.beginCapturedFrame(ctx, frame, "all", 0);
+  const beforeChild = new Set(roots);
+  const construction = staging.beginRetainedChild(owner, [{ kind: "externref" }]);
+  const added = [...roots].filter((root) => !beforeChild.has(root));
+  expect(added).toHaveLength(1);
+  const childRoot = added[0]!;
+  return { ctx, frame, destination, sentinel, unrelated, originalRoots, owner, construction, childRoot };
+}
+
+it.each([false, true])("real adapter preserves the seed error and cleans owned roots (borrowed=%s)", (borrowed) => {
+  const f = fixture(borrowed);
+  const error = new Error("seed sentinel");
+  let init: Instr[] | undefined;
+  providers.seed.mockImplementation(() => {
+    init = f.frame.body;
+    expect(f.ctx.liveBodies.has(init)).toBe(true);
+    expect(f.ctx.liveBodies.has(f.childRoot)).toBe(true);
+    throw error;
+  });
+  let caught: unknown;
+  try { prepareBuiltinConstructorRegion(f.ctx, f.frame, "Promise", f.construction); }
+  catch (failure) { caught = failure; }
+  expect(caught).toBe(error);
+  expect(f.frame.body).toBe(f.destination);
+  expect(f.destination).toEqual([f.sentinel]);
+  expect(f.destination[0]).toBe(f.sentinel);
+  expect(init).toBeDefined();
+  expect(f.ctx.liveBodies.has(init!)).toBe(false);
+  expect(f.ctx.liveBodies.has(f.childRoot)).toBe(false);
+  expect(f.ctx.liveBodies.has(f.destination)).toBe(true);
+  expect(f.ctx.liveBodies.has(f.unrelated)).toBe(true);
+  expect(() => staging.abortCapturedFrame(f.owner)).not.toThrow();
+  expect(() => staging.abortCapturedFrame(f.owner)).not.toThrow();
+  expect([...f.ctx.liveBodies]).toEqual(f.originalRoots);
+  expect(f.frame.body).toBe(f.destination);
+  // Cleanup owns roots, not a fictional rollback of constructor local effects.
+  expect(f.frame.locals).toHaveLength(1);
+});
+
+it.each(["invalid-local", "lost-root"] as const)("real finish %s error survives constructor cleanup by identity", (mode) => {
+  const f = fixture(true);
+  const finish = vi.spyOn(staging, "finishRetainedChild");
+  let init: Instr[] | undefined;
+  providers.seed.mockImplementation(() => {
+    init = f.frame.body;
+    if (mode === "invalid-local") {
+      f.frame.body.push({ op: "local.get", index: f.frame.params.length + f.frame.locals.length });
+    } else {
+      expect(f.ctx.liveBodies.delete(f.childRoot)).toBe(true);
+    }
+  });
+  let caught: unknown;
+  try { prepareBuiltinConstructorRegion(f.ctx, f.frame, "Promise", f.construction); }
+  catch (failure) { caught = failure; }
+  expect(finish).toHaveBeenCalledTimes(1);
+  const actualFinish = finish.mock.results[0];
+  expect(actualFinish?.type).toBe("throw");
+  expect(caught).toBe(actualFinish?.value);
+  expect(caught).toBeInstanceOf(Error);
+  expect((caught as Error).message).toBe(mode === "invalid-local"
+    ? "Captured local operand out of range" : "Captured shift root was removed");
+  expect(f.frame.body).toBe(f.destination);
+  expect(f.destination).toEqual([f.sentinel]);
+  expect(f.destination[0]).toBe(f.sentinel);
+  expect(init).toBeDefined();
+  expect(f.ctx.liveBodies.has(init!)).toBe(false);
+  expect(f.ctx.liveBodies.has(f.childRoot)).toBe(false);
+  expect([...f.ctx.liveBodies]).toEqual([f.unrelated, f.destination]);
+  expect(() => staging.abortCapturedFrame(f.owner)).not.toThrow();
+  expect(() => staging.abortCapturedFrame(f.owner)).not.toThrow();
+  expect(f.frame.body).toBe(f.destination);
+  expect(f.destination[0]).toBe(f.sentinel);
+  expect([...f.ctx.liveBodies]).toEqual(f.originalRoots);
+  expect(f.frame.locals).toHaveLength(1);
+});
