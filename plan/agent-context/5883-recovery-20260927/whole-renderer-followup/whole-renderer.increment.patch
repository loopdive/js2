+// Copyright (c) 2026 Loopdive GmbH. Licensed under Apache-2.0 WITH LLVM-exception.
+// SOURCE-ONLY until a dedicated compiler-slot grant. No mocked shift/context APIs.
+import { describe, expect, it } from "vitest";
+import { ts } from "../src/ts-api.js";
+import { createEmptyModule, type Instr } from "../src/ir/types.js";
+// Use the normal codegen entrypoint so delegate registration is not bypassed.
+import { createCodegenContext } from "../src/codegen/index.js";
+import type { FunctionContext } from "../src/codegen/context/types.js";
+import { allocLocal } from "../src/codegen/context/locals.js";
+import { addFuncType } from "../src/codegen/registry/types.js";
+import { mintDefinedFunc, pushDefinedFunc } from "../src/codegen/func-space.js";
+import { absoluteFuncIndex } from "../src/emit/resolve-layout.js";
+import { addHostStringConstantGlobal, nextModuleGlobalIdx } from "../src/codegen/registry/imports.js";
+import { ensureLateImport, flushLateImportShifts } from "../src/codegen/expressions/late-imports.js";
+import {
+  beginCapturedFrame, beginRetainedChild, enterRetainedChild, finishRetainedChild,
+  authorizeCapturedRender, attachRenderedCapturedDrive, abortCapturedFrame,
+  type CapturedRenderOutput,
+} from "../src/codegen/staging-bindings.js";
+
+function fixture(aliases: boolean) {
+  // A real checker and fully initialized context, not a cast/Proxy/dummy checker.
+  // No source compilation or Wasm emission is needed for this walker instrument.
+  const program = ts.createProgram([], { noLib: true, noEmit: true });
+  const ctx = createCodegenContext(createEmptyModule(), program.getTypeChecker(), {
+    standalone: false, wasi: false, nativeStrings: true, strictNoHostImports: false,
+  });
+  expect(ctx.targetProfile.semanticProviders).toBe("host-assisted");
+  expect(ctx.nativeStrings).toBe(true);
+  const fctx: FunctionContext = {
+    name: "R_real_shift_frame", params: [], locals: [], localMap: new Map(),
+    returnType: { kind: "externref" }, body: [], blockDepth: 0,
+    breakStack: [], continueStack: [], labelMap: new Map(), savedBodies: [],
+  };
+  ctx.currentFunc = fctx;
+  const source = allocLocal(fctx, "source", { kind: "externref" });
+  expect(source).toBe(0);
+  const destination = fctx.body;
+  ctx.liveBodies.add(destination); // Borrowed from the surrounding frame owner.
+
+  const anchor = ensureLateImport(ctx, "__R_shift_anchor", [], [{ kind: "externref" }]);
+  if (anchor === undefined) throw new Error("Anchor import was refused");
+  flushLateImportShifts(ctx, fctx);
+  expect(ctx.pendingLateImportShift).toBeNull();
+  const stable = mintDefinedFunc(ctx);
+  pushDefinedFunc(ctx, stable, {
+    name: "R_shift_callee", typeIdx: addFuncType(ctx, [], [{ kind: "externref" }]),
+    locals: [], body: [{ op: "ref.null.extern" }], exported: false,
+  });
+  const globalName = "R_shift_global";
+  const globalIndex = nextModuleGlobalIdx(ctx);
+  ctx.mod.globals.push({ name: globalName, type: { kind: "externref" }, mutable: true,
+    init: [{ op: "ref.null.extern" }] });
+  ctx.moduleGlobals.set(globalName, globalIndex);
+
+  // Deliberately exercise the historical LIVE operand range, alongside a real
+  // stable-handle control. Stable handles alone would make shift tests vacuous.
+  const earlierFunctionScalar = absoluteFuncIndex(ctx.mod, stable);
+  const earlierGlobalScalar = globalIndex;
+  const liveCall: Extract<Instr, { op: "call" }> = { op: "call", funcIdx: earlierFunctionScalar };
+  const stableCall: Extract<Instr, { op: "call" }> = { op: "call", funcIdx: stable };
+  const anchorCall: Extract<Instr, { op: "call" }> = { op: "call", funcIdx: anchor };
+  const globalGet: Extract<Instr, { op: "global.get" }> = { op: "global.get", index: earlierGlobalScalar };
+  const nested: Instr[] = [anchorCall, { op: "drop" }, liveCall, { op: "drop" },
+    stableCall, { op: "drop" }, globalGet, { op: "drop" }, { op: "local.get", index: source }];
+  const block: Instr = { op: "block", blockType: { kind: "val", type: { kind: "externref" } }, body: nested };
+  const owner = beginCapturedFrame(ctx, fctx, "all", source);
+  const emission = enterRetainedChild(ctx, fctx, beginRetainedChild(owner, [{ kind: "externref" }]));
+  emission.body.push(block);
+  finishRetainedChild(emission);
+  expect(fctx.body).toBe(destination);
+  expect(destination).toEqual([]);
+  expect(ctx.mod.functions.some((fn) => fn.body === emission.body)).toBe(false);
+  expect(ctx.liveBodies.has(emission.body)).toBe(true);
+
+  // Positive duplicate-visit control: distinct borrowed arrays share leaves;
+  // one also exposes the nested child array. These are old traversal roots,
+  // not duplicate placements in the new output tree.
+  const saved: Instr[] = [liveCall, globalGet];
+  const parent: Instr[] = [block];
+  if (aliases) {
+    fctx.savedBodies.push(saved);
+    ctx.parentBodiesStack.push(parent);
+  } else {
+    expect(fctx.savedBodies).toEqual([]);
+    expect(ctx.parentBodiesStack).toEqual([]);
+  }
+  return { ctx, fctx, owner, destination, emission, nested, block, liveCall, stableCall, anchorCall,
+    globalGet, earlierFunctionScalar, earlierGlobalScalar, stable, anchor, globalName, saved, parent };
+}
+
+function importFunctionBatch(f: ReturnType<typeof fixture>) {
+  const before = f.ctx.numImportFuncs;
+  const first = ensureLateImport(f.ctx, "__R_shift_late_one", [], []);
+  const second = ensureLateImport(f.ctx, "__R_shift_late_two", [], []);
+  expect(first).toBe(before);
+  expect(second).toBe(before + 1);
+  expect(f.ctx.numImportFuncs).toBe(before + 2);
+  expect(f.ctx.pendingLateImportShift).toEqual({ importsBefore: before });
+  expect(f.ctx.mod.imports.filter((i) => i.desc.kind === "func")).toHaveLength(before + 2);
+  // Registration really was deferred; do not manually write the operands/latch.
+  expect(f.liveCall.funcIdx).toBe(f.earlierFunctionScalar);
+  flushLateImportShifts(f.ctx, f.fctx);
+  expect(f.ctx.pendingLateImportShift).toBeNull();
+  expect(f.liveCall.funcIdx).toBe(f.earlierFunctionScalar + 2);
+  expect(f.stableCall.funcIdx).toBe(f.stable);
+  expect(f.anchorCall.funcIdx).toBe(f.anchor);
+  flushLateImportShifts(f.ctx, f.fctx); // Settled batch must not shift twice.
+  expect(f.liveCall.funcIdx).toBe(f.earlierFunctionScalar + 2);
+}
+
+function importGlobal(f: ReturnType<typeof fixture>) {
+  const before = f.ctx.numImportGlobals;
+  const index = addHostStringConstantGlobal(f.ctx, "R real global shift");
+  expect(index).toBe(before);
+  expect(f.ctx.numImportGlobals).toBe(before + 1);
+  expect(f.ctx.mod.imports.some((i) => i.module === "string_constants" &&
+    i.name === "R real global shift" && i.desc.kind === "global")).toBe(true);
+  expect(f.globalGet.index).toBe(f.earlierGlobalScalar + 1);
+  expect(f.ctx.moduleGlobals.get(f.globalName)).toBe(f.earlierGlobalScalar + 1);
+  expect(addHostStringConstantGlobal(f.ctx, "R real global shift")).toBe(index);
+  expect(f.ctx.numImportGlobals).toBe(before + 1);
+  expect(f.globalGet.index).toBe(f.earlierGlobalScalar + 1);
+}
+
+function authorize(f: ReturnType<typeof fixture>): CapturedRenderOutput {
+  const authorization = authorizeCapturedRender(f.owner);
+  expect(authorization.children).toHaveLength(1);
+  const child = authorization.children[0]!;
+  const instructions = [...child.instructions];
+  expect(instructions[0]).toBe(f.block);
+  return { authorization, instructions,
+    childPlacements: [{ child, destination: instructions, start: 0 }], result: [{ kind: "externref" }] };
+}
+
+function assertTransferred(f: ReturnType<typeof fixture>, output: CapturedRenderOutput, aliases: boolean) {
+  attachRenderedCapturedDrive(f.owner, output);
+  expect(f.destination).toHaveLength(1);
+  expect(f.destination[0]).toBe(f.block);
+  expect(f.emission.body[0]).toBe(f.block);
+  expect(f.nested[2]).toBe(f.liveCall);
+  expect(f.nested[6]).toBe(f.globalGet);
+  expect([...f.ctx.liveBodies]).toEqual([f.destination]);
+  expect(f.fctx.savedBodies).toEqual(aliases ? [f.saved] : []);
+  expect(f.ctx.parentBodiesStack).toEqual(aliases ? [f.parent] : []);
+  expect(f.ctx.errors).toEqual([]);
+}
+
+describe("R real import walkers (authored instrument, not renderer equivalence)", () => {
+  it.each([false, true])("actual deferred function batch shifts retained child once, aliases=%s", (aliases) => {
+    const f = fixture(aliases);
+    importFunctionBatch(f);
+    // Distinct historical roles: materialized leaf shifted, earlier scalar did
+    // not, a genuinely later lookup sees the current layout. Do NOT refresh it.
+    const laterLookup = absoluteFuncIndex(f.ctx.mod, f.stable);
+    expect(laterLookup).toBe(f.earlierFunctionScalar + 2);
+    expect(f.liveCall.funcIdx).toBe(laterLookup);
+    const poisonedLateBake: Instr = { op: "call", funcIdx: f.earlierFunctionScalar };
+    expect(poisonedLateBake.funcIdx).not.toBe(laterLookup);
+    // This intentionally poisoned bake is NOT attached or repaired. It exposes
+    // the scalar/materialized distinction, not an approved production repair.
+    assertTransferred(f, authorize(f), aliases);
+  });
+
+  it.each([false, true])("actual string-global insertion shifts retained child once, aliases=%s", (aliases) => {
+    const f = fixture(aliases);
+    importGlobal(f);
+    expect(f.liveCall.funcIdx).toBe(f.earlierFunctionScalar); // Other index space unchanged.
+    const laterLookup = f.ctx.moduleGlobals.get(f.globalName);
+    expect(laterLookup).toBe(f.earlierGlobalScalar + 1);
+    const poisonedLateBake: Instr = { op: "global.get", index: f.earlierGlobalScalar };
+    expect(poisonedLateBake.index).not.toBe(laterLookup);
+    assertTransferred(f, authorize(f), aliases);
+  });
+
+  it.each(["function", "global"] as const)("actual %s shift after authorization rejects without refresh/rollback", (kind) => {
+    const f = fixture(false), output = authorize(f);
+    if (kind === "function") importFunctionBatch(f);
+    else importGlobal(f);
+    const roots = [...f.ctx.liveBodies], imports = [...f.ctx.mod.imports], locals = [...f.fctx.locals];
+    expect(() => attachRenderedCapturedDrive(f.owner, output)).toThrow("Retained operand changed after authorization");
+    expect(f.destination).toEqual([]);
+    expect(f.fctx.body).toBe(f.destination);
+    expect([...f.ctx.liveBodies]).toEqual(roots);
+    expect(f.fctx.locals).toEqual(locals);
+    expect(f.ctx.mod.imports).toEqual(imports);
+    abortCapturedFrame(f.owner);
+    expect([...f.ctx.liveBodies]).toEqual([f.destination]);
+    expect(f.ctx.mod.imports).toEqual(imports); // Cleanup is not module rollback.
+    expect(f.liveCall.funcIdx).toBe(f.earlierFunctionScalar + (kind === "function" ? 2 : 0));
+    expect(f.globalGet.index).toBe(f.earlierGlobalScalar + (kind === "global" ? 1 : 0));
+  });
+});
diff --git a/tests/issue-5883-captured-match-leaves.test.ts b/tests/issue-5883-captured-match-leaves.test.ts
