+  contextState.currentFunc = fctx;
+  const owner = beginCapturedFrame(ctx, fctx, method, 0);
+  return { ctx, fctx, owner, destination, liveBodies, contextState };
+}
+function child(f: ReturnType<typeof fixture>, instructions: Instr[] = [{ op: "local.get", index: 0 }]) {
+  const construction = beginRetainedChild(f.owner, [{ kind: "externref" }]);
+  const emission = enterRetainedChild(f.ctx, f.fctx, construction);
+  emission.body.push(...instructions);
+  const owned = finishRetainedChild(emission);
+  return { construction, emission, owned };
