+    ? { ...common, method: "all", all: {
+        grown: local(prepared.all.grown), elementCaps: local(prepared.all.elementCaps),
+        remaining: local(prepared.all.remaining), resolveClosure: child(prepared.all.resolveClosure),
+        completeFulfill: child(prepared.all.completeFulfill),
+      } }
