+  // after authorization. Snapshot all non-child data, never refresh providers
+  // or clone executable subtrees. Object.is preserves NaN and signed zero.
+  const operands = new Map([...seen].map((instruction) => [instruction,
+    snapshotOperand(instruction, seenArrays),
+  ]));
+  f.authorization = authorization;
+  f.renderOperands = operands;
+  f.state = "authorized";
+  return authorization;
+}
+export function attachRenderedCapturedDrive(owner: CapturedFrameConstruction, output: CapturedRenderOutput): { readonly kind: "externref" } {
+  const f = liveFrame(owner);
+  if (f.state !== "authorized" || output.authorization !== f.authorization)
+    throw new Error("Foreign or missing render authorization");
+  checkFrame(f, false);
+  if (output.result.length !== 1 || output.result[0]?.kind !== "externref")
+    throw new Error("Captured drive must produce one externref");
+  const tree = inspect(output.instructions, f.declarations.length);
+  // Existing legacy DAG aliases are not a new source rejection; only overlap
+  // with the newly transferred tree is forbidden.
+  const destinationTree = inspect(f.destination, f.declarations.length, true);
+  for (const instruction of tree.instructions) if (destinationTree.instructions.has(instruction))
+    throw new Error("Rendered instructions alias destination");
+  for (const array of tree.arrays.keys()) if (destinationTree.arrays.has(array))
+    throw new Error("Rendered arrays alias destination");
