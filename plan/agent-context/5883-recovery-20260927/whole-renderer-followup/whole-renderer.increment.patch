+  retain(f, child.body);
+  f.children.push(child);
+  constructions.set(construction, child);
+  return construction;
+}
+export function enterRetainedChild(
+  ctx: CodegenContext, fctx: FunctionContext, construction: AuthenticatedChildConstruction,
+): RetainedChildEmission {
+  const child = constructions.get(construction);
+  if (!child || child.frame.ctx !== ctx || child.frame.fctx !== fctx || child.state !== "new")
+    throw new Error("Foreign or consumed retained child");
+  const f = liveFrame(child.frame.owner, true);
+  checkFrame(f, true);
+  const emission = Object.freeze({ ...handle("captured-child-emission"), body: child.body });
+  child.previous = fctx.body;
+  child.emission = emission;
+  child.state = "emitting";
+  f.stack.push(child);
+  fctx.body = child.body;
+  emissions.set(emission, child);
+  return emission;
+}
+function activeEmission(emission: RetainedChildEmission): Child {
+  const child = emissions.get(emission);
+  if (!child || child.state !== "emitting") throw new Error("Unknown or closed retained emission");
+  const f = liveFrame(child.frame.owner, true);
+  if (f.stack[f.stack.length - 1] !== child) throw new Error("Retained children must close LIFO");
