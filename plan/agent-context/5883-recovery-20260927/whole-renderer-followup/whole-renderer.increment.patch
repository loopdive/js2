+  if (preparing && f.state !== "preparing") throw new Error("Captured preparation is closed");
+  return f;
+}
+function retain(f: Frame, root: Instr[]): void {
+  if (f.roots.has(root)) return;
+  f.roots.set(root, f.ctx.liveBodies.has(root));
+  f.ctx.liveBodies.add(root);
+}
+function release(f: Frame): void {
+  for (const [root, borrowed] of f.roots) if (!borrowed) f.ctx.liveBodies.delete(root);
+  f.roots.clear();
+  activeFrames.delete(f.fctx);
+}
+function checkFrame(f: Frame, growth: boolean): void {
+  if (f.ctx.currentFunc !== f.fctx && !f.ctx.funcStack.includes(f.fctx))
+    throw new Error("Captured frame is not active in its context");
+  const expected = f.stack.length ? f.stack[f.stack.length - 1]!.body : f.destination;
+  if (f.fctx.body !== expected || !sameItems(f.destination, f.prefix))
+    throw new Error("Captured destination/cursor changed");
+  if (f.fctx.params !== f.params || f.fctx.locals !== f.locals)
+    throw new Error("Captured declaration storage replaced");
+  const declarations = [...f.params, ...f.locals];
+  if (f.params.length !== f.paramCount ||
+      declarations.length < f.declarations.length || (!growth && declarations.length !== f.declarations.length))
+    throw new Error("Captured local layout changed");
+  for (let i = 0; i < f.declarations.length; i++) {
+    const old = f.declarations[i]!;
+    if (declarations[i] !== old.declaration || !sameType(declarations[i]!.type, old.type))
+      throw new Error("Captured declaration identity/type changed");
+  }
+  for (const root of f.roots.keys()) if (!f.ctx.liveBodies.has(root))
+    throw new Error("Captured shift root was removed");
+}
+function captureDeclarations(f: Frame): void {
+  for (const declaration of [...f.params, ...f.locals].slice(f.declarations.length)) {
+    const type = copyType(declaration.type);
+    const binding = Object.freeze({ ...handle("captured-local"), type });
+    f.declarations.push({ declaration, type, binding });
+  }
+}
+/** Independent physical census: aliases and cycles are errors, not deduplicated placements. */
+function inspect(root: readonly Instr[], localCount: number, existing = false): Tree {
+  const tree: Tree = { arrays: new Map(), instructions: new Set(), ops: new Map(), children: new Map(), locals: new Map() };
+  const pending = [root];
+  while (pending.length) {
+    const body = pending.pop()!;
+    if (tree.arrays.has(body)) {
+      if (existing) continue;
+      throw new Error("Captured array alias/cycle");
+    }
+    tree.arrays.set(body, [...body]);
+    for (const instruction of body) {
+      if (tree.instructions.has(instruction)) {
+        if (existing) continue;
+        throw new Error("Captured instruction alias");
+      }
+      tree.instructions.add(instruction);
+      tree.ops.set(instruction, instruction.op);
+      const children: Instr[][] = [];
+      walkChildren(instruction, (child) => children.push(child));
+      tree.children.set(instruction, children);
+      pending.push(...children);
+      if (instruction.op === "local.get" || instruction.op === "local.set" || instruction.op === "local.tee") {
+        if (!existing && (!Number.isInteger(instruction.index) || instruction.index < 0 || instruction.index >= localCount))
+          throw new Error("Captured local operand out of range");
+        tree.locals.set(instruction, instruction.index);
+      }
+    }
+  }
+  return tree;
+}
+function checkChild(child: Child, localCount: number): Tree {
+  const actual = inspect(child.body, localCount);
+  const saved = child.tree!;
+  if (actual.arrays.size !== saved.arrays.size || actual.instructions.size !== saved.instructions.size)
+    throw new Error("Retained child structure changed");
+  for (const [array, entries] of saved.arrays) if (!sameItems(array, entries))
+    throw new Error("Retained child sequence changed");
+  for (const [instruction, op] of saved.ops) if (instruction.op !== op)
+    throw new Error("Retained child opcode changed");
+  for (const [instruction, children] of saved.children) if (!sameItems(actual.children.get(instruction) ?? [], children))
+    throw new Error("Retained child nesting changed");
+  for (const [instruction, index] of saved.locals) if (actual.locals.get(instruction) !== index)
+    throw new Error("Retained child local operand changed");
+  return actual;
+}
+
+export function beginCapturedFrame(
+  ctx: CodegenContext, fctx: FunctionContext, method: "all" | "race", sourceLocal: number,
+): CapturedFrameConstruction {
+  if (method !== "all" && method !== "race") throw new Error("Invalid captured method");
+  if (ctx.currentFunc !== fctx && !ctx.funcStack.includes(fctx))
+    throw new Error("Captured frame is not active in its context");
+  if (activeFrames.has(fctx)) throw new Error("Captured frame already active");
+  const declaration = [...fctx.params, ...fctx.locals][sourceLocal];
+  if (!Number.isInteger(sourceLocal) || sourceLocal < 0 || declaration?.type.kind !== "externref")
+    throw new Error("Captured source must be an existing externref local");
+  const owner = handle("captured-frame");
+  const f: Frame = {
+    owner, ctx, fctx, method, destination: fctx.body, prefix: [...fctx.body], params: fctx.params, paramCount: fctx.params.length,
+    locals: fctx.locals, declarations: [], source: Object.freeze({ ...handle("captured-local"), type: copyType(declaration.type) }),
+    roots: new Map(), children: [], stack: [], state: "preparing",
+  };
+  captureDeclarations(f);
+  f.source = f.declarations[sourceLocal]!.binding;
+  retain(f, f.destination);
+  frames.set(owner, f);
+  activeFrames.set(fctx, f);
+  return owner;
+}
+export function capturedSourceBinding(owner: CapturedFrameConstruction): FrameLocalBinding {
+  const f = liveFrame(owner);
+  checkFrame(f, f.state === "preparing");
+  return f.source;
+}
+export function allocateCapturedLocal(owner: CapturedFrameConstruction, name: string, type: ValType): FrameLocalBinding {
+  const f = liveFrame(owner, true);
+  checkFrame(f, true);
+  captureDeclarations(f);
+  const index = allocLocal(f.fctx, name, type);
+  captureDeclarations(f);
+  return f.declarations[index]!.binding;
+}
+export function beginRetainedChild(owner: CapturedFrameConstruction, result: readonly ValType[]): AuthenticatedChildConstruction {
+  const f = liveFrame(owner, true);
+  checkFrame(f, true);
+  captureDeclarations(f);
+  const child: Child = { frame: f, parent: f.stack[f.stack.length - 1],
+    body: [], result: Object.freeze(result.map(copyType)), state: "new" };
