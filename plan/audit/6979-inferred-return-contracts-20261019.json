    "cases": 9,
    "runnerSource": "import {createHash} from 'node:crypto';\nimport {sourceInput} from '../tests/helpers/typed-program-fixtures.ts';\nimport {prepareWholeIrProgram} from '../src/ir/program-preparation.ts';\nimport {acceptPreparedIrProgram,emitAcceptedIrProgram} from '../src/ir/program-consumer.ts';\nimport {emitBinary} from '../src/emit/binary.ts';\nimport {forEachInstrDeep} from '../src/ir/core/nodes.ts';\nimport {deriveNativeObjectAccessRequirements} from '../src/ir/program/native-object-access-requirements.ts';\nimport {deriveNativeObjectConstructionRequirements} from '../src/ir/program/native-object-construction-requirements.ts';\nconst cases={\n  method:'export function make(){return {method():number{return 1;}};}',\n  deep:'export function make(n:number){return {z:{inner:{deep:{value:n}}},a:false};}',\n  boolean:'export function make(n:number){return {z:n,a:true};}',\n  any:'export function make(value:any){return value;}',\n  empty:'export function make(){return {};}',\n  undefined:'export function make(){return undefined;}',\n  castUndefined:'export function make(){return ({method():number{return 1;}} as unknown as undefined);}',\n  scalar:'function add(n:number){return n+1;} export function run(n:number){return add(n);}',\n};\nfor(const [name,source]of Object.entries(cases))for(const policy of name==='scalar'?[{backend:'wasmgc',target:'standalone'},{backend:'linear',target:'wasi'}]as const:[{backend:'wasmgc',target:'standalone'}]as const){\n  const result=prepareWholeIrProgram({...sourceInput({'./entry.ts':source}),policy,runtimePolicies:[policy],objectReferenceProjection:'live'});\n  if(result.kind!=='prepared'){console.log(JSON.stringify({name,sourceSha256:createHash('sha256').update(source).digest('hex'),policy,...result}));continue;}\n  const program=result.program,kinds:string[]=[];\n  for(const fn of program.ir.functions)for(const block of fn.blocks)for(const instr of block.instrs)forEachInstrDeep(instr,row=>kinds.push(row.kind));\n  const demands=policy.backend==='wasmgc'?deriveNativeObjectConstructionRequirements(deriveNativeObjectAccessRequirements(program,program.runtime[0]!)):undefined;\n  let accepted:ReturnType<typeof acceptPreparedIrProgram>|undefined,acceptanceError:unknown;\n  try{accepted=acceptPreparedIrProgram(program,policy);}catch(error){acceptanceError={name:(error as Error).name,message:(error as Error).message};}\n  let binary:unknown;\n  if(accepted?.kind==='accepted'){\n    const bytes=emitBinary(emitAcceptedIrProgram(accepted).module),module=new WebAssembly.Module(bytes),ex=new WebAssembly.Instance(module).exports as any;\n    const token={n:42};\n    const outputs=name==='scalar'?[ex.run(41),ex.run(6)]:name==='any'?[ex.make(token)===token,String(ex.make(token))]:[typeof ex.make(41)];\n    binary={bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex'),imports:WebAssembly.Module.imports(module),outputs};\n  }\n  console.log(JSON.stringify({name,sourceSha256:createHash('sha256').update(source).digest('hex'),policy,kind:result.kind,functions:program.ir.functions.map(fn=>({name:fn.name,resultTypes:fn.resultTypes})),objectNew:kinds.filter(k=>k==='object.new').length,constructors:demands?.constructors.length,gaps:demands?.gaps,logicalShapes:program.objectReferences?.shapes.length,acceptance:accepted?.kind??'threw',acceptanceError,binary}));\n}\n",
    "parent": [
      {
        "name": "method",
