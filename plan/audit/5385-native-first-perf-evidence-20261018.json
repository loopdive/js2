        "node --experimental-wasm-exnref --import tsx scripts/generate-npm-compat-report.mjs --only <acorn|cookie|redux|hono> --no-write --perf-only --lane js-host-native --partial-output .tmp/issue-7087/<package>-native-first-post-fix.json"
