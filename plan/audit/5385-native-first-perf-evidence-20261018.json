  "postFix": {
    "issue": 7087,
    "implementationCommit": "5b36f318c5e9a5b1a9e11da6b924d64f5be8d1b2",
    "measuredAt": "2026-10-18",
    "rootCause": "The native __str_repeat kernel doubled its rope beyond the requested length and then substring-flattened/copies the complete 5,000-code-unit result. The host provider retained an engine rope and answered length without that copy. Neither profile constant-folded bench_string to 5000.",
    "fix": "Build the shared native repeat result as an exact-length rope by binary decomposition, preserving the existing normalized-count provider ABI, throwing adapter, counted-loop provenance and JS boundary adapter.",
    "methodology": {
      "environment": {
        "platform": "darwin-arm64",
        "nodeVersion": "v24.4.1",
        "v8Version": "13.6.233.10-node.17"
      },
      "execution": "Host and native-first kernel profiles, then each native-first npm control, were measured sequentially to avoid CPU contention.",
      "optimizationLevel": 4,
      "kernelWarmupRounds": 2,
      "kernelMeasuredRounds": 9,
      "commands": [
