#!/bin/sh
# Pre-push hook:
#
#   1. (safety) Refuse to push anything under `labs/` to the public remote.
#      The `labs/` top-level directory holds private content that must
#      only ship to `loopdive/js2wasm-labs` (the `labs` remote).
#
#   2. (fast local gates) typecheck, lint, prettier on the changed files, the
#      change-scoped ratchets and issue integrity — the checks CI's `quality`
#      lane would otherwise reject a full cycle later.
#
# This hook never commits. It used to auto-commit a benchmark refresh when a
# `v*` tag was pushed and a conformance-number sync, both with the hook-bypass
# flag (#6799) — and a commit made inside pre-push is not even part of the push
# that triggered it. The benchmark refresh now lives in scripts/release.mjs
# (the only sanctioned tag path); a conformance drift now blocks the push with
# the fix-up command instead.
#
# Bypassing the hooks is forbidden by project-lead order (CLAUDE.md,
# 2026-08-22). A slow or failing gate gets fixed, not skipped.
#
# ---------------------------------------------------------------------------
# FALSE-NEGATIVE PUSHES: a non-zero exit does NOT mean the push failed.
# ---------------------------------------------------------------------------
# If you wrap a push in a watchdog — `timeout 120 git push fork <branch>` —
# the timeout can kill the CLIENT *after* the remote has already accepted and
# updated the ref. You then see exit 124 (or a SIGTERM) and conclude the push
# did not land, when it did. Re-pushing, re-branching, or "recovering" from
# that false negative is how branches get duplicated.
#
# Observed on this repo 2026-07-31: exit 124 on a push whose ref had already
# updated on the remote.
#
# RULE: confirm a push by reading the REMOTE's state, never by the exit code.
#
#     git ls-remote fork refs/heads/<branch>
#
# and compare the printed sha to `git rev-parse HEAD`. Equal ⇒ the push
# landed, whatever the exit code said. This is the same
# read-the-record-not-the-report discipline the issue-id tooling uses.
#
# The corollary also holds: exit 0 from a pipeline (`git push … | tail`)
# reports the LAST command's status, not the push's. Don't pipe a command
# whose exit status you need.

remote="$1"
remote_url=$(git remote get-url "$remote" 2>/dev/null || echo "")

# Capture the ref-update lines once (git streams them on stdin) so the labs
# guard below reads them from a variable rather than draining stdin.
push_refs=$(cat)

# ---------- (1) labs/ safety check ---------------------------------------
#
# Classify the destination by URL (not remote name — anyone can rename a
# remote locally) via the shared, unit-tested helper. Only the allowlisted
# private mirror (loopdive/js2wasm-labs) may receive labs/ paths; the canonical
# upstream, the legacy loopdive/js2wasm alias, public forks, and any
# unrecognized destination are all scanned and blocked. Classification and the
# scan live in scripts/hooks/push-remote-classify.sh so they can be unit-tested
# (tests/hooks/pre-push-labs-remote.test.ts) — see #3410.

hook_lib="$(git rev-parse --show-toplevel 2>/dev/null || echo .)/scripts/hooks/push-remote-classify.sh"
if [ -r "$hook_lib" ]; then
  . "$hook_lib"
  if ! printf '%s\n' "$push_refs" | run_labs_guard "$remote" "$remote_url"; then
    exit 1
  fi
else
  echo "Pre-push: ERROR — cannot read $hook_lib; refusing to push without the labs/ guard." >&2
  echo "          Restore the file (git checkout -- scripts/hooks/push-remote-classify.sh)." >&2
  exit 1
fi

# ---------- (2) version-tag benchmark refresh: MOVED ---------------------
#
# (#6799) Refreshing benchmarks on a `v*` tag push now happens in
# `node scripts/release.mjs`, as a reviewed commit on the release branch. The
# hook used to do it here and commit the result with the hook-bypass flag —
# after the tag, so the data never travelled with the tag it described.

# ---------- (3) typecheck + lint -----------------------------------------
#
# Run locally before push so failures don't waste a CI cycle. CI's cheap
# gate is the safety net for contributors without the hook installed.
#
# Run in parallel to minimize push latency (typecheck ~5-10s, lint ~1-2s).

echo "Pre-push: typecheck + lint (parallel) ..."
tmp_tc=$(mktemp); tmp_lint=$(mktemp)
( pnpm run typecheck > "$tmp_tc" 2>&1 ) &
pid_tc=$!
( if grep -q '"lint"' package.json 2>/dev/null; then pnpm run lint > "$tmp_lint" 2>&1; fi ) &
pid_lint=$!
wait $pid_tc; tc_rc=$?
wait $pid_lint; lint_rc=$?

if [ "$tc_rc" -ne 0 ]; then
  echo "Pre-push: typecheck FAILED (rc=$tc_rc). Output:"
  tail -50 "$tmp_tc"
  echo ""
  echo "Fix typecheck errors before pushing."
  rm -f "$tmp_tc" "$tmp_lint"
  exit 1
fi
if [ "$lint_rc" -ne 0 ]; then
  echo "Pre-push: lint FAILED (rc=$lint_rc). Output:"
  tail -50 "$tmp_lint"
  echo ""
  echo "Fix lint errors before pushing."
  rm -f "$tmp_tc" "$tmp_lint"
  exit 1
fi
rm -f "$tmp_tc" "$tmp_lint"
echo "Pre-push: typecheck + lint OK."

# ---------- (3b) prettier format check (changed files) -------------------
#
# Catch formatting drift locally with the SAME prettier and config CI's
# `quality` `format:check` uses (worktrees get node_modules symlinked by
# provision-worktree.sh, so the PINNED prettier runs here).
#
# (#6799) Only the src/tests/scripts *.ts files this branch changes since its
# merge-base with upstream main are checked, with NO watchdog. The old
# whole-tree run sat under a 90 s watchdog and printed "TIMED OUT — skipping"
# when it expired — measured 82 s idle, 108 s with one concurrent job, so it
# skipped itself exactly when the box was busy. A changed-files check takes
# seconds, so its verdict is final; CI still checks the whole tree. The logic
# lives in a sourced, unit-tested helper (scripts/hooks/format-gate.sh,
# tests/hooks/pre-push-format-gate.test.ts).

if grep -q '"format:check"' package.json 2>/dev/null; then
  echo "Pre-push: prettier --check (changed files) ..."
  fmt_lib="$(git rev-parse --show-toplevel 2>/dev/null || echo .)/scripts/hooks/format-gate.sh"
  if [ -r "$fmt_lib" ]; then
    . "$fmt_lib"
    fmt_out=$(run_format_gate)
  else
    echo "Pre-push: WARNING — cannot read $fmt_lib; checking the whole tree." >&2
    fmt_out=$(pnpm run format:check 2>&1)
  fi
  fmt_rc=$?
  if [ "$fmt_rc" -ne 0 ]; then
    echo "Pre-push: format check FAILED. Offending files:"
    # Prefer the prettier warning / *.ts filter, but if it matches nothing (e.g.
    # a runner/setup error rather than a formatting defect) show the RAW output
    # instead of an empty section, so the real cause is visible (#3409).
    fmt_filtered=$(echo "$fmt_out" | grep -iE '\[warn\]|^\S+\.ts$' | head -30)
    if [ -n "$fmt_filtered" ]; then
      echo "$fmt_filtered"
    else
      echo "$fmt_out" | head -30
    fi
    echo ""
    echo "Fix with: npx prettier --write <file>   (or: pnpm run format)"
    echo "Then commit and re-push."
    exit 1
  else
    echo "$fmt_out" | grep '^Pre-push:'
    echo "Pre-push: format check OK."
  fi
fi

# ---------- (3c) change-scoped oracle ratchet -----------------------------
#
# CI rejects new direct TypeScript-checker queries under src/codegen. Run the
# exact change-scoped ratchet locally so an oracle-boundary regression is
# reported before the quality job. This is fast and read-only.

if grep -q '"check:oracle-ratchet"' package.json 2>/dev/null; then
  echo "Pre-push: oracle ratchet ..."
  if ! pnpm run check:oracle-ratchet; then
    echo ""
    echo "Fix direct checker growth before pushing."
    exit 1
  fi
  echo "Pre-push: oracle ratchet OK."
fi

# ---------- (3d) change-scoped coercion-site ratchet ----------------------
#
# Keep new ToNumber/ToString/equality work on the shared coercion engine. This
# is the exact fast, read-only gate used by CI.

if grep -q '"check:coercion-sites"' package.json 2>/dev/null; then
  echo "Pre-push: coercion-site ratchet ..."
  if ! pnpm run check:coercion-sites; then
    echo ""
    echo "Route new coercions through the shared engine before pushing."
    exit 1
  fi
  echo "Pre-push: coercion-site ratchet OK."
fi

# ---------- (3e) numeric-local IR parity regression -----------------------
#
# The quality job exercises #3765 because Acorn's tokenizer depends on this
# direct/IR carrier contract. Run the exact focused file locally: a late IR
# rejection otherwise appears only after the branch reaches Actions.

echo "Pre-push: numeric-local IR parity (#3765) ..."
if ! pnpm exec vitest run tests/issue-3765-numeric-locals.test.ts \
  --pool=forks --poolOptions.forks.singleFork=true --no-file-parallelism; then
  echo ""
  echo "Fix the #3765 direct/IR numeric-local regression before pushing."
  exit 1
fi
echo "Pre-push: numeric-local IR parity OK."

# ---------- (4) conformance numbers in docs: CHECK, never commit ----------
#
# README.md / ROADMAP.md / CLAUDE.md / plan/goals/goal-graph.md embed the
# figures from benchmarks/results/test262-current.json; the quality CI gate
# fails with "Conformance numbers in sync (#1522)" when they drift.
# (#6799) This section used to rewrite the docs and auto-commit them with the
# hook-bypass flag — a commit that was not even part of the push that
# triggered it. Now a real drift blocks the push with the fix-up command; a
# malformed input stays non-fatal, as before.
# Note: reads from the local test262-current.json — merge main first so
# your baseline is current before pushing.

if command -v pnpm > /dev/null 2>&1 && grep -q '"sync:conformance:check"' package.json 2>/dev/null; then
  conf_out=$(pnpm run sync:conformance:check 2>&1)
  conf_rc=$?
  if [ "$conf_rc" -ne 0 ]; then
    if echo "$conf_out" | grep -q -- '--check failed'; then
      echo "$conf_out" | tail -25
      echo ""
      echo "PRE-PUSH BLOCKED: conformance numbers in docs drift from test262-current.json."
      echo "Fix with: pnpm run sync:conformance, then commit the files it wrote and re-push."
      exit 1
    fi
    echo "Pre-push: sync:conformance:check failed (non-fatal) — CI quality gate may flag drift."
  fi
fi

# ---------- (5) issue integrity: COMMITTED-tree filename<->id match -------
#
# Catches the renumber footgun (#957 / #960, twice in one session): an issue
# file is renamed and the rename committed, but the `id:` frontmatter edit is
# left UNCOMMITTED in the working tree. The pushed commit then has
# filename-prefix != frontmatter-id and fails CI's #1616 integrity gate ~2 min
# later. The key is we check the COMMITTED tree (`git show HEAD:<file>`), NOT the
# working tree — the working tree looks fine in exactly this case, which is why
# the agents' local `check:issues` falsely passed. Also checks committed-tree
# dependencies so uncommitted sibling issue files cannot hide a dangling
# depends_on, then runs the full check:issues for dup-IDs / broken links.
# A failure here blocks the push; fix the issue file, do not bypass the hook.

if command -v node > /dev/null 2>&1 && [ -d plan/issues ]; then
  issue_block=0

  # (5a) committed-tree filename<->frontmatter-id match for changed issue files.
  range_base=$(git merge-base origin/main HEAD 2>/dev/null || echo "")
  if [ -n "$range_base" ]; then
    changed_issues=$(git diff --name-only "$range_base..HEAD" -- 'plan/issues/*.md' 2>/dev/null \
      | grep -E '^plan/issues/[0-9]+[a-z]?-.*\.md$' || true)
  else
    changed_issues=$(git diff --name-only "HEAD~5..HEAD" -- 'plan/issues/*.md' 2>/dev/null \
      | grep -E '^plan/issues/[0-9]+[a-z]?-.*\.md$' || true)
  fi
  for f in $changed_issues; do
    git cat-file -e "HEAD:$f" 2>/dev/null || continue   # skip deletes
    prefix=$(basename "$f" | grep -oE '^[0-9]+')
    id=$(git show "HEAD:$f" 2>/dev/null | grep -m1 -E '^id:[[:space:]]*[0-9]+' | grep -oE '[0-9]+' | head -1)
    if [ -n "$prefix" ] && [ -n "$id" ] && [ "$prefix" != "$id" ]; then
      echo ""
      echo "PRE-PUSH BLOCKED (#1616 integrity): $f"
      echo "  COMMITTED frontmatter id=$id != filename prefix=$prefix"
      echo "  You likely renamed the file but left the 'id:' edit UNCOMMITTED."
      echo "  Verify the COMMITTED state (not the working tree):"
      echo "    git show HEAD:$f | grep '^id:'"
      echo "  Then commit the id/title edits and re-push."
      issue_block=1
    fi
  done

  # (5b) committed-tree graph integrity. This catches the PR-quality failure
  # where an uncommitted sibling issue file makes the working tree look valid,
  # but the pushed commit has a dangling depends_on.
  #
  # This scans the WHOLE issue tree on purpose — duplicate-id and dangling
  # depends_on detection both need a complete index, so scoping it to the files
  # the push touches would silently weaken it. It stays affordable because the
  # checker reads every blob in a single `git cat-file --batch` (#3964); it
  # previously spawned one `git show` per file (~3,500 serial subprocesses) and
  # took minutes-to-tens-of-minutes on every push.
  if [ -f scripts/check-committed-issue-integrity.mjs ]; then
    if ! node scripts/check-committed-issue-integrity.mjs HEAD > /tmp/.prepush_issues_committed 2>&1; then
      echo ""
      echo "PRE-PUSH BLOCKED: committed issue integrity gate (#1616) failed:"
      tail -30 /tmp/.prepush_issues_committed
      issue_block=1
    fi
    rm -f /tmp/.prepush_issues_committed
  fi

  # (5c) full integrity gate (duplicate IDs, broken path links) — working tree.
  if grep -q '"check:issues"' package.json 2>/dev/null; then
    if ! node scripts/update-issues.mjs --check > /tmp/.prepush_issues 2>&1; then
      echo ""
      echo "PRE-PUSH BLOCKED: issue integrity gate (#1616) failed:"
      tail -15 /tmp/.prepush_issues
      issue_block=1
    fi
    rm -f /tmp/.prepush_issues
  fi

  if [ "$issue_block" -ne 0 ]; then
    echo ""
    echo "Fix the issue-integrity problem(s) above, commit, and re-push."
    exit 1
  fi
  echo "Pre-push: issue integrity OK."
fi
