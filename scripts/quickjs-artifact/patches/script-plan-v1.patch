+static int js_capture_global_script_plan(JSContext *ctx,
+    JSGlobalScriptPlan *plan, JSFunctionDef *fd)
+{
+    int i;
+    assert(fd->parent == NULL && fd->eval_type == JS_EVAL_TYPE_GLOBAL);
+    plan->strict = fd->is_strict_mode;
+    plan->filename = JS_DupAtom(ctx, fd->filename);
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+    if (plan->filename != JS_ATOM_NULL)
+        script_plan_test_live_atoms++;
+#endif
+    if (fd->global_var_count) {
+        if (SCRIPT_PLAN_FAIL(2)) {
+            JS_ThrowOutOfMemory(ctx);
+            return -1;
+        }
+        plan->records = js_mallocz(ctx,
+            sizeof(*plan->records) * (size_t)fd->global_var_count);
+        if (!plan->records)
+            return -1;
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+        script_plan_test_live_arrays++;
+#endif
+    }
+    for (i = 0; i < fd->global_var_count; i++) {
+        const JSGlobalVar *source = &fd->global_vars[i];
+        JSGlobalScriptPlanRecord *record = &plan->records[i];
+        record->name = JS_DupAtom(ctx, source->var_name);
+        record->function_pool_index = source->cpool_idx;
+        record->kind = source->is_lexical ? (source->is_const ? 3 : 2)
+            : (source->cpool_idx >= 0 ? 1 : 0);
+        record->origin = source->script_plan_annex_b ? 1 : 0;
+        plan->count++;
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+        script_plan_test_live_atoms++;
+#endif
+    }
+    return 0;
+}
