+/* Ordinary evaluation keeps its original entry and passes no capture request. */
+static JSValue __JS_EvalInternal(JSContext *ctx, JSValueConst this_obj,
+    const char *input, size_t input_len, const char *filename, int line,
+    int flags, int scope_idx)
+{
+    return js_eval_internal_with_script_plan(ctx, this_obj, input, input_len,
+        filename, line, flags, scope_idx, NULL);
+}
