+void JS_FreeGlobalScriptPlan(JSContext *ctx, JSGlobalScriptPlan *plan)
+{
+    int i;
+    if (!plan)
+        return;
+    assert(plan->ctx == ctx);
+    for (i = 0; i < plan->count; i++) {
+        JS_FreeAtom(ctx, plan->records[i].name);
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+        script_plan_test_live_atoms--;
+#endif
+    }
+    JS_FreeAtom(ctx, plan->filename);
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+    if (plan->filename != JS_ATOM_NULL)
+        script_plan_test_live_atoms--;
+#endif
+    JS_FreeValue(ctx, plan->compiled);
+    js_free(ctx, plan->records);
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+    if (plan->records)
+        script_plan_test_live_arrays--;
+    if (!JS_IsUndefined(plan->compiled))
+        script_plan_test_live_compiled--;
+#endif
+    js_free(ctx, plan);
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+    script_plan_test_live_plans--;
+#endif
+}
