+JSGlobalScriptPlan *JS_CompileGlobalScriptPlan(JSContext *ctx,
+    const char *input, size_t input_len, const char *filename)
+{
+    JSGlobalScriptPlan *plan;
+    JSValue compiled;
+    if (unlikely(!ctx->eval_internal)) {
+        JS_ThrowTypeError(ctx, "eval is not supported");
+        return NULL;
+    }
+    if (SCRIPT_PLAN_FAIL(1)) {
+        JS_ThrowOutOfMemory(ctx);
+        return NULL;
+    }
+    plan = js_mallocz(ctx, sizeof(*plan));
+    if (!plan)
+        return NULL;
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+    script_plan_test_live_plans++;
+#endif
+    plan->ctx = ctx;
+    plan->rt = ctx->rt;
+    plan->source_length = input_len;
+    plan->compiled = JS_UNDEFINED;
+    compiled = js_eval_internal_with_script_plan(ctx, ctx->global_obj,
+        input, input_len, filename, 1,
+        JS_EVAL_TYPE_GLOBAL | JS_EVAL_FLAG_COMPILE_ONLY, -1, plan);
+    if (JS_IsException(compiled)) {
+        JS_FreeGlobalScriptPlan(ctx, plan);
+        return NULL;
+    }
+    plan->compiled = compiled;
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+    script_plan_test_live_compiled++;
+#endif
+    return plan;
 }
 
+int JS_GlobalScriptPlanCount(const JSGlobalScriptPlan *plan) { return plan->count; }
+int JS_GlobalScriptPlanStrict(const JSGlobalScriptPlan *plan) { return plan->strict; }
+int JS_GlobalScriptPlanKind(const JSGlobalScriptPlan *plan, int index)
+{
+    return index >= 0 && index < plan->count ? plan->records[index].kind : -1;
+}
+int JS_GlobalScriptPlanOrigin(const JSGlobalScriptPlan *plan, int index)
+{
+    return index >= 0 && index < plan->count ? plan->records[index].origin : -1;
+}
+JSValue JS_GlobalScriptPlanName(JSContext *ctx, const JSGlobalScriptPlan *plan, int index)
+{
+    if (plan->ctx != ctx)
+        return JS_ThrowTypeError(ctx, "foreign Script plan");
+    if (index < 0 || index >= plan->count)
+        return JS_ThrowRangeError(ctx, "Script plan index out of range");
+    return JS_AtomToString(ctx, plan->records[index].name);
+}
+JSValue JS_EvalGlobalScriptPlan(JSContext *ctx, JSGlobalScriptPlan *plan)
+{
+    JSValue compiled;
+    if (plan->ctx != ctx || plan->consumed)
+        return JS_ThrowTypeError(ctx, "foreign or consumed Script plan");
+    compiled = plan->compiled;
+    plan->compiled = JS_UNDEFINED;
+    plan->consumed = true;
+#ifdef JS2WASM_SCRIPT_PLAN_TEST
+    script_plan_test_live_compiled--;
+#endif
+    return JS_EvalFunction(ctx, compiled);
+}
