{
  "_comment": "#2910 — landing-page feature row -> canonical test262 `features:` tag(s). Each landing feature (matched by its feature-examples.json `name`) maps to the test262 feature tags that define its row population. The row count is the UNION of tests carrying any of these tags WITHIN the feature's own edition section (see scripts/generate-editions.ts computeFeatureRowCounts), so every row is a strict subset of its edition's headline population and reconciles with it (section 100% => every row 100%). An empty array [] marks an intentional headline-only row (a feature whose tests predate `features:` or whose axis is a syntax/flag with no tag, e.g. Modules use the `module` flag). Editions <=ES3 and ES5 predate `features:` entirely and are headline-only by omission (0/274 and 28/13084 tests carry a tag). Tags that do not appear in the current baseline contribute 0 and are harmless. Keep names in exact sync with the FEATURES catalog in scripts/generate-feature-examples.ts.",
  "Arrow functions": ["arrow-function"],
  "Template literals": ["template", "template-literal-revision"],
  "Destructuring": ["destructuring-binding", "destructuring-assignment"],
  "Spread / rest operators": ["spread", "rest-parameters"],
  "Default parameters": ["default-parameters"],
  "Computed property names": ["computed-property-names"],
  "for-of": ["for-of"],
  "Generators (function*, yield)": ["generators", "generator"],
  "Classes": ["class", "super", "new.target"],
  "Map / Set": ["Map", "Set", "WeakMap", "WeakSet"],
  "Symbol": [
    "Symbol",
    "Symbol.iterator",
    "Symbol.toPrimitive",
    "Symbol.toStringTag",
    "Symbol.species",
    "Symbol.hasInstance",
    "Symbol.match",
    "Symbol.replace",
    "Symbol.search",
    "Symbol.split",
    "Symbol.isConcatSpreadable",
    "Symbol.unscopables"
  ],
  "TypedArray / ArrayBuffer": [
    "TypedArray",
    "ArrayBuffer",
    "DataView",
    "Int8Array",
    "Uint8Array",
    "Uint8ClampedArray",
    "Int16Array",
    "Uint16Array",
