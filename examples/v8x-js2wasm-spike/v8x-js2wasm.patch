+#[unsafe(no_mangle)]
+pub extern "C" fn v8__ScriptCompiler__Source__CONSTRUCT(
+  source: *mut MaybeUninit<Source>,
+  source_string: *const V8String,
+  origin: *const ScriptOrigin,
