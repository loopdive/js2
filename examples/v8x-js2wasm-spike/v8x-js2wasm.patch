+pub extern "C" fn v8__Object__Get(
+  object: *const Object,
+  _context: *const Context,
+  key: *const Value,
+) -> *const Value {
+  properties(object)
+    .and_then(|properties| {
+      properties
+        .iter()
+        .rev()
+        .find(|property| same_property_key(property.key.cast(), key.cast()))
+    })
+    .map(|property| property.value.cast())
+    .unwrap_or_else(|| v8__Undefined(current_isolate()).cast())
