+    return MaybeBool::Nothing;
+  };
+  if let Some(property) = properties
+    .iter_mut()
+    .rev()
+    .find(|property| same_property_key(property.key.cast(), key.cast()))
+  {
+    property.value = value.cast();
+  } else {
